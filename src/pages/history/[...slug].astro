---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { historyOf } from '../../lib/revisions.mjs';

export async function getStaticPaths() {
  const all = await getCollection('articles');
  const portals = await getCollection('portals');
  return [
    ...all.filter((e) => e.id !== 'home').map((e) => ({ params: { slug: e.id }, props: { entry: e, kind: 'article' } })),
    ...portals.map((e) => ({ params: { slug: `portal/${e.id}` }, props: { entry: e, kind: 'portal' } })),
  ];
}

const { entry, kind } = Astro.props;
// A moved page's history goes on back through the files it had before.
const own = historyOf(entry.id, kind);
const revs = own && [...own, ...(entry.data.movedFrom || []).flatMap((id) => historyOf(id, kind) || [])]
  .sort((a, b) => Date.parse(b.date) - Date.parse(a.date));
/** "21:29, 19 September 2026", the way a history page states a revision. */
const when = (iso) => {
  const d = new Date(iso);
  return d.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' })
    + ', ' + d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
};
// Commits the editor wrote before it asked for a summary all read the same, and
// repeating that line down the page tells the reader nothing.
const BOILERPLATE = /: edit from the wiki editor$/;
const said = (s) => (BOILERPLATE.test(s) ? '' : s.replace(/^[a-z0-9-]+:\s*/, ''));
/** A diff as lines already labelled, so the template holds no logic. */
const lines = (patch) => patch.split('\n').map((text) => ({
  text,
  cls: text.startsWith('+') ? 'add' : text.startsWith('-') ? 'del' : text.startsWith('@@') ? 'at' : '',
}));
/** The net change in lines, which is what tells a reader how big an edit was. */
const net = (r) => {
  const n = r.added - r.removed;
  return { text: (n > 0 ? '+' : n < 0 ? '\u2212' : '\u00b1') + Math.abs(n),
           cls: n > 0 ? 'plus' : n < 0 ? 'minus' : 'same' };
};
---

<Base title={entry.data.title} slug={kind === 'portal' ? `portal:${entry.id}` : entry.id} view="history">
  <div class="article">
    {revs === null ? (
      <p>The history is read from the repository, which is not available here. A full
        clone is needed; a shallow one has nothing to show.</p>
    ) : (
      <ol class="revs">
        {revs.map((r) => (
          <li>
            <div class="rev-line">
              <span class="rev-when">{when(r.date)}</span>
              <span class="rev-who">{r.author}</span>
              <span class={'rev-net ' + net(r).cls}>{net(r).text}</span>
              <span class="rev-plusminus">{'+' + r.added + ' \u2212' + r.removed}</span>
              {said(r.summary)
                ? <span class="rev-said">{said(r.summary)}</span>
                : <span class="rev-said none">no summary</span>}
            </div>
            <details>
              <summary>Show changes</summary>
              <pre class="diff">{lines(r.patch).map((l) => <span class={l.cls}>{l.text + '\n'}</span>)}</pre>
            </details>
          </li>
        ))}
      </ol>
    )}
  </div>
</Base>

<style>
  .revs { list-style: none; margin: 2px 0 8px; padding: 0; }
  .revs > li { border-bottom: 1px solid var(--hair); padding: 9px 4px; }
  .revs > li:hover { background: color-mix(in srgb, var(--band) 55%, transparent); }
  /* One line per revision, as a history page reads it: when, who, how much, and what
     they said they were doing. */
  .rev-line { display: flex; align-items: baseline; flex-wrap: wrap; gap: 3px 10px; }
  .rev-when { font-size: 13px; color: var(--muted); white-space: nowrap; }
  .rev-who { font-weight: 700; }
  .rev-net { font-weight: 700; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .rev-net.plus { color: #6fbf73; }
  .rev-net.minus { color: #e07a6a; }
  .rev-net.same { color: var(--muted); }
  .rev-plusminus { font-size: 12px; color: var(--muted); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .rev-said { flex: 1 1 260px; }
  .rev-said.none { color: var(--muted); font-style: italic; }
  details > summary {
    cursor: pointer; font-size: 12px; color: var(--link);
    margin-top: 6px; width: max-content;
  }
  .diff {
    margin: 8px 0 2px; padding: 10px 12px; overflow-x: auto;
    background: var(--paper); border: 1px solid var(--hair); border-radius: 3px;
    font: 12px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace; white-space: pre;
  }
  .diff .add { color: #6fbf73; }
  .diff .del { color: #e07a6a; }
  .diff .at { color: var(--muted); }
</style>
