          /** A selection that runs across items taken out: the first item keeps what came
              before it, the rest of the last joins it, and the items between go. */
          const cutAcross = () => {
            const s = getSelection();
            if (!s.rangeCount || s.isCollapsed) return false;
            const lis = touched();
            if (lis.length < 2) return false;
            const r = s.getRangeAt(0);
            const a = lis[0], z = lis[lis.length - 1];
            const inBox = (li, node, off, end) => (boxOf(li).contains(node) ? [node, off]
              : [boxOf(li), end ? boxOf(li).childNodes.length : 0]);
            const [sn, so] = inBox(a, r.startContainer, r.startOffset, false);
            const [en, eo] = inBox(z, r.endContainer, r.endOffset, true);
            const tail = document.createRange();
            tail.selectNodeContents(boxOf(z));
            tail.setStart(en, eo);
            const rest = tail.extractContents();
            const head = document.createRange();
            head.selectNodeContents(boxOf(a));
            head.setStart(sn, so);
            head.deleteContents();
            lis.slice(1).forEach((li) => li.remove());
            const at = document.createRange();
            at.selectNodeContents(boxOf(a));
            at.collapse(false);
            if (hasContent(rest)) boxOf(a).append(rest);
            putRange(at);
            tidy();
            return true;
          };
          /** Nothing but items, each with one box, whatever the browser did. */
          const shape = () => {
            let changed = false;
            for (const n of [...ul.childNodes]) {
              if (n.nodeType === 1 && n.tagName === 'LI') {
                let box = boxOf(n);
                if (!box) {
                  box = el('div', 'ce');
                  box.dataset.ph = 'List item';
                  while (n.firstChild) box.append(n.firstChild);
                  n.append(box);
                  changed = true;
                }
                for (const k of [...n.childNodes]) if (k !== box) { box.append(k); changed = true; }
                continue;
              }
              if (n.nodeType === 3 && !n.nodeValue.trim()) { n.remove(); continue; }
              const prev = n.previousSibling?.tagName === 'LI' ? n.previousSibling : null;
              const li = prev || item('');
              if (!prev) ul.insertBefore(li, n);
              boxOf(li).append(n);
              changed = true;
            }
            if (!ul.children.length) { ul.append(item('')); changed = true; }
            if (changed) tidy();
          };

          ul.addEventListener('keydown', (e) => {
            if (e.isComposing) return;
            const li = here();
            if (!li) return;
            const box = boxOf(li);
            if (e.key === 'Tab' && !e.ctrlKey && !e.metaKey && !e.altKey) {
              e.preventDefault();
              const lis = touched().length ? touched() : [li];
              for (const x of lis) x.dataset.level = Math.max(0, levelOf(x) + (e.shiftKey ? -1 : 1));
              tidy();
              sync();
              return;
            }
            if (e.ctrlKey || e.metaKey || e.altKey) return;
            if (e.key === 'Enter') {
              e.preventDefault();
              const s = getSelection();
              if (!cutAcross() && !s.isCollapsed) document.execCommand('delete');
              if (e.shiftKey) { lineBreak(); return; }
