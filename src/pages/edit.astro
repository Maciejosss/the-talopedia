    }

    /** A cell is a string, or an object once it carries a span or is a header. */
    const cellText = (c) => (typeof c === 'string' ? c : c?.text ?? '');
    const cellSpan = (c, k) => (typeof c === 'string' ? 1 : Math.max(1, c?.[k] ?? 1));
    const cellHead = (c, r) => (typeof c === 'string' ? r === 0 : !!c?.head);

    /**
     * Where every cell sits once spans are accounted for. grid[r][c] is the element
     * covering that square, so a cell with rowspan 4 appears at four rows.
     */
    function tableGrid(tbody) {
      const grid = [];
      [...tbody.rows].forEach((tr, r) => {
        grid[r] ??= [];
        let c = 0;
        for (const td of [...tr.children]) {
          while (grid[r][c]) c++;
          for (let i = 0; i < (td.rowSpan || 1); i++) {
            grid[r + i] ??= [];
            for (let j = 0; j < (td.colSpan || 1); j++) grid[r + i][c + j] = td;
          }
          c += td.colSpan || 1;
        }
      });
      return grid;
    }

/**
 * A cell's text, wherever in the cell it ended up. Each cell holds an editable box,
 * but the caret can land in the cell itself, and anything typed there sat outside the
 * box where the serializer never looked: the rows showed on screen and saved blank.
 */
    function cellMd(c) {
      let out = '';
      for (const n of c.childNodes) {
        if (n.nodeType === 3) { out += n.nodeValue; continue; }
        if (n.nodeType !== 1) continue;
        out += n.classList.contains('ce') ? htmlToMd(n, '<br>') : htmlToMd({ childNodes: [n] }, '<br>');
      }
