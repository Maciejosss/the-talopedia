        }
      } else if (kind === 'image') {
        b.append(figure(data));
      } else if (kind === 'grid') {
        const wrap = el('div', 'imgrid');
        const addOne = (d = {}) => {
          const f = figure(d, true);
          wrap.append(f);
          return f;
        };
        (data.items?.length ? data.items : [{}, {}]).forEach(addOne);
        const add = el('button', 'sub-add', '+ Image');
        add.type = 'button';
        add.onclick = (e) => {
          e.stopPropagation();          // or the document handler shuts the menu again
          const fresh = addOne();
          sync();
          openFor(fresh.querySelector('input.path'));
        };
        b.append(wrap, add);
      } else if (kind === 'float') {
        const f = figure(data, false);
        f.classList.add('float-edit', data.align === 'left' ? 'float-left' : 'float-right');
        f.style.width = `${data.width || 300}px`;
        const bar = el('div', 'float-bar');
        const side = el('button', null, data.align === 'left' ? '\u25e7 Left' : 'Right \u25e8');
        side.type = 'button';
        side.onclick = () => {
          const left = f.classList.toggle('float-left');
          f.classList.toggle('float-right', !left);
          side.textContent = left ? '\u25e7 Left' : 'Right \u25e8';
          sync();
        };
        const size = el('span', 'float-size');
        const showSize = () => { size.textContent = `${Math.round(parseFloat(f.style.width))}px`; };
        showSize();
        bar.append(side, size);
        bar.onmousedown = (e) => e.preventDefault();   // flipping the side keeps the caret
