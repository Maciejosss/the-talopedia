      // browser keeps an empty line open. That is a blank cell, and is saved as one.
      out = out.trim();
      return out === '<br>' ? '' : out;
    }

    /* ---------- the caret, between boxes ----------
       Each paragraph, heading and list item is an editing box of its own, and a browser
       will not carry the caret out of one box into the next. The arrow keys do it here,
       so the body reads as one document, as in Google Docs: Up and Down at a box's first
       or last line, Left and Right at its very start or end. A table steers itself and
       hands over at its edges. */
    function putRange(r) { const s = getSelection(); s.removeAllRanges(); s.addRange(r); }
