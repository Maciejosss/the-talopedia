    body.addEventListener('keydown', (e) => {
      const step = { ArrowUp: -1, ArrowDown: 1, ArrowLeft: -1, ArrowRight: 1 }[e.key];
      if (!step || e.defaultPrevented || e.shiftKey || e.altKey || e.ctrlKey || e.metaKey || e.isComposing) return;
      const box = e.target.closest?.('.ce') || (e.target.classList?.contains('ed-list') ? ceOf(getSelection().focusNode) : null);
      if (!box || box.closest('.ed-tbl') || !getSelection().rangeCount) return;
      const vertical = e.key === 'ArrowUp' || e.key === 'ArrowDown';
      const x = vertical ? caretLeft(box) : null;
      if (vertical) {
        e.preventDefault();
        if (lineWithin(box, step < 0)) return;
      } else {
        if (!getSelection().isCollapsed) return;
        const edge = caretEdges(box);
        if (step < 0 ? !edge.atStart : !edge.atEnd) return;
        e.preventDefault();
      }
      const stops = [...body.querySelectorAll('.ce')];
      const next = stops[stops.indexOf(box) + step];
      if (next) landIn(next, step < 0, x);
    });

    /* ---------- whole blocks selected ----------
       A selection cannot run from one box into the next, so one that tries to takes
       whole blocks instead: dragging out of a block into another, Shift with an arrow
       at a block's edge, Shift-clicking another block, or ⌘A a second time. Chosen
       blocks copy, cut and paste as themselves, and Delete or typing replaces them. */
    let pick = null;                         // { a, b }: where it began, where it reaches
    const bodyBlocks = () => [...body.children].filter((b) => b.classList.contains('blk'));
    function chosen() {
      if (!pick) return [];
      const all = bodyBlocks();
      let i = all.indexOf(pick.a), j = all.indexOf(pick.b);
      if (i < 0 || j < 0) return [];
      if (i > j) [i, j] = [j, i];
      return all.slice(i, j + 1);
    }
    function paintChoice() {
      const on = new Set(chosen());
      for (const b of bodyBlocks()) b.classList.toggle('chosen', on.has(b));
    }
    function choose(a, b) {
      pick = { a, b };
      getSelection().removeAllRanges();
      body.tabIndex = -1;
      body.focus({ preventScroll: true });
      paintChoice();
    }
    function unchoose() {
      pick = null;
      body.querySelectorAll('.blk.chosen').forEach((b) => b.classList.remove('chosen'));
    }
    /** The caret into a block, at its start or its end. */
    function enterBlock(b, end) {
      const boxes = b ? boxesIn(b) : [];
      if (boxes.length) landIn(end ? boxes[boxes.length - 1] : boxes[0], end);
    }
    /** The chosen blocks out, and these in their place. */
    function replaceChosen(made = []) {
      const list = chosen();
      if (!list.length) return;
      const after = list[list.length - 1].nextElementSibling, before = list[0].previousElementSibling;
      // A page is never left with nothing in it to type into.
      if (!made.length && bodyBlocks().length === list.length) made = [block('para')];
      for (const n of made) list[0].before(n);
      list.forEach((b) => b.remove());
      unchoose();
      if (made.length) enterBlock(made[made.length - 1], true);
      else if (after?.classList.contains('blk')) enterBlock(after, false);
      else enterBlock(before, true);
      lockTokens();
      sync();
    }
    /** The chosen blocks for the clipboard: their markdown, for pasting back here, inside
        HTML and plain text that read as the same thing anywhere else. */
    function clipChosen(dt) {
      const list = chosen();
      const md = bodyMarkdown(list);
      const html = list.map((b) => {
        const k = b.dataset.kind, box = b.querySelector(':scope > .ce');
        if (k === 'para') return `<p>${box.innerHTML}</p>`;
        if (k === 'section') return `<h2>${box.innerHTML}</h2>`;
        if (k === 'subsection') return `<h3>${box.innerHTML}</h3>`;
        if (k === 'subsubsection') return `<h4>${box.innerHTML}</h4>`;
        if (k === 'list') {
          const tag = b.list.ordered() ? 'ol' : 'ul';
          return `<${tag}>${b.list.items().map((li) => `<li aria-level="${(+li.dataset.level || 0) + 1}">${b.list.boxOf(li).innerHTML}</li>`).join('')}</${tag}>`;
        }
        return '';
      }).join('');
      const text = list.map((b) => b.dataset.kind === 'list'
        ? b.list.items().map((li, i) => '  '.repeat(+li.dataset.level || 0)
          + (b.list.ordered() ? (li.dataset.n || i + 1) + '. ' : '- ') + b.list.boxOf(li).innerText.trim()).join('\n')
        : boxesIn(b).map((c) => c.innerText.trim()).filter(Boolean).join('\n')).filter(Boolean).join('\n\n');
      dt.setData('text/plain', text);
      dt.setData('text/html', `<div ${MD_MARK}="${esc(md).replace(/"/g, '&quot;')}"></div>${html}`);
    }

    document.addEventListener('copy', (e) => { if (!pick) return; e.preventDefault(); clipChosen(e.clipboardData); });
    document.addEventListener('cut', (e) => {
      if (!pick) return;
      e.preventDefault();
      clipChosen(e.clipboardData);
      replaceChosen();
    });
    document.addEventListener('paste', (e) => {
      if (!pick) return;
      e.preventDefault();
      const dt = e.clipboardData;
      const md = copiedMd(dt.getData('text/html'));
      if (md != null) { replaceChosen(parseBody(md).map((d) => block(d.kind, d))); return; }
      const listed = pastedBlocks(dt);
      if (listed) { plainPaste = false; replaceChosen(madeOf(listed)); return; }
      const lines = pastedLines(dt) || [esc(dt.getData('text/plain').trim())].filter(Boolean);
      plainPaste = false;
      replaceChosen(lines.map(paraOf));
    });

    body.addEventListener('keydown', (e) => {
      if (!pick || e.target !== body) return;
      const mod = e.metaKey || e.ctrlKey;
      const all = bodyBlocks();
      if (mod && e.key.toLowerCase() === 'a') { e.preventDefault(); pick = { a: all[0], b: all[all.length - 1] }; paintChoice(); return; }
      if (mod || e.altKey) return;                  // copy, cut, paste and undo go their own way
      if (e.key === 'ArrowUp' || e.key === 'ArrowDown') {
        e.preventDefault();
        const up = e.key === 'ArrowUp';
        if (e.shiftKey) {
          const to = all[all.indexOf(pick.b) + (up ? -1 : 1)];
          if (to) { pick.b = to; paintChoice(); to.scrollIntoView({ block: 'nearest' }); }
          return;
        }
        const list = chosen();
        unchoose();
        enterBlock(up ? list[0] : list[list.length - 1], !up);
        return;
      }
      if (e.key === 'ArrowLeft' || e.key === 'ArrowRight' || e.key === 'Escape') {
        e.preventDefault();
        const list = chosen();
        unchoose();
        const end = e.key !== 'ArrowLeft';
        enterBlock(end ? list[list.length - 1] : list[0], end);
        return;
      }
      if (e.key === 'Backspace' || e.key === 'Delete') { e.preventDefault(); replaceChosen(); return; }
      if (e.key === 'Enter' || e.key.length === 1) {
        // Typing over chosen blocks puts a paragraph in their place, starting with the key.
        e.preventDefault();
        const n = block('para');
        replaceChosen([n]);
        if (e.key.length === 1) document.execCommand('insertText', false, e.key);
      }
    });

    // Shift with an arrow at the edge of a block carries on into whole blocks.
    body.addEventListener('keydown', (e) => {
      if (pick || !e.shiftKey || e.altKey || e.metaKey || e.ctrlKey || e.isComposing) return;
      if (e.key !== 'ArrowUp' && e.key !== 'ArrowDown') return;
      const box = e.target.closest?.('.ce') || (e.target.classList?.contains('ed-list') ? e.target : null);
      if (!box || box.closest('.ed-tbl')) return;
      const b = box.closest('.blk');
      if (b?.parentElement !== body) return;
      const up = e.key === 'ArrowUp';
      const s = getSelection();
      const was = [s.anchorNode, s.anchorOffset, s.focusNode, s.focusOffset];
      s.modify('extend', up ? 'backward' : 'forward', 'line');
      e.preventDefault();
      // Inside a list the selection runs on from item to item; it takes whole blocks
      // only once it would leave the list.
      if (focusHost(box).contains(s.focusNode) && !(s.focusNode === was[2] && s.focusOffset === was[3])) return;
      s.setBaseAndExtent(...was);
      const all = bodyBlocks();
      choose(b, all[all.indexOf(b) + (up ? -1 : 1)] || b);
    });

    // ⌘A selects the box first, as it always has; a second ⌘A takes every block.
    body.addEventListener('keydown', (e) => {
      if (pick || !(e.metaKey || e.ctrlKey) || e.key.toLowerCase() !== 'a' || e.shiftKey) return;
      const box = e.target.closest?.('.ce') || (e.target.classList?.contains('ed-list') ? e.target : null);
      if (!box || box.closest('.ed-tbl') || box.closest('.blk')?.parentElement !== body) return;
      const s = getSelection();
      const norm = (t) => t.replace(/\s+/g, ' ').trim();
      const whole = !box.textContent.trim() || norm(s.toString()) === norm(box.innerText);
      if (!whole) return;
      e.preventDefault();
      const all = bodyBlocks();
      choose(all[0], all[all.length - 1]);
    });

    // The caret going back into any box, however it got there, lets the blocks go.
    document.addEventListener('focusin', (e) => { if (pick && e.target !== body && !e.target.closest?.('.ed-tools')) unchoose(); });

    // The mouse: a drag that leaves the block it began in, or a Shift-click on another.
    let dragFrom = null;
    document.addEventListener('pointerdown', (e) => {
      // In the space between two blocks, the one nearest below the pointer.
      const b = e.target === body
        ? bodyBlocks().find((x) => x.getBoundingClientRect().bottom >= e.clientY) || bodyBlocks().pop()
        : e.target.closest?.('.blk');
      const inBody = b?.parentElement === body;
      // The toolbar acts on the blocks chosen, so reaching for it keeps them.
      if (e.target.closest?.('.ed-tools')) { dragFrom = null; return; }
      if (pick) {
        if (e.shiftKey && inBody) { e.preventDefault(); pick.b = b; paintChoice(); return; }
        unchoose();
      } else if (e.shiftKey && inBody) {
        const here = activeText()?.closest?.('.blk');
        if (here?.parentElement === body && here !== b) { e.preventDefault(); choose(here, b); return; }
      }
      dragFrom = e.button === 0 && inBody && !e.target.closest('.ctl, button, input, .float-grip, .float-bar') ? b : null;
      // Begun outside any text (between blocks, or in the gutter), no text drag starts,
      // so even a drag that stays in one block takes it whole.
      fromOutside = !e.target.closest?.('[contenteditable="true"]');
    }, true);
    let fromOutside = false;
    addEventListener('pointermove', (e) => {
      if (!dragFrom || !(e.buttons & 1)) return;
      const over = document.elementFromPoint(e.clientX, e.clientY)?.closest?.('.blk');
      if (over?.parentElement !== body) return;
      if (!pick) { if (over !== dragFrom || fromOutside) choose(dragFrom, over); return; }
      if (over !== pick.b) { pick.b = over; paintChoice(); }
      getSelection().removeAllRanges();
    });
    addEventListener('pointerup', () => { dragFrom = null; });
    /** A list item's text as saved: a line break inside it kept as <br>, and the one a
        browser leaves at the end to hold an empty line open dropped. */
    const itemMd = (box) => htmlToMd(box, '<br>').replace(/(\s*<br>\s*)+$/, '').trim();

    /**
     * A table, edited the way Google Docs edits one. Tab and Shift+Tab walk the cells,
     * and Tab past the last adds a row. The arrow keys move through a cell's text and
     * on into the next cell at its edge. Dragging across cells, or Shift with a click or
     * an arrow key at a cell's edge, selects whole cells. Rows, columns, merging and the
     * header band are on the right-click menu. The whole table is one editing host, so a
     * selection can run across cells and copy as a grid; each cell's text lives in its
     * .ce box, which is what is saved.
     */
    function tableEditor(rows) {
      const wrap = el('div', 'tbl-wrap');
      const table = el('table', 'ed-tbl');
      table.contentEditable = 'true';
      table.spellcheck = false;
      table.addEventListener('input', sync);
      const tbody = el('tbody');
      table.append(tbody);

      const cell = (tag, html, colspan = 1, rowspan = 1) => {
        const c = el(tag);
        if (colspan > 1) c.colSpan = colspan;
        if (rowspan > 1) c.rowSpan = rowspan;
        const inner = el('div', 'ce');
        inner.innerHTML = html || '';
        c.append(inner);
        return c;
      };
      const boxOf = (td) => td.querySelector('.ce');

      /* ---------- the grid ---------- */
      const grid = () => tableGrid(tbody);
      const width = () => grid().reduce((w, r) => Math.max(w, r.length), 0);
      /** Where every cell sits: its first row and column and its last, in reading order. */
      const spots = (g = grid()) => {
        const m = new Map();
        g.forEach((row, r) => row.forEach((td, c) => {
          if (!td) return;
          const s = m.get(td);
          if (!s) m.set(td, { r, c, r2: r, c2: c });
          else { s.r2 = Math.max(s.r2, r); s.c2 = Math.max(s.c2, c); }
        }));
        return m;
      };
      const order = () => [...spots().keys()];
      const cellOf = (n) => {
        const e = n?.nodeType === 1 ? n : n?.parentElement;
        const td = e?.closest?.('td, th');
        return td && tbody.contains(td) ? td : null;
      };

      /* ---------- the caret ---------- */
      /**
       * The caret into a cell, at its end or its start. Given a point across, it lands as
       * near to it as it can on the cell's last line or first, which is where Up and Down
       * leave it in running text.
       */
      const enter = (td, end, x = null) => {
        const box = boxOf(td);
        if (document.activeElement !== table) table.focus({ preventScroll: true });
        td.scrollIntoView({ block: 'nearest', inline: 'nearest' });
        if (x != null) {
          const b = box.getBoundingClientRect();
          const hit = document.caretRangeFromPoint?.(
            Math.min(Math.max(x, b.left + 1), b.right - 1), end ? b.bottom - 3 : b.top + 3);
          if (hit && box.contains(hit.startContainer)) { putRange(hit); return; }
        }
        const r = document.createRange();
        r.selectNodeContents(box);
        r.collapse(!end);
        putRange(r);
      };
      /** The cell a row up or down from this one, under the given point across. */
      const verticalFrom = (td, down, x) => {
        const g = grid(), at = spots(g).get(td);
        const row = g[down ? at.r2 + 1 : at.r - 1];
        if (!row) return null;
        const cells = [...new Set(row)].filter(Boolean);
        return cells.find((c) => { const b = c.getBoundingClientRect(); return x >= b.left && x < b.right; })
          || row[Math.min(at.c, row.length - 1)];
      };
      /** Out of the table, into the block above or below; one below is made if none. */
      const leave = (down) => {
        const blk = wrap.closest('[data-kind]');
        let next = down ? blk.nextElementSibling : blk.previousElementSibling;
        if (!next && down) { next = block('para'); blk.after(next); sync(); }
        const boxes = next ? [...next.querySelectorAll('.ce')] : [];
        const box = down ? boxes[0] : boxes.at(-1);
        if (!box) return;
        box.closest('[contenteditable="true"]')?.focus({ preventScroll: true });
        const r = document.createRange();
        r.selectNodeContents(box);
        r.collapse(down);
        putRange(r);
        box.scrollIntoView({ block: 'nearest' });
      };

      /* ---------- whole cells selected ---------- */
      let span = null;               // { a, b }: the cell it began in and the one it reaches
      /** The rectangle between two cells, grown over any merged cell it would cut. */
      const rect = (a, b, sp = spots()) => {
        const p = sp.get(a), q = sp.get(b);
        let r1 = Math.min(p.r, q.r), c1 = Math.min(p.c, q.c);
        let r2 = Math.max(p.r2, q.r2), c2 = Math.max(p.c2, q.c2);
        for (let grew = true; grew;) {
          grew = false;
          for (const s of sp.values()) {
            if (s.r > r2 || s.r2 < r1 || s.c > c2 || s.c2 < c1) continue;
            if (s.r < r1) { r1 = s.r; grew = true; }
            if (s.r2 > r2) { r2 = s.r2; grew = true; }
            if (s.c < c1) { c1 = s.c; grew = true; }
            if (s.c2 > c2) { c2 = s.c2; grew = true; }
          }
        }
        return { r1, c1, r2, c2 };
      };
      const inside = (box, sp = spots()) => [...sp]
        .filter(([, s]) => s.r >= box.r1 && s.r2 <= box.r2 && s.c >= box.c1 && s.c2 <= box.c2)
        .map(([td]) => td);
      const picked = () => (span ? inside(rect(span.a, span.b)) : []);
      const paint = () => {
        const on = new Set(picked());
        for (const td of tbody.querySelectorAll('td, th')) td.classList.toggle('cell-sel', on.has(td));
        table.classList.toggle('cell-mode', on.size > 1);
      };
      const spanTo = (a, b) => { span = a && b && a !== b ? { a, b } : null; paint(); };
      const drop = () => { if (span) spanTo(null); };

      let pressed = null;
      table.addEventListener('mousedown', (e) => {
        if (e.button !== 0) return;
        const td = cellOf(e.target);
        if (!td) return;
        // Shift-click reaches from where the caret is, as dragging does.
        const from = span?.a || cellOf(getSelection().anchorNode);
        if (e.shiftKey && from && from !== td) { e.preventDefault(); spanTo(from, td); return; }
        drop();
        pressed = td;
      });
      table.addEventListener('mouseover', (e) => {
        if (!pressed || !(e.buttons & 1)) return;
        const td = cellOf(e.target);
        if (td) spanTo(pressed, td);
      });

      /* ---------- rows and columns ---------- */
      /** A new row at `at`: a cell per column, except where a merged cell runs across
          the gap, which grows over the new row instead. */
      const addRowAt = (at) => {
        const g = grid(), w = width(), tr = el('tr'), grown = new Set();
        for (let c = 0; c < w; c++) {
          const above = g[at - 1]?.[c], below = g[at]?.[c];
          if (above && above === below) {
            if (!grown.has(above)) { above.rowSpan += 1; grown.add(above); }
            continue;
          }
          tr.append(cell('td', ''));
        }
        tbody.insertBefore(tr, tbody.rows[at] || null);
      };
      /** A new column at `at`, the same way across. A row holds only the cells that
          begin in it, so the new one goes before the first of those beyond the gap. */
      const addColAt = (at) => {
        const g = grid(), sp = spots(g), grown = new Set();
        [...tbody.rows].forEach((tr, r) => {
          const left = g[r]?.[at - 1], right = g[r]?.[at];
          if (left && left === right) {
            if (!grown.has(left)) { left.colSpan += 1; grown.add(left); }
            return;
          }
          const fresh = cell((right || left)?.tagName === 'TH' ? 'th' : 'td', '');
          tr.insertBefore(fresh, [...tr.children].find((td) => sp.get(td).c >= at) || null);
        });
      };
      /** A row gone. A merged cell that begins in it moves down into the next row. */
      const deleteRow = (r) => {
        const g = grid(), sp = spots(g), tr = tbody.rows[r], next = tbody.rows[r + 1];
        for (const td of new Set(g[r])) {
          if (!td || td.rowSpan < 2) continue;
          td.rowSpan -= 1;
          const s = sp.get(td);
          if (s.r === r && next) next.insertBefore(td, [...next.children].find((x) => sp.get(x).c > s.c) || null);
        }
        tr.remove();
      };
      const deleteCol = (c) => {
        for (const td of new Set(grid().map((row) => row[c]))) {
          if (!td) continue;
          if (td.colSpan > 1) td.colSpan -= 1; else td.remove();
        }
      };
      const deleteTable = () => {
        const blk = wrap.closest('[data-kind]');
        const near = blk.previousElementSibling || blk.nextElementSibling;
        blk.remove();
        if (!body.children.length) body.append(block('para'));
        sync();
        const box = (near && near.isConnected ? near : body.firstElementChild).querySelector('.ce');
        if (box) {
          box.closest('[contenteditable="true"]')?.focus({ preventScroll: true });
          const r = document.createRange(); r.selectNodeContents(box); r.collapse(false); putRange(r);
        }
      };
      /** Into the cell at a spot once the table has changed, or the nearest one left. */
      const settle = (r, c) => {
        const g = grid();
        const row = g[Math.max(0, Math.min(r, g.length - 1))] || [];
        const td = row[Math.max(0, Math.min(c, row.length - 1))];
        if (td) enter(td, true);
      };

      /** Merged as the smallest rectangle covering the selection. Nothing written is
          thrown away: what the other cells held is carried over, a line each. */
      const merge = (box) => {
        const g = grid(), keep = g[box.r1][box.c1], gone = new Set();
        for (let r = box.r1; r <= box.r2; r++) {
          for (let c = box.c1; c <= box.c2; c++) {
            const td = g[r]?.[c];
            if (td && td !== keep) gone.add(td);
          }
        }
        const into = boxOf(keep);
        const blank = (h) => !h || h === '<br>';
        for (const td of gone) {
          const html = boxOf(td)?.innerHTML.trim();
          if (!blank(html)) into.innerHTML = blank(into.innerHTML.trim()) ? html : `${into.innerHTML}<br>${html}`;
          td.remove();
        }
        keep.colSpan = box.c2 - box.c1 + 1;
        keep.rowSpan = box.r2 - box.r1 + 1;
      };
      /** Each slot the merged cell covered gets a cell again, placed after the last cell
          of its row's own before the gap: shrinking the merged cell shifts the rest left,
          so the grid is read afresh for every one. */
      const unmerge = (cells) => {
        for (const keep of cells.filter((c) => c.colSpan > 1 || c.rowSpan > 1)) {
          const at = spots().get(keep), cs = keep.colSpan, rs = keep.rowSpan;
          const tag = keep.tagName.toLowerCase();
          keep.colSpan = 1; keep.rowSpan = 1;
          for (let r = at.r; r < at.r + rs; r++) {
            const tr = tbody.rows[r];
            if (!tr) continue;
            for (let c = at.c; c < at.c + cs; c++) {
              if (r === at.r && c === at.c) continue;
              const own = [...new Set(grid()[r]?.slice(0, c) || [])]
                .filter((x) => x && x.parentElement === tr).pop();
              const fresh = cell(tag, '');
              if (own) own.after(fresh); else tr.prepend(fresh);
            }
          }
        }
      };
      /** A header band can run to several rows, as a two-level column header does. */
      const setHead = (r1, r2, on) => {
        for (let r = r1; r <= r2; r++) {
          for (const td of [...tbody.rows[r].children]) {
            if ((td.tagName === 'TH') === on) continue;
            td.replaceWith(cell(on ? 'th' : 'td', boxOf(td)?.innerHTML || '', td.colSpan || 1, td.rowSpan || 1));
          }
        }
      };

      table.addEventListener('contextmenu', (e) => {
        const td = cellOf(e.target);
        if (!td) return;
        e.preventDefault();
        if (!picked().includes(td)) drop();
        const cells = span ? picked() : [td];
        const sp = spots();
        const box = cells.reduce((b, c) => {
          const s = sp.get(c);
          return { r1: Math.min(b.r1, s.r), c1: Math.min(b.c1, s.c), r2: Math.max(b.r2, s.r2), c2: Math.max(b.c2, s.c2) };
        }, { r1: Infinity, c1: Infinity, r2: -1, c2: -1 });
        const nr = box.r2 - box.r1 + 1, nc = box.c2 - box.c1 + 1;
        const head = cells.every((c) => c.tagName === 'TH');
        const act = (fn) => () => { drop(); fn(); sync(); };
        pointMenu([
          { label: 'Insert row above', run: act(() => { addRowAt(box.r1); settle(box.r1, box.c1); }) },
          { label: 'Insert row below', run: act(() => { addRowAt(box.r2 + 1); settle(box.r2 + 1, box.c1); }) },
          { label: 'Insert column left', run: act(() => { addColAt(box.c1); settle(box.r1, box.c1); }) },
          { label: 'Insert column right', run: act(() => { addColAt(box.c2 + 1); settle(box.r1, box.c2 + 1); }) },
          '-',
          { label: nr > 1 ? `Delete ${nr} rows` : 'Delete row', run: () => {
            drop();
            if (nr >= tbody.rows.length) { deleteTable(); return; }
            for (let r = box.r2; r >= box.r1; r--) deleteRow(r);
            sync(); settle(box.r1, box.c1);
          } },
          { label: nc > 1 ? `Delete ${nc} columns` : 'Delete column', run: () => {
            drop();
            if (nc >= width()) { deleteTable(); return; }
            for (let c = box.c2; c >= box.c1; c--) deleteCol(c);
            sync(); settle(box.r1, box.c1);
          } },
          { label: 'Delete table', run: () => { drop(); deleteTable(); } },
          '-',
          { label: 'Merge cells', off: cells.length < 2, run: act(() => { merge(box); settle(box.r1, box.c1); }) },
          { label: 'Unmerge cells', off: !cells.some((c) => c.colSpan > 1 || c.rowSpan > 1),
            run: act(() => { unmerge(cells); settle(box.r1, box.c1); }) },
          { label: head ? (nr > 1 ? 'Make body rows' : 'Make body row') : (nr > 1 ? 'Make header rows' : 'Make header row'),
            run: act(() => { setHead(box.r1, box.r2, !head); settle(box.r1, box.c1); }) },
        ], e.clientX, e.clientY);
      });

      /* ---------- keys ---------- */
      const MOVE = { ArrowUp: [-1, 0], ArrowDown: [1, 0], ArrowLeft: [0, -1], ArrowRight: [0, 1] };
      table.addEventListener('keydown', (e) => {
        if (e.isComposing) return;
        const s = getSelection();
        const td = cellOf(s.focusNode);
        if (!td || !s.rangeCount) return;
        const box = boxOf(td);
        const move = MOVE[e.key];
        const bare = !e.ctrlKey && !e.metaKey && !e.altKey;

        if (span && e.key === 'Tab') drop();          // Tab moves on from whole cells too
        if (span) {
          if (move && e.shiftKey && bare) {            // grow the selection a cell at a time
            e.preventDefault();
            const g = grid(), at = spots(g).get(span.b);
            const r = move[0] < 0 ? at.r - 1 : move[0] > 0 ? at.r2 + 1 : at.r;
            const c = move[1] < 0 ? at.c - 1 : move[1] > 0 ? at.c2 + 1 : at.c;
            if (g[r]?.[c]) spanTo(span.a, g[r][c]);
            return;
          }
          if (e.key === 'Backspace' || e.key === 'Delete' || (e.key.length === 1 && bare)) {
            // Deleting empties every selected cell; typing does too, and starts in the
            // first of them, as a spreadsheet does.
            e.preventDefault();
            const cells = picked();
            cells.forEach((c) => { boxOf(c).innerHTML = ''; });
            drop();
            enter(cells[0], false);
            if (e.key.length === 1) document.execCommand('insertText', false, e.key);
            else sync();
            return;
          }
          if (move || e.key === 'Escape') {
            e.preventDefault();
            const to = span.b;
            drop();
            enter(to, true);
          }
          return;
        }

        if (e.key === 'Enter') { e.preventDefault(); lineBreak(); return; }
        if (e.key === 'Tab' && bare) {
          e.preventDefault();
          const cells = order();
          const i = cells.indexOf(td) + (e.shiftKey ? -1 : 1);
          if (i < 0) return;
          if (i >= cells.length) { addRowAt(grid().length); sync(); }
          enter(order()[i], true);
          return;
        }
        if (e.key === 'Backspace' || e.key === 'Delete') {
          // At the edge of a cell there is nothing of this cell left to delete, and the
          // browser would start taking the table apart instead.
          if (s.isCollapsed && caretEdges(box)[e.key === 'Backspace' ? 'atStart' : 'atEnd']) e.preventDefault();
          return;
        }
        if (!move || !bare) return;

        const vertical = move[0] !== 0;
        const back = move[0] < 0 || move[1] < 0;
        const x = caretLeft(box);
        const beyond = () => {
          if (vertical) return verticalFrom(td, !back, x);
          const cells = order();
          return cells[cells.indexOf(td) + (back ? -1 : 1)];
        };

        if (e.shiftKey) {
          // Within the cell the selection grows as it always has; at its edge it takes
          // whole cells.
          const was = [s.anchorNode, s.anchorOffset, s.focusNode, s.focusOffset];
          s.modify('extend', back ? 'backward' : 'forward', vertical ? 'line' : 'character');
          const moved = !(s.focusNode === was[2] && s.focusOffset === was[3]);
          e.preventDefault();
          if (moved && box.contains(s.focusNode)) return;
          s.setBaseAndExtent(...was);
          const next = beyond();
          if (next) spanTo(cellOf(s.anchorNode) || td, next);
          return;
        }

        if (vertical) {
          e.preventDefault();
          if (lineWithin(box, back)) return;
          const next = beyond();
          if (next) enter(next, back, x); else leave(!back);
          return;
        }
        if (!s.isCollapsed) return;                   // the browser collapses a selection first
        const at = caretEdges(box);
        if (back ? !at.atStart : !at.atEnd) return;   // within the text: the browser's own move
        e.preventDefault();
        const next = beyond();
        if (next) enter(next, back); else leave(!back);
      });

      table.addEventListener('paste', (e) => {
        const dt = e.clipboardData;
        const text = dt.getData('text/plain');
        const html = dt.getData('text/html');
        const cellEl = span ? picked()[0] : cellOf(getSelection().anchorNode);
        e.preventDefault();
        if (cellEl && /[\t\n]/.test(text.trim())) { drop(); pasteGrid(cellEl, text); return; }
        if (html && /data-tok=|data-slug=/.test(html)) {
          insertHtml(keepTokens(html));
          unglue(ceOf(getSelection().anchorNode));
          return;
        }
        document.execCommand('insertText', false, text);
      });
      // Put stray text back inside the cell's box once the caret has gone, when
      // moving a node can no longer drag the caret along with it.
      table.addEventListener('focusout', () => {
        let moved = false;
        for (const c of table.querySelectorAll('th, td')) {
          const box = boxOf(c);
          if (!box) continue;
          const before = [], after = [];
          let seen = false;
          for (const n of c.childNodes) {
            if (n === box) { seen = true; continue; }
            (seen ? after : before).push(n);
          }
          if (!before.length && !after.length) continue;
          before.reverse().forEach((n) => box.prepend(n));
          after.forEach((n) => box.append(n));
          moved = true;
        }
        if (moved) sync();
      });

      const addRow = (cells, headRow = false) => {
        const tr = el('tr');
        cells.forEach((v) => tr.append(cell(
          cellHead(v, headRow ? 0 : 1) ? 'th' : 'td',
          mdToHtml(cellText(v)), cellSpan(v, 'colspan'), cellSpan(v, 'rowspan'))));
        tbody.append(tr);
      };
      const seed = rows?.length ? rows : [['Column', 'Column'], ['', '']];
      seed.forEach((r, i) => addRow(r, i === 0));
      table._addRow = () => addRowAt(grid().length);
      table._addCol = () => addColAt(width());

      // Whole cells copy as tab-separated rows, so a table goes straight into a
      // spreadsheet; cutting them empties them.
      const tdText = (c) => htmlToMd(boxOf(c), ' ').replace(/\s+/g, ' ').trim();
      const asTsv = (cells) => {
        const sp = spots(), rowsOf = new Map();
        for (const c of cells) {
          const r = sp.get(c).r;
          if (!rowsOf.has(r)) rowsOf.set(r, []);
          rowsOf.get(r).push(c);
        }
        return [...rowsOf.keys()].sort((a, b) => a - b).map((r) => rowsOf.get(r).map(tdText).join('\t')).join('\n');
      };
      const onCopy = (e) => {
        const sel = getSelection();
        let cells = picked();
        if (!cells.length) {
          if (!sel.rangeCount || sel.isCollapsed) return;
          if (!table.contains(sel.anchorNode) || !table.contains(sel.focusNode)) return;
          if (cellOf(sel.anchorNode) === cellOf(sel.focusNode)) return;   // an ordinary copy within a cell
          cells = order().filter((c) => sel.containsNode(c, true));
        }
        if (!cells.length) return;
        e.preventDefault();
        e.clipboardData.setData('text/plain', asTsv(cells));
        if (e.type === 'cut') {
          cells.forEach((c) => { boxOf(c).innerHTML = ''; });
          drop();
          sync();
        }
      };
      table.addEventListener('copy', onCopy);
      table.addEventListener('cut', onCopy);

      wrap.append(table);
      return wrap;
    }

    /* ---------- a menu at the pointer, which is what right-click gives ---------- */
    const pointMenu = (() => {
      const m = el('div', 'drop-menu list point-menu');
      m.hidden = true;
      document.body.append(m);
      const close = () => { m.hidden = true; };
      addEventListener('mousedown', (e) => { if (!m.hidden && !m.contains(e.target)) close(); }, true);
      addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); }, true);
      addEventListener('scroll', (e) => { if (!m.contains(e.target)) close(); }, true);
      addEventListener('blur', close);
      return (items, x, y) => {
        m.innerHTML = '';
        for (const it of items) {
          if (it === '-') { m.append(el('div', 'menu-sep')); continue; }
          const b = el('button', null, it.label);
          b.type = 'button';
          b.disabled = !!it.off;
          b.onmousedown = (e) => e.preventDefault();      // the caret stays in the table
          b.onclick = () => { close(); it.run(); };
          m.append(b);
        }
        m.hidden = false;
        m.style.left = `${Math.max(8, Math.min(x, innerWidth - m.offsetWidth - 8))}px`;
        m.style.top = `${Math.max(8, Math.min(y, innerHeight - m.offsetHeight - 8))}px`;
      };
    })();


    function readBody(blocks = [...body.children]) {
      return blocks.map((b) => {
        const kind = b.dataset.kind;
        const ratioOf = (f) => ([...f.classList].find((c) => /^r-/.test(c)) || '').replace(/^r-/, '');
        if (kind === 'image') {
          const f = b.querySelector('figure');
          return { kind, src: f.querySelector('input').value.trim(),
            caption: htmlToMd(f.querySelector('.cap')).trim(), ratio: ratioOf(f) };
        }
        if (kind === 'float') {
          const f = b.querySelector('figure');
          return {
            kind,
            src: f.querySelector('input').value.trim(),
            caption: htmlToMd(f.querySelector('.cap')).trim(),
            align: f.classList.contains('float-left') ? 'left' : 'right',
            width: Math.round(parseFloat(f.style.width) || 300),
            ratio: ratioOf(f),
          };
        }
        if (kind === 'grid') return {
          kind,
          items: [...b.querySelectorAll('figure')].map((f) => ({
            src: f.querySelector('input').value.trim(),
            caption: htmlToMd(f.querySelector('.cap')).trim(),
            flex: f.style.flex || '',
            ratio: ratioOf(f),
          })),
        };
        if (kind === 'table') return {
          kind,
          ...(b.hasAttribute('data-sortable') && { sortable: true }),
          rows: [...b.querySelectorAll('tbody tr')].map((tr, r) =>
            [...tr.children].map((c) => {
              const text = cellMd(c);
              const head = c.tagName === 'TH', cs = c.colSpan || 1, rs = c.rowSpan || 1;
              // A plain cell stays a plain string, so a table with no spans and one
              // header row serializes as the markdown table it has always been.
              return cs === 1 && rs === 1 && head === (r === 0)
                ? text : { text, ...(cs > 1 && { colspan: cs }), ...(rs > 1 && { rowspan: rs }), head };
            })),
        };
        if (kind === 'list') {
          const lis = [...b.querySelectorAll('li')];
          return {
            kind,
            ...(b.querySelector('.ce-list')?.classList.contains('ordered') && { ordered: true }),
            ...(b.querySelector('.ce-list')?.dataset.numbering === 'outline' && { numbering: 'outline' }),
            // Every item, empty ones included: this is what undo restores, and dropping
            // them here made the history disagree with what is on screen.
            items: lis.map((li) => itemMd(li.querySelector('.ce'))),
            levels: lis.map((li) => +li.dataset.level || 0),
          };
        }
        const dates = kind === 'subsection' ? b.querySelector('.blk-dates')?.value.trim() : '';
        return { kind, text: htmlToMd(b.querySelector('.ce')).trim(), ...(dates && { dates }) };
      });
    }

    /* ---------- insert, relative to where the cursor is ---------- */
    function insert(kind, data = {}) {
      const n = block(kind, data);
      const here = activeText()?.closest?.('.blk');
      // The caret may be in the sidebar, which is no place to hang an article block;
      // fall back to the last block of the body itself rather than to its end.
      const at = here?.parentElement === body ? here
        : lastBodyBlk?.isConnected && lastBodyBlk.parentElement === body ? lastBodyBlk : null;
      if (at) at.after(n);
      else body.append(n);
      (n.querySelector('.ce') || n.querySelector('input'))?.focus();
      sync();
    }

    /* ---------- serialize ---------- */
    function toMarkdown() {
      const v = (id) => $(id).value.trim();
      if (pageKind === 'navbox') return navboxYaml();
      const fm = [`title: ${q(v('#f-title'))}`];
      if (pageKind === 'portal') {
        fm.push(`nation: ${v('#f-nation')}`);
        if (v('#f-banner')) fm.push(`banner: ${v('#f-banner')}`);
        if (v('#f-welcome')) fm.push(`welcome: ${q(v('#f-welcome'))}`);
        const kept = portalBody.trim();
        return `---\n${fm.join('\n')}\n---\n${kept ? `\n${kept}\n` : ''}`;
      }
      // Only when it differs; a sidebar heading that repeats the title is the default.
      if (v('#f-boxtitle') && v('#f-boxtitle') !== v('#f-title')) {
        fm.push(`sidebarTitle: ${q(v('#f-boxtitle'))}`);
      }
      const natives = v('#f-native').split('\n').map((x) => x.trim()).filter(Boolean);
      if (natives.length === 1) fm.push(`nativeTitle: ${q(natives[0])}`);
      else if (natives.length) {
        fm.push('nativeTitle:');
        natives.forEach((n) => fm.push(`  - ${q(n)}`));
      }
      // A romanisation for each native title that has one, a line apiece, as they are.
      const romaji = v('#f-romaji').split('\n').map((x) => x.trim()).filter(Boolean);
      if (romaji.length === 1) fm.push(`romaji: ${q(romaji[0])}`);
      else if (romaji.length) {
        fm.push('romaji:');
        romaji.forEach((n) => fm.push(`  - ${q(n)}`));
      }
      fm.push(`type: ${v('#f-type')}`);
      if (v('#f-nation')) fm.push(`nation: ${v('#f-nation')}`);
      if (v('#f-icon')) fm.push(`icon: ${q(v('#f-icon'))}`);
      // A communal article credits its writers but carries a navbox of its own.
      const authors = v('#f-authors').split(',').map((a) => a.trim()).filter(Boolean);
      if (authors.length) fm.push(`authors: [${authors.join(', ')}]`);
      if (!$('#f-navbox-on').checked) fm.push('navbox: none');
      else if (!v('#f-nation')) fm.push('navbox: site');
      if (v('#f-coords')) fm.push(`coords: ${q(v('#f-coords'))}`);
      if ($('#f-ooc').checked) fm.push('ooc: true');
      // A page moved from an address the site has keeps that address, forwarding here.
      const now = slugify(slugValue() || pageSlug);
      const was = [...movedFrom, ...(onSiteKey('article', pageSlug) && now !== pageSlug ? [pageSlug] : [])]
        .filter((m, i, a) => m !== now && a.indexOf(m) === i);
      if (was.length) fm.push(`movedFrom: [${was.join(', ')}]`);

      // The type skeleton stays on screen to be filled in; only filled rows are written.
      const some = (v) => (Array.isArray(v) ? v.length : v !== '');
      const filled = readInfobox().filter((r) =>
        r.pair ? r.pair.some((c) => c.items.length)
        : r.office != null ? r.office !== '' || r.term !== ''
        : r.section != null ? r.section !== ''
        : r.images ? r.images.some((i) => i.src)
        : r.image != null ? r.image !== ''
        : r.label == null ? some(r.value)
        : r.label !== '' && some(r.value));
      const rows = filled.filter((r, i) =>
        r.section == null || (filled[i + 1] && filled[i + 1].section == null));

      if (rows.length && $('#f-sidebar-on').checked) {
        fm.push('infobox:');
        for (const r of rows) {
          if (r.office != null) { fm.push(`  - { office: ${q(r.office)}, term: ${q(r.term)} }`); continue; }
          if (r.section != null) { fm.push(`  - { section: ${q(r.section)} }`); continue; }
          if (r.images) {
            // Only filled slots are written, and one of them is the plain single form,
            // or the file would change shape again the next time it was saved.
            const got = r.images.filter((i) => i.src);
            if (got.length > 1) {
              fm.push('  - images:');
              for (const im of got) fm.push(`      - { src: ${q(im.src)}, caption: ${q(im.caption)} }`);
              if (r.join) fm.push('    join: true');
            } else {
              const one = got[0] || { src: '', caption: '' };
              fm.push(`  - { image: ${q(one.src)}, caption: ${q(one.caption)}${r.join ? ', join: true' : ''} }`);
            }
            continue;
          }
          if (r.image != null) {
            fm.push(`  - { image: ${q(r.image)}, caption: ${q(r.caption)}${r.join ? ', join: true' : ''} }`);
            continue;
          }
          // A row with a nested line says how deep it may go and whether its lines are drawn.
          const nest = () => {
            if (r.depth) fm.push(`    depth: ${r.depth}`, `    guides: ${r.guides === false ? 'false' : 'true'}`);
          };
          if (r.pair) {
            fm.push('  - pair:');
            for (const col of r.pair) {
              fm.push(`      - items:${col.items.length ? '' : ' []'}`);
              col.items.forEach((it) => fm.push(`          - ${q(it)}`));
            }
            nest();
            continue;
          }
          if (r.label == null) {
            if (Array.isArray(r.value)) {
              fm.push('  - value:');
              r.value.forEach((l) => fm.push(`      - ${q(l)}`));
              nest();
            } else fm.push(`  - { value: ${q(r.value)} }`);
            continue;
          }
          if (Array.isArray(r.value)) {
            fm.push(`  - label: ${q(r.label)}`);
            if (r.sub) fm.push('    sub: true');
            fm.push('    value:');
            r.value.forEach((l) => fm.push(`      - ${q(l)}`));
            nest();
          } else {
            fm.push(`  - { label: ${q(r.label)}${r.sub ? ', sub: true' : ''}, value: ${q(r.value)} }`);
          }
        }
      }

      // Bold or italic that took a space along shows as bold here but prints its
      // asterisks on the page, so it is fixed in every copy written out.
      const md = `---\n${fm.join('\n')}\n---\n\n${bodyMarkdown()}\n`;
      return window.fixEmphasis ? window.fixEmphasis(md) : md;
    }

    /* ---------- navboxes ----------
       A navbox is the same tree the block editor already draws: a group is a heading,
       a row is a subheading, and the row's articles are a list. So it is edited with
       the blocks and controls everything else uses, and converted at the two ends. */

    /** The stored groups, as blocks. */
    function navboxBlocks(groups) {
      const out = [];
      for (const g of groups) {
        out.push({ kind: 'section', text: g.label || '' });
        for (const r of g.rows || []) {
          if (r.label != null) out.push({ kind: 'subsection', text: r.label, dates: r.dates || '' });
          if (r.note != null) out.push({ kind: 'para', text: r.note });
          // A stored item is a slug, or "slug|Display"; either way it is a link here,
          // so it shows the article's real title and the link popover can edit it.
          if (r.items?.length) {
            out.push({
              kind: 'list',
              items: r.items.map((i) => (String(i).startsWith('[[') || String(i).startsWith('[')
                ? String(i) : `[[${i}]]`)),
            });
          }
        }
      }
      return out.length ? out : [{ kind: 'section', text: '' }];
    }

    /** Those blocks, back as the YAML file. */
    function navboxYaml() {
      const v = (id) => $(id).value.trim();
      const lines = [];
      if (v('#f-title')) lines.push(`title: ${q(v('#f-title'))}`);
      if (v('#f-crumb')) lines.push(`crumb: ${q(v('#f-crumb'))}`);
      const blocks = readBody().filter((b) => ['section', 'subsection', 'para', 'list'].includes(b.kind));
      if (!blocks.length) { lines.push('groups: []'); return navboxLead + lines.join('\n') + '\n'; }
      lines.push('groups:');

      let open = false;                       // a row is waiting for its items
      let group = false;                      // a group is open to hang rows on
      let history = false;                    // the open group is History, whose rows are dated
      // Nothing may sit above the first heading, or the file it writes is not a navbox.
      const need = () => { if (!group) { lines.push('  - label: ""', '    rows:'); group = true; } };
      const openRow = (label) => { need(); lines.push(`      - label: ${q(label)}`); open = true; };

      for (const b of blocks) {
        if (b.kind === 'section') {
          lines.push(`  - label: ${q(b.text)}`, '    rows:');
          open = false; group = true;
          history = /^history$/i.test(b.text.trim());
        } else if (b.kind === 'subsection') {
          openRow(b.text);
          // Only History's rows are periods; dates left on a row moved out of it go.
          if (history && b.dates) lines.push(`        dates: ${q(b.dates)}`);
        } else if (b.kind === 'para') {
          need();
          lines.push(`      - note: ${q(b.text)}`);
          open = false;
        } else if (b.kind === 'list') {
          need();
          // A list with no subheading over it is a row with items and no label.
          if (!open) lines.push('      - items:');
          else lines.push('        items:');
          for (const it of b.items.filter(Boolean)) {
            const m = it.match(/^\[\[([^\]|]+?)(?:\|([^\]]+?))?\]\]$/);
            lines.push(`          - ${q(m ? (m[2] ? `${m[1]}|${m[2]}` : m[1]) : it)}`);
          }
          open = false;
        }
      }
      return navboxLead + lines.join('\n') + '\n';
    }

    /** The blocks of the article body alone, as markdown. A portal page has the
        same body and none of the frontmatter, so both callers share this. */
    function bodyMarkdown(blocks) {
      const fig = (i) => {
        const alt = (i.caption || '').replace(/"/g, '&quot;');
        const style = i.flex ? ` style="flex:${parseFloat(i.flex).toFixed(3)}"` : '';
        const cls = i.ratio ? ` class="r-${i.ratio}"` : '';
        return `<figure${cls}${style}><img src="${i.src}" alt="${alt}"><figcaption>${i.caption}</figcaption></figure>`;
      };
      return readBody(blocks).map((b) => {
        if (b.kind === 'section') return '## ' + b.text;
        if (b.kind === 'subsection') return '### ' + b.text;
        if (b.kind === 'subsubsection') return '#### ' + b.text;
        if (b.kind === 'para') return b.text;
        if (b.kind === 'list') {
          // Two spaces deeper for each level, which markdown reads as the list below. A
          // numbered item is four deeper, past "10. ", and each level counts afresh.
          const counts = [];
          // Numbering by outline is said in a note above the list, which markdown has no
          // way to say itself; the site's remark plugin reads it. 1, a, i needs none.
          const note = b.ordered && b.numbering === 'outline' ? NUMBERING_NOTE + '\n' : '';
          return note + b.items.map((t, i) => [t, b.levels?.[i] || 0]).filter(([t]) => t)
            .map(([t, lv]) => {
              if (!b.ordered) return '  '.repeat(lv) + '- ' + t;
              counts.length = lv + 1;
              counts[lv] = (counts[lv] || 0) + 1;
              return '    '.repeat(lv) + counts[lv] + '. ' + t;
            }).join('\n');
        }
        if (b.kind === 'image') return b.src ? fig(b) : '';
        if (b.kind === 'float') {
          if (!b.src) return '';
          const cls = `float float-${b.align === 'left' ? 'left' : 'right'}`
            + (b.ratio ? ` r-${b.ratio}` : '');
          const cap = b.caption ? `<figcaption>${b.caption}</figcaption>` : '<figcaption></figcaption>';
          return `<figure class="${cls}" style="width:${b.width || 300}px">`
            + `<img src="${b.src}" alt="${(b.caption || '').replace(/"/g, '&quot;')}">${cap}</figure>`;
        }
        if (b.kind === 'grid') {
          const items = b.items.filter((i) => i.src);
          return items.length ? '<div class="imgrid">\n' + items.map(fig).join('\n') + '\n</div>' : '';
        }
        if (b.kind === 'table') {
          const [head, ...rest] = b.rows;
          if (!head) return '';
          // Markdown tables cannot express a merged cell or a second header row, so a
          // table that carries either is written as HTML instead. Everything else keeps
          // the pipe form, which stays readable in a diff.
          // A pipe in a cell can be escaped for GFM, but not when it sits inside a
          // token: :img[path|96] would come back as :img[path\|96]. Those go to HTML too.
          if (!b.sortable && b.rows.every((r) => r.every((c) => typeof c === 'string' && !c.includes('|')))) {
            // A pipe inside a cell would split it, so it is escaped for GFM.
            const cell = (c) => String(c).replace(/\|/g, '\\|');
            return ['| ' + head.map(cell).join(' | ') + ' |', '| ' + head.map(() => '---').join(' | ') + ' |',
              ...rest.map((r) => '| ' + r.map(cell).join(' | ') + ' |')].join('\n');
          }
          // Cell text is left as written, exactly as a figure's caption is: it may
          // legitimately hold <br>, <sup> or a token, and escaping would print those.
          const td = (c, r) => {
            const text = typeof c === 'string' ? c : c.text ?? '';
            const head2 = typeof c === 'string' ? r === 0 : !!c.head;
            const cs = typeof c === 'string' ? 1 : c.colspan || 1;
            const rs = typeof c === 'string' ? 1 : c.rowspan || 1;
            const tag = head2 ? 'th' : 'td';
            return `<${tag}${cs > 1 ? ` colspan="${cs}"` : ''}${rs > 1 ? ` rowspan="${rs}"` : ''}>`
              + `${text}</${tag}>`;
          };
          return [b.sortable ? '<table class="sortable">' : '<table>',
            ...b.rows.map((r, i) => '<tr>' + r.map((c) => td(c, i)).join('') + '</tr>'),
            '</table>'].join('\n');
        }
        return '';
      }).filter(Boolean).join('\n\n');
    }

    /* ---------- parse an article body back into blocks ---------- */
    function parseBody(md) {
      const blocks = [];
      for (const chunk of md.trim().split(/\n{2,}/)) {
        let t = chunk.trim();
        if (!t) continue;
        let numbering = null;
        if (t.startsWith(NUMBERING_NOTE + '\n')) { numbering = 'outline'; t = t.slice(NUMBERING_NOTE.length + 1).trim(); }
        if (t.startsWith('#### ')) blocks.push({ kind: 'subsubsection', text: t.slice(5) });
        else if (t.startsWith('### ')) blocks.push({ kind: 'subsection', text: t.slice(4) });
        else if (t.startsWith('## ')) blocks.push({ kind: 'section', text: t.slice(3) });
        else if (t.startsWith('<div class="imgrid"')) {
          blocks.push({
            kind: 'grid',
            items: [...t.matchAll(/<figure([^>]*)><img src="([^"]*)"[^>]*>\s*<figcaption>([\s\S]*?)<\/figcaption>/g)]
              .map((m) => ({ src: m[2], caption: m[3],
                ratio: (m[1].match(/\br-(\S+?)(?=["\s])/) || [])[1] || '' })),
          });
        } else if (t.startsWith('<figure')) {
          const m = t.match(/<img src="([^"]*)"[^>]*>\s*<figcaption>([\s\S]*?)<\/figcaption>/);
          const cls = t.match(/^<figure[^>]*class="([^"]*)"/)?.[1] || '';
          const ratio = (cls.match(/\br-(\S+)/) || [])[1] || '';
          if (cls.includes('float')) {
            blocks.push({
              kind: 'float', src: m?.[1] || '', caption: m?.[2] || '',
              align: cls.includes('float-left') ? 'left' : 'right',
              width: parseInt(t.match(/width:\s*(\d+)px/)?.[1] || '300', 10),
              ratio,
            });
          } else {
            blocks.push({ kind: 'image', src: m?.[1] || '', caption: m?.[2] || '', ratio });
          }
        } else if (t.startsWith('<table')) {
          const doc = new DOMParser().parseFromString(t, 'text/html');
          blocks.push({
            kind: 'table',
            ...(doc.querySelector('table')?.classList.contains('sortable') && { sortable: true }),
            rows: [...doc.querySelectorAll('tr')].map((tr, r) =>
              [...tr.children].map((c) => {
                // The cell goes on as written text, the form a markdown table gives, so the
                // entities the parser wrote back are turned into their characters here.
                // Left in, & showed in the editor as &amp; and was saved that way.
                const text = c.innerHTML.trim().replace(/&lt;/g, '<').replace(/&gt;/g, '>')
                  .replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&');
                const head = c.tagName === 'TH', cs = c.colSpan || 1, rs = c.rowSpan || 1;
                return cs === 1 && rs === 1 && head === (r === 0)
                  ? text : { text, ...(cs > 1 && { colspan: cs }), ...(rs > 1 && { rowspan: rs }), head };
              })),
          });
        } else if (/^\|/.test(t)) {
          blocks.push({
            kind: 'table',
            rows: t.split('\n').filter((l) => !/^\|[\s|:-]+\|$/.test(l)).map((l) =>
              l.replace(/^\||\|$/g, '').split(/(?<!\\)\|/).map((s) => s.trim().replace(/\\\|/g, '|'))),
          });
        } else if (t.split('\n').every((l) => /^ *(- |\d+\. )/.test(l))) {
          // An item indented past the one above is one level below it.
          const stack = [], items = [], levels = [];
          for (const l of t.split('\n')) {
            const ind = l.length - l.trimStart().length;
            while (stack.length && stack[stack.length - 1] >= ind) stack.pop();
            levels.push(stack.length);
            stack.push(ind);
            items.push(l.trimStart().replace(/^(- |\d+\. )/, ''));
          }
          blocks.push({ kind: 'list', ...(/^ *\d+\. /.test(t) && { ordered: true }),
            ...(numbering && { numbering }), items, levels });
        } else blocks.push({ kind: 'para', text: t.replace(/\n/g, ' ') });
      }
      return blocks;
    }

    /* ---------- canvas mirrors the settings ---------- */
    /** In a navbox, the rows under History are the history series' periods: they get dates. */
    function paintDates() {
      let history = false;
      for (const b of body.children) {
        if (b.dataset.kind === 'section') {
          history = pageKind === 'navbox' && /^history$/i.test(b.querySelector('.ce')?.textContent.trim() || '');
        } else if (b.dataset.kind === 'subsection') b.classList.toggle('dated', history);
      }
    }
    function paintCanvas() {
      paintDates();
      const t = $('#f-title').value.trim();
      // Never over the field somebody is typing in: these are edited in place now, and
      // rewriting one under the caret throws the cursor back to the start.
      const idle = (el) => document.activeElement !== el;
      // A sidebar heading nobody has set shows the article's title, greyed, which is
      // what the page will carry.
      $('#ib-title').dataset.ph = t || 'Article title';
      if (idle($('#ib-title'))) $('#ib-title').textContent = $('#f-boxtitle').value.trim();
      if (idle($('#ib-native'))) {
        $('#ib-native').innerHTML = $('#f-native').value.trim()
          .split('\n').map((n) => esc(n.trim())).filter(Boolean).join('<br>');
      }
      if (idle($('#ib-romaji'))) {
        $('#ib-romaji').innerHTML = $('#f-romaji').value.trim()
          .split('\n').map((n) => esc(n.trim())).filter(Boolean).join('<br>');
      }
      if ($('#canvas-title').textContent !== t && idle($('#canvas-title'))) {
        $('#canvas-title').textContent = t;
      }
      const nat = $('#f-nation');
      const name = nat.value ? nat.options[nat.selectedIndex].text : '';
      $('#canvas-by').innerHTML = name ? `By <a href="#">${esc(name)}</a>` : '';
      $('#ooc-note').hidden = !$('#f-ooc').checked;
    }

    /* ---------- drafts: every page's unsent edits, kept in this browser ----------
       One per page, in IndexedDB, written as the page changes and put back whenever
       the page is opened again. The draft used to sit in sessionStorage, which a tab
       takes with it when it closes, and there was only the one: opening a second page,
       or reloading one opened from its Edit link, put the live copy over it. */
    const DRAFT = 'talopedia-draft';          // that old single draft, brought over once
    const SAVED = 'talopedia-saved';          // what the dev server's Save wrote, said after its reload
    const drafts = shelf('talopedia-drafts', 'drafts');
    let draftKey = '';                        // whose draft the page on screen is
    let opened = '';                          // the page as opened: it has a draft once it differs
    let kept = null;                          // the text last written, so a page is not rewritten unchanged
    const newKey = () => `new:${Date.now().toString(36)}${Math.random().toString(36).slice(2, 6)}`;
    const ago = (t) => {
      const s = (Date.now() - t) / 1000;
      if (s < 60) return 'just now';
      const [n, unit] = s < 3600 ? [s / 60, 'minute'] : s < 86400 ? [s / 3600, 'hour'] : [s / 86400, 'day'];
      return new Intl.RelativeTimeFormat('en', { numeric: 'always' }).format(-Math.floor(n), unit);
    };
    const fields = ['#f-title', '#f-boxtitle', '#f-native', '#f-romaji', '#f-type', '#f-nation', '#f-icon',
      '#f-authors', '#f-coords', '#f-banner', '#f-welcome', '#f-crumb'];
    const snapshot = () => ({
      meta: Object.fromEntries(fields.map((f) => [f, $(f).value])),
      ooc: $('#f-ooc').checked,
      navbox: $('#f-navbox-on').checked,
      sidebar: $('#f-sidebar-on').checked,
      slug: slugValue(),
      from: loadedFrom,
      movedFrom,
      // What is being edited, and the two things it holds that are never on screen.
      // Without these an undo, or the reload after a save, turns a portal into an article.
      kind: pageKind,
      portalBody,
      navboxLead,
      infobox: readInfobox(),
      blocks: readBody(),
    });

    function restore(d) {
      for (const [f, v] of Object.entries(d.meta || {})) if ($(f)) $(f).value = v;
      $('#f-ooc').checked = !!d.ooc;
      $('#f-navbox-on').checked = d.navbox !== false;
      $('#f-sidebar-on').checked = d.sidebar !== false;
      if (d.slug) { setSlug(d.slug); slugTouched = true; }
      if (d.from !== undefined) loadedFrom = d.from;
      movedFrom = d.movedFrom || [];
      pageKind = d.kind || 'article';
      portalBody = d.portalBody || '';
      navboxLead = d.navboxLead || '';
      setInfobox(d.infobox || []);
      body.innerHTML = '';
      (d.blocks || []).forEach((b) => body.append(block(b.kind, b)));
      if (!body.children.length && pageKind !== 'portal') body.append(block('para'));
      paintSettings();
    }

    /**
     * A row of pictures measures itself once they load and writes the widths into the
     * page. On a page nobody has touched, that is the page as opened, not an edit: left
     * as one, merely opening a page put it in Publish with words it never lost. A page
     * reopened from a draft is not the page as opened, and is left alone.
     */
    function rebaseIfUntouched() {
      if (!settling || past.length > 1 || !draftKey || kept?.key !== draftKey || kept.markdown !== opened) return;
      const md = toMarkdown();
      if (md === opened) return;
      opened = md;
      loadedBody = md;
      kept = { key: draftKey, markdown: md };
    }

    let draftTimer;
    function stash() {
      clearTimeout(draftTimer);
      draftTimer = setTimeout(keep, 400);
    }
    /**
     * Write the page on screen to its draft, or drop the draft once the page is back as it
     * was opened. Everything is read before the first wait, so a page being left can be
     * kept on the way out without the next one's text landing under its name.
     */
    async function keep() {
      clearTimeout(draftTimer);
      if (!draftKey) return;
      const key = draftKey, markdown = toMarkdown();
      if (kept?.key === key && kept.markdown === markdown) return;
      kept = { key, markdown };
      try {
        if (markdown === opened) { await drafts.drop(key); return; }
        await drafts.put({
          key, kind: pageKind, slug: slugValue(), title: $('#f-title').value.trim(), at: Date.now(),
          snap: snapshot(), markdown, opened, file: pageSlug, loadedTitle, loadedBody,
          images: [...staged.entries()].filter(([p]) => markdown.includes(p)).map(([p, s]) => ({ path: p, file: s.file })),
        });
      } catch { kept = null; } finally { paintPending(); }
    }
    // A tab closing, or put away by a phone, writes what the last keystrokes left waiting.
    addEventListener('pagehide', keep);
    document.addEventListener('visibilitychange', () => { if (document.hidden) keep(); });

    /** A page's draft: under its own name, or a new page's that has since taken that address. */
    async function draftFor(kind, slug) {
      try {
        const all = await drafts.all();
        return all.find((d) => d.key === `${kind}:${slug}`)
          || all.filter((d) => d.kind === kind && d.slug === slug).sort((a, b) => b.at - a.at)[0] || null;
      } catch { return null; }
    }

    /**
     * Put a saved draft back on screen, pictures and all, with the copy of main its edits
     * were made on, so a change on main since is merged with them rather than lost.
     * Over a page just opened from the site, that page stays what Commit compares with.
     */
    function reopen(d, overLive = false) {
      draftKey = d.key;
      opened = d.opened ?? '';
      kept = { key: d.key, markdown: d.markdown };
      restore(d.snap);
      pageSlug = d.file ?? '';
      if (!overLive) { loadedTitle = d.loadedTitle ?? ''; loadedBody = d.loadedBody ?? ''; }
      for (const im of d.images || []) {
        if (!staged.has(im.path)) staged.set(im.path, { file: im.file, url: URL.createObjectURL(im.file) });
      }
      paintAssets();
      resetHistory();
      sync();
      paintPending();
      flash(`Unsent edits put back, saved ${ago(d.at)}.`);
    }

    /** Throw a page's unsent edits away; on screen, it goes back to the site's copy. */
    async function resetDraft(d) {
      const here = d.key === draftKey;
      if (here) { clearTimeout(draftTimer); draftKey = ''; }
      await drafts.drop(d.key);
      notes.drop(d.key);
      if (here) {
        if (d.file && onSiteKey(d.kind, d.file)) await load(d.kind === 'article' ? d.file : `${d.kind}:${d.file}`);
        else blank('article');
      }
      paintPending();
    }

    const tocToggle = $('#ed-toc-toggle');
    tocToggle.onclick = () => {
      tocToggle.textContent = $('.ed-rail').classList.toggle('collapsed') ? 'show' : 'hide';
    };
    // A long contents list above the article is in the way on a phone.
    if (innerWidth <= 1000) { $('.ed-rail').classList.add('collapsed'); tocToggle.textContent = 'show'; }

    function paintToc() {
      const nav = $('#ed-toc');
      nav.innerHTML = '';
      const top = el('li', 'top');
      const a0 = el('a', null, '(Top)');
      a0.href = '#';
      a0.onclick = (e) => { e.preventDefault(); scrollTo({ top: 0, behavior: 'smooth' }); };
      top.append(a0);
      nav.append(top);
      // Three deep, as the page's own Contents is: a sub-sub-heading hangs under the sub-heading
      // before it, or straight under the heading when it has none.
      let sub = null, subsub = null, underSub = false;
      for (const b of body.children) {
        const kind = b.dataset.kind;
        if (kind !== 'section' && kind !== 'subsection' && kind !== 'subsubsection') continue;
        const text = b.querySelector('.ce')?.textContent.trim();
        if (!text) continue;
        const li = el('li');
        const a = el('a', null, text);
        a.href = '#';
        a.onclick = (e) => {
          e.preventDefault();
          b.scrollIntoView({ block: 'center', behavior: 'smooth' });
          b.querySelector('.ce')?.focus();
        };
        li.append(a);
        if (kind === 'section') { nav.append(li); sub = subsub = null; underSub = false; }
        else if (kind === 'subsubsection' && underSub) {
          if (!subsub) { subsub = el('ul'); sub.lastElementChild.append(subsub); }
          subsub.append(li);
        } else {
          if (!sub) { sub = el('ul'); (nav.lastElementChild || nav).append(sub); }
          sub.append(li);
          subsub = null; underSub = kind === 'subsection';
        }
      }
    }

    // Coordinates only mean something for a nation or a city.
    function paintSettings() {
      const t = $('#f-type').value;
      // A portal carries a banner and a welcome line and nothing else; a navbox carries
      // a title and a breadcrumb. Neither has a type, a byline, coordinates or an infobox.
      const art = pageKind === 'article', portal = pageKind === 'portal', nav = pageKind === 'navbox';
      for (const [id, on] of [
        ['#banner-field', portal], ['#welcome-field', portal], ['#crumb-field', nav],
        ['#type-field', art], ['#authors-field', art],
        ['#nation-field', !nav],
      ]) $(id).hidden = !on;
      // The byline says who may edit the page once it exists, so it stops being
      // editable once the page does. `authors` carries the byline when it is set and
      // `nation` carries it when it is not, so whichever one is holding it locks; a
      // nation that is only choosing the navbox stays free. The dev server is the way
      // back in, and a pull request that moves a byline is reviewed rather than merged.
      const settled = !DEV && ARTICLES.some((a) => a.slug === indexKey(pageKind, slugValue()));
      $('#f-authors').readOnly = settled;
      $('#f-authors').title = settled ? 'Set when the page was created.' : '';
      $('#f-nation').disabled = settled && !$('#f-authors').value.trim();
      $('#settings').querySelector('.set-toggles').hidden = !art;
      // Not every article wants a sidebar. The rows stay in the editor while it is
      // off, so turning it back on before saving brings them back untouched.
      const sidebar = $('#f-sidebar-on').checked;
      document.querySelector('.ib-edit').hidden = !art || !sidebar;
      // Only the types that sit somewhere on the map.
      const PLACED = ['overview', 'city', 'subdivision', 'continent', 'geography'];
      $('#coords-field').hidden = !art || !PLACED.includes(t);
      // A portal has no body of its own to edit: the template is the page.
      $('#portal-note').hidden = !portal;
      body.hidden = portal;
      document.querySelector('.ed').dataset.kind = pageKind;
      if (portal) {
        const n = $('#f-nation').value;
        const named = n ? ($('#f-nation').selectedOptions[0]?.textContent || n) : 'this nation';
        $('#portal-overview').textContent = n
          ? `the overview article for ${named}.`
          : 'choose the nation in page settings first.';
        $('#go-navbox').disabled = !n;
      }
      // Where this page lives when it is not being edited. A navbox has no page of
      // its own, so the portal carrying it is the nearest thing to go back to.
      const to = !pageSlug ? ''
        : pageKind === 'article' ? (pageSlug === 'home' ? '/' : `/${pageSlug}`)
        : pageKind === 'navbox' && pageSlug === 'site' ? '/'
        : `/portal/${pageSlug}`;
      $('#back').dataset.to = to;
      $('#back').disabled = !to;

      paintAddress();
      paintAuthors();
    }
    /* ---------- undo / redo ----------
       Modelled on Google Docs. A snapshot stack rather than execCommand('undo'),
       because adding or removing a block is not a text edit and the browser's own
       history does not see it. Typing is gathered a word at a time; everything else
       (a paste, bold, a new block, a moved row) is a step of its own; and undoing puts
       the caret back where the change was, so the writer can see what went.

       Each step keeps the whole page as it stood after it, and where the caret was
       when it began and when it ended. The history belongs to one page: opening,
       starting or duplicating another clears it, since undoing into the last page
       is how one article's text ends up under another's name. */
    const PAUSE = 1000;      // a stop this long in typing starts the next step
    const DEPTH = 200;
    const past = [], future = [];
    let quiet = false;       // true while a remembered state is being put back
    let run = null;          // the typing the newest step is still gathering
    let settling = true;     // just opened, and nobody has touched it yet

    function paintHistory() {
      $('#undo').disabled = past.length < 2;
      $('#redo').disabled = !future.length;
    }
    function resetHistory() {
      past.length = 0;
      future.length = 0;
      run = null;
      settling = true;
      paintHistory();
    }

    /** Typing and deleting gather into runs; anything else stands alone. */
    function editKind(e) {
      const t = e?.inputType || '';
      if (t === 'insertText' || t === 'insertCompositionText') return 'type';
      if (/^delete(Content|Word|SoftLine|HardLine)/.test(t)) return 'delete';
      return 'other';
    }

    /** Where the caret is, in terms that survive the page being rebuilt: which
        editable box, counted in page order, and how many characters into it. */
    function caretMark() {
      const sel = getSelection();
      if (!sel.rangeCount) return null;
      const n = sel.focusNode;
      const box = (n?.nodeType === 1 ? n : n?.parentElement)?.closest('[contenteditable="true"]');
      const i = box ? [...document.querySelectorAll('.ed-canvas [contenteditable="true"]')].indexOf(box) : -1;
      if (i < 0) return null;
      const r = document.createRange();
      r.selectNodeContents(box);
      r.setEnd(n, sel.focusOffset);
      const before = r.toString();
      return { i, at: before.length, prev: before.slice(-1) };
    }
    function placeCaret(mark) {
      if (!mark) return null;
      const box = document.querySelectorAll('.ed-canvas [contenteditable="true"]')[mark.i];
      if (!box) return null;
      const r = document.createRange();
      const walk = document.createTreeWalker(box, NodeFilter.SHOW_TEXT);
      let left = mark.at, node, placed = false;
      while ((node = walk.nextNode())) {
        if (left <= node.nodeValue.length) {
          // Never inside an arrow, a flag or a date: after it.
          const lock = node.parentElement.closest('[contenteditable="false"]');
          if (lock) r.setStartAfter(lock); else r.setStart(node, left);
          placed = true;
          break;
        }
        left -= node.nodeValue.length;
      }
      if (!placed) {
        // A space at the end of a line is trimmed from what is saved, so a step that
        // began just after one comes back without it. Put it back, or the next word
        // typed runs straight into the last.
        const t = box.textContent;
        if (t && mark.at === t.length + 1 && !/\s$/.test(t)) box.append('\u00a0');
        r.selectNodeContents(box);
        r.collapse(false);
      }
      r.collapse(true);
      box.focus({ preventScroll: true });
      const sel = getSelection();
      sel.removeAllRanges();
      sel.addRange(r);
      return r;
    }
    /** Bring the caret into view, but only if it is out of sight. */
    function reveal(r) {
      if (!r) return;
      let box = r.getBoundingClientRect();
      if (!box.height) {
        const n = r.startContainer;
        box = (n.nodeType === 1 ? n : n.parentElement).getBoundingClientRect();
      }
      const top = Math.max(0, $('.ed-tools').getBoundingClientRect().bottom) + 16;
      const bottom = innerHeight - 24;
      if (box.top >= top && box.bottom <= bottom) return;
      // A third of the way down rather than at an edge, so what surrounds it shows too.
      window.scrollBy(0, box.top - (top + (bottom - top) / 3));
    }

    function remember(e) {
      if (quiet) return;
      const kind = editKind(e);
      const mark = caretMark();
      const state = JSON.stringify(snapshot());
      const top = past[past.length - 1];
      const changed = !top || top.state !== state;
      const box = e?.target?.closest?.('[contenteditable="true"]') || e?.target || null;
      if (changed && settling && past.length === 1) {
        // A page that has just opened is still settling (link titles arriving, say)
        // until somebody touches it. That is the page as opened, not an edit to undo.
        top.state = state;
      } else if (changed) {
        const t = Date.now();
        const joins = run && !run.closed && kind !== 'other' && kind === run.kind
          && box === run.box && t - run.last < PAUSE;
        if (joins) {
          top.state = state;
          top.end = mark;
          run.last = t;
        } else {
          // Typing leaves the caret after what it typed; the step began before it.
          const back = kind === 'type' ? (e.data?.length ?? 1) : 0;
          const start = mark && { i: mark.i, at: Math.max(0, mark.at - back) };
          past.push({ state, start, end: mark });
          if (past.length > DEPTH) past.shift();
          run = kind === 'other' ? null : { kind, box, last: t, closed: false };
        }
        future.length = 0;
        paintHistory();
      } else if (run && kind === run.kind && box === run.box) {
        // Nothing saved changed (a space at the end of a line), but the step still
        // ends where the caret now is, so a redo puts the space back too.
        top.end = mark;
      }
      // A space ends the word before it, so the next letter starts a step of its own.
      // Checked even when nothing saved changed: a space at the end of a line is
      // trimmed from what is saved, so the page reads the same with it as without.
      if (run && kind === 'type' && /\s/.test(mark?.prev || '')) run.closed = true;
    }

    // Putting the caret somewhere by hand ends the run, as it does in Google Docs:
    // whatever is typed next is somewhere else, and is a step of its own.
    addEventListener('pointerdown', () => { run = null; settling = false; }, true);
    addEventListener('keydown', (e) => {
      settling = false;
      if (/^(Arrow|Home$|End$|Page)/.test(e.key)) run = null;
    }, true);

    /**
     * Put a remembered state back without the page jumping, then put the caret where
     * the change was and scroll only if that is out of sight. restore() rebuilds the
     * body and the sidebar, which drops the scroll position to wherever the shorter
     * document ends, so the position is held across it first.
     */
    function apply(state, mark) {
      const y = window.scrollY;
      quiet = true;
      // finally: a restore that throws must not leave the history deaf for the rest
      // of the session, or the next undo would throw away everything since.
      try { restore(JSON.parse(state)); } finally { quiet = false; }
      paintCanvas(); paintToc();
      $('#preview').textContent = toMarkdown();
      run = null;
      paintHistory();
      stash();
      window.scrollTo(0, y);
      reveal(placeCaret(mark));
    }
    $('#undo').onclick = () => {
      if (past.length < 2) return;
      const undone = past.pop();
      future.push(undone);
      apply(past[past.length - 1].state, undone.start);
    };
    $('#redo').onclick = () => {
      if (!future.length) return;
      const redone = future.pop();
      past.push(redone);
      apply(redone.state, redone.end);
    };
    // Undo from the Edit menu or the right-click menu is the browser's own, whose
    // history knows nothing of rebuilt blocks. Routed here wherever it can be.
    addEventListener('beforeinput', (e) => {
      if (e.inputType !== 'historyUndo' && e.inputType !== 'historyRedo') return;
      if (!e.cancelable) return;
      e.preventDefault();
      $(e.inputType === 'historyUndo' ? '#undo' : '#redo').click();
    }, true);

    function sync(e) {
      paintSettings();
      paintCanvas();
      paintToc();
      $('#preview').textContent = toMarkdown();
      remember(e);
      stash();
    }

    /* ---------- open an existing article ---------- */
    async function load(slug) {
      keep();                            // the page being left keeps its last keystrokes
      await titlesReady;
      pageKind = slug.startsWith('portal:') ? 'portal' : slug.startsWith('navbox:') ? 'navbox' : 'article';
      const bare = slug.replace(/^(portal|navbox):/, '');
      const path = pageKind === 'article' ? `/raw/${bare}.json` : `/raw/${pageKind}/${bare}.json`;
      const r = await fetch(`${BASE.replace(/\/$/, '')}${path}`);
      const draft = await draftFor(pageKind, bare);
      // A page not on the site that has a draft is a new one, so far only in this browser.
      if (!r.ok && draft) { reopen(draft); return; }
      // A portal or navbox that does not exist yet is not an error: it is the one
      // you are about to write, which is how a new nation gets either of them.
      if (!r.ok) {
        if (pageKind === 'article') { flash('Could not open that page.', true); return; }
        blank(pageKind, bare);
        flash(`New ${pageKind}: ${bare}. Nothing saved yet.`);
        return;
      }
      const loaded = await r.json();
      const { data, body: md } = loaded;
      loadedFrom = loaded.commit || '';
      navboxLead = loaded.lead || '';
      portalBody = pageKind === 'portal' ? (md || '') : '';
      $('#f-crumb').value = data.crumb || '';
      $('#f-banner').value = data.banner || '';
      $('#f-welcome').value = data.welcome || '';
      $('#f-title').value = data.title || '';
      $('#f-boxtitle').value = data.sidebarTitle || '';
      $('#f-native').value = [].concat(data.nativeTitle ?? []).join('\n');
      $('#f-romaji').value = [].concat(data.romaji ?? []).join('\n');
      $('#f-type').value = data.type || 'overview';
      $('#f-nation').value = data.nation || '';
      $('#f-icon').value = data.icon || '';
      $('#f-authors').value = (data.authors || []).join(', ');
      $('#f-navbox-on').checked = data.navbox !== 'none';
      $('#f-sidebar-on').checked = !!(data.infobox || []).length;
      $('#f-coords').value = data.coords || '';
      $('#f-ooc').checked = !!data.ooc;
      movedFrom = data.movedFrom || [];
      pageSlug = bare;
      loadedTitle = (data.title || '').trim();
      setSlug(bare); slugTouched = true;
      setInfobox(data.infobox || []);
      paintSettings();
      body.innerHTML = '';
      (pageKind === 'navbox' ? navboxBlocks(loaded.groups || []) : parseBody(md || ''))
        .forEach((b) => body.append(block(b.kind, b)));
      // A portal has no body of its own, so it is not given an empty paragraph.
      if (!body.children.length && pageKind !== 'portal') body.append(block('para'));
      resetHistory();
      sync();
      loadedBody = toMarkdown();
      // Unsent edits to this page go back over the copy the site has.
      if (draft && draft.markdown !== loadedBody) { reopen(draft, true); return; }
      if (draft) drafts.drop(draft.key).catch(() => {});   // the site says the same now
      draftKey = `${pageKind}:${bare}`;
      opened = loadedBody;
      kept = { key: draftKey, markdown: opened };
      paintPending();
      flash(`Opened ${data.title}.`);
    }

    /* ---------- chrome ---------- */
    let statusTimer;
    function flash(msg, bad = false) {
      const s = $('#status');
      s.textContent = msg;
      s.className = 'status ' + (bad ? 'bad' : 'good');
      clearTimeout(statusTimer);
      statusTimer = setTimeout(() => { s.textContent = ''; s.className = 'status'; }, 4000);
    }

    function dropdown(btn, menu) {
      btn.onclick = (e) => {
        e.stopPropagation();
        document.querySelectorAll('.drop-menu').forEach((m) => { if (m !== menu) m.hidden = true; });
        menu.hidden = !menu.hidden;
        if (menu.hidden) return;
        // A wide panel opened from the middle of the toolbar would run off the
        // screen, so slide it back until it fits.
        menu.style.left = '0px';
        const r = menu.getBoundingClientRect();
        const over = r.right - (innerWidth - 12);
        if (over > 0) menu.style.left = `${-over}px`;
      };
    }
    dropdown($('#file'), $('#file-menu'));
    dropdown($('#insert'), $('#insert-menu'));

    function paintFileList() {
      const q = $('#file-q').value.trim().toLowerCase();
      const list = $('#file-list');
      list.innerHTML = '';
      const hits = ARTICLES.filter((a) => !q || a.title.toLowerCase().includes(q) || a.slug.includes(q));
      if (!hits.length) { list.innerHTML = '<p class="mp-empty">No article matches.</p>'; return; }
      for (const a of hits) {
        const b = el('button', null, a.title);
        b.type = 'button';
        b.onclick = () => { $('#file-menu').hidden = true; load(a.slug); };
        list.append(b);
      }
    }
    $('#file-q').oninput = paintFileList;
    $('#file').addEventListener('click', () => {
      if (!$('#file-menu').hidden) { paintFileList(); $('#file-q').focus(); }
    });
    dropdown($('#more'), $('#more-menu'));
    dropdown($('#style'), $('#style-menu'));
    dropdown($('#ins'), $('#ins-menu'));
    document.addEventListener('click', () => {
      document.querySelectorAll('.drop-menu').forEach((m) => m.hidden = true);
      pickTarget = null;      // the panel is shut; it is not aimed at anything now
    });

    $('#back').onclick = () => {
      const to = $('#back').dataset.to;
      if (to) location.href = BASE.replace(/\/$/, '') + to;
    };
    $('#source').onclick = () => { $('#source-panel').hidden = false; };
    $('#source-close').onclick = () => { $('#source-panel').hidden = true; };

    document.querySelectorAll('[data-add]').forEach((b) => b.onclick = () => insert(b.dataset.add));
    // The list buttons work on what is there, as in a word processor: the paragraph
    // becomes a list, rather than an empty list going in under it.
    document.querySelectorAll('[data-list], [data-num]').forEach((b) => {
      b.onmousedown = (e) => e.preventDefault();
      b.onclick = () => {
        if (b.dataset.num) toggleList(true, b.dataset.num);
        else toggleList(b.dataset.list === 'numbered');
        document.querySelectorAll('.drop-menu').forEach((m) => { m.hidden = true; });
      };
    });

    /* ---------- table size pickers ---------- */
    // Docs-style grid: hovering sizes the table, clicking inserts it. A data table is
    // the same table, written so that a reader can sort it by any column.
    function sizePicker(pick, label, extra) {
      const MAXR = 8, MAXC = 8;
      for (let r = 1; r <= MAXR; r++) {
        for (let c = 1; c <= MAXC; c++) {
          const cell = el('span', 'tbl-cell');
          cell.dataset.r = r; cell.dataset.c = c;
          cell.onmouseenter = () => {
            label.textContent = `${c} \u00d7 ${r}`;
            pick.querySelectorAll('.tbl-cell').forEach((x) =>
              x.classList.toggle('on', +x.dataset.r <= r && +x.dataset.c <= c));
          };
          cell.onmousedown = (e) => e.preventDefault();
          cell.onclick = () => {
            insert('table', { rows: r, cols: c, ...extra });
            document.querySelectorAll('.drop-menu').forEach((m) => m.hidden = true);
          };
          pick.append(cell);
        }
      }
      pick.onmouseleave = () => {
        label.textContent = '0 \u00d7 0';
        pick.querySelectorAll('.tbl-cell').forEach((x) => x.classList.remove('on'));
      };
    }
    sizePicker($('#tbl-pick'), $('#tbl-label'), {});
    sizePicker($('#dtbl-pick'), $('#dtbl-label'), { sortable: true });

    /* ---------- date ---------- */
    let dtMode = '';
    const dtArg = () => {
      const d = $('#dt-date').value;
      if (!d) return '';
      if (dtMode === 'age') {
        // For an age the date above is the birth. A death date, when there is one, is
        // the date printed, with the age that was reached by then.
        const died = $('#dt-died').value;
        return died ? `${died}|age:${d}` : `${d}|age`;
      }
      return dtMode ? `${d}|${dtMode}` : d;
    };
    function paintDate() {
      const age = dtMode === 'age';
      $('#dt-date-label').textContent = age ? 'Born' : 'Date';
      $('#dt-died-row').hidden = !age;
      const arg = dtArg();
      $('#dt-preview').textContent = arg ? dateLabel(arg) : 'Pick a date.';
      $('#dt-preview').className = 'mp-hint' + (arg ? ' ok' : '');
      $('#dt-go').disabled = !arg;
    }
    document.querySelectorAll('#dt-mode button').forEach((b) => {
      b.onmousedown = (e) => e.preventDefault();
      b.onclick = () => {
        document.querySelectorAll('#dt-mode button').forEach((x) => x.classList.toggle('on', x === b));
        dtMode = b.dataset.mode;
        paintDate();
      };
    });
    // A native date picker opens wherever its value points, and with none it opens on
    // the real year. Avium is in 1934, which is where the writer means to be.
    $('#dt-date').value = IC_NOW;
    $('#dt-date').oninput = paintDate;
    $('#dt-died').oninput = paintDate;
    $('#dt-go').onclick = () => {
      const arg = dtArg();
      if (!arg) return;
      if (!insertToken('date', arg)) return;
      document.querySelectorAll('.drop-menu').forEach((m) => { m.hidden = true; });
    };
    paintDate();

    /* ---------- link popover ---------- */
    const pop = $('#link-pop');
    const lpText = $('#lp-text');
    const lpTarget = $('#lp-target');
    let savedRange = null;
    let editingAnchor = null;

    const closeLink = () => { pop.hidden = true; savedRange = null; editingAnchor = null; };

    function anchorAtCaret() {
      const sel = window.getSelection();
      if (!sel.anchorNode) return null;
      const node = sel.anchorNode.nodeType === 1 ? sel.anchorNode : sel.anchorNode.parentElement;
      const a = node?.closest?.('a');
      return a && a.closest('.ce') ? a : null;
    }

    function openLink() {
      const where = activeText();
      if (!where) { flash('Put the cursor in the text first.', true); return; }
      const sel = window.getSelection();
      savedRange = sel.rangeCount ? sel.getRangeAt(0).cloneRange() : null;
      editingAnchor = anchorAtCaret();

      lpText.value = editingAnchor ? editingAnchor.textContent : (sel.toString() || '');
      lpTarget.value = editingAnchor
        ? (editingAnchor.dataset.slug || editingAnchor.getAttribute('href') || '')
        : '';
      $('#lp-remove').hidden = !editingAnchor;

      // Sit under the selection, or under the block if the caret is collapsed.
      const box = (editingAnchor || where).getBoundingClientRect();
      const r = savedRange && savedRange.getBoundingClientRect();
      const anchorRect = r && r.width ? r : box;
      pop.hidden = false;
      const w = pop.offsetWidth;
      pop.style.left = `${Math.max(12, Math.min(anchorRect.left, innerWidth - w - 12))}px`;
      pop.style.top = `${Math.min(anchorRect.bottom + 8, innerHeight - pop.offsetHeight - 12)}px`;
      paintLinkResults();
      (lpText.value ? lpTarget : lpText).focus();
      lpTarget.select?.();
    }

    function paintLinkResults() {
      const q = lpTarget.value.trim().toLowerCase();
      const list = $('#lp-list');
      list.innerHTML = '';
      if (/^https?:/i.test(q)) {
        list.innerHTML = '<p class="lp-empty">External link. Apply to insert it.</p>';
        return;
      }
      const hits = ARTICLES.filter((a) => !q || a.title.toLowerCase().includes(q) || a.slug.includes(q)).slice(0, 6);
      for (const a of hits) {
        const b = el('button', 'lp-hit');
        b.type = 'button';
        b.innerHTML = `<span class="lp-title">${esc(a.title)}</span><span class="lp-slug">${esc(a.slug)}</span>`;
        b.onmousedown = (e) => e.preventDefault();
        b.onclick = () => { lpTarget.value = a.slug; applyLink(); };
        list.append(b);
      }
      const slug = slugify(q);
      if (slug && !ARTICLES.some((a) => a.slug === slug)) {
        const b = el('button', 'lp-hit new');
        b.type = 'button';
        b.innerHTML = `<span class="lp-title">Link to a new article</span><span class="lp-slug">${esc(slug)} — shows red until it is written</span>`;
        b.onmousedown = (e) => e.preventDefault();
        b.onclick = () => { lpTarget.value = slug; applyLink(); };
        list.append(b);
      }
      if (!list.children.length) list.innerHTML = '<p class="lp-empty">Type a title, a slug, or a URL.</p>';
    }

    function applyLink() {
      const target = lpTarget.value.trim();
      if (!target) { lpTarget.focus(); return; }
      const external = /^https?:/i.test(target);
      const slug = external ? target : slugify(target);
      const text = lpText.value.trim() || (external ? target : displayOf(slug));
      const html = external
        ? `<a href="${esc(target)}">${esc(text)}</a>`
        : `<a href="#" data-slug="${esc(slug)}">${esc(text)}</a>`;
      if (editingAnchor) {
        editingAnchor.outerHTML = html;
      } else {
        const host = activeText();
        host?.focus();
        if (savedRange) putRange(savedRange);
        document.execCommand('insertHTML', false, html);
        unglue(ceOf(getSelection().anchorNode) || host);
      }
      closeLink();
      sync();
    }

    $('#lp-apply').onclick = applyLink;
    $('#lp-remove').onclick = () => {
      if (editingAnchor) editingAnchor.replaceWith(document.createTextNode(editingAnchor.textContent));
      closeLink();
      sync();
    };
    lpTarget.oninput = paintLinkResults;
    for (const input of [lpText, lpTarget]) {
      input.onkeydown = (e) => {
        if (e.key === 'Enter') { e.preventDefault(); applyLink(); }
        if (e.key === 'Escape') { e.preventDefault(); closeLink(); }
      };
    }
    pop.addEventListener('mousedown', (e) => e.stopPropagation());
    document.addEventListener('mousedown', (e) => { if (!pop.hidden && !pop.contains(e.target)) closeLink(); });

    function runCmd(cmd) {
      if (cmd === 'link') { openLink(); return; }
      document.execCommand(cmd);
      sync();
    }
    document.querySelectorAll('[data-cmd]').forEach((b) => b.onmousedown = (e) => {
      e.preventDefault();
      // Without this the same mousedown reaches the popover's outside-click closer.
      e.stopPropagation();
      runCmd(b.dataset.cmd);
    });
    addEventListener('keydown', (e) => {
      if (!(e.metaKey || e.ctrlKey)) return;
      if (e.shiftKey && (e.code === 'Digit8' || e.code === 'Digit7')) { e.preventDefault(); toggleList(e.code === 'Digit7'); return; }
      const k = e.key.toLowerCase();
      if (k === 'b' || k === 'i' || k === 'k') { e.preventDefault(); runCmd(k === 'k' ? 'link' : k === 'b' ? 'bold' : 'italic'); }
      if (k === 'z') { e.preventDefault(); (e.shiftKey ? $('#redo') : $('#undo')).click(); }
      if (k === 'y') { e.preventDefault(); $('#redo').click(); }
      if (k === 's' && DEV) { e.preventDefault(); $('#save').click(); }
    });

    // The canvas title is the real title field; the settings box is the same value.
    $('#canvas-title').addEventListener('input', (e) => {
      $('#f-title').value = $('#canvas-title').textContent.trim();
      if (!slugTouched) setSlug(slugify($('#f-title').value));
      sync(e);
    });
    $('#canvas-title').addEventListener('keydown', (e) => {
      if (e.key === 'Enter') { e.preventDefault(); body.querySelector('.ce')?.focus(); }
    });
    $('#canvas-title').addEventListener('paste', (e) => {
      e.preventDefault();
      document.execCommand('insertText', false, e.clipboardData.getData('text/plain'));
    });

    // The sidebar heading, edited at the top of the sidebar. The hidden inputs behind
    // these three are what the markdown, the draft and the slug are built from, so
    // everything downstream still reads one place.
    for (const [id, field, multi] of [
      ['#ib-title', '#f-boxtitle', false],
      ['#ib-native', '#f-native', true],
      ['#ib-romaji', '#f-romaji', true],
    ]) {
      const el = $(id);
      el.addEventListener('input', (e) => {
        const text = el.innerText.replace(/\u00a0/g, ' ');
        $(field).value = multi
          ? text.split('\n').map((l) => l.trim()).filter(Boolean).join('\n')
          : text.replace(/\s+/g, ' ').trim();
        sync(e);
      });
      el.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter') return;
        // A native title carries one line per official language, and its romanisation
        // a line to match, so shift ↵ opens another. The heading is a single line, and ↵ moves on.
        if (multi && e.shiftKey) return;
        e.preventDefault();
        if (!e.shiftKey) body.querySelector('.ce')?.focus();
      });
      el.addEventListener('paste', (e) => {
        e.preventDefault();
        const t = e.clipboardData.getData('text/plain');
        document.execCommand('insertText', false, multi ? t : t.replace(/\s*\n+\s*/g, ' '));
      });
    }

    $('#f-type').onchange = () => {
      if (ib.querySelector('tr[data-kind]') && !confirm('Replace the sidebar with this type’s template?')) return;
      setInfobox(TEMPLATES[$('#f-type').value] || []);
      sync();
    };
    /** Clear the desk and start a page of the given kind. */
    function blank(kind, slug = '') {
      keep();
      loadedFrom = BUILT_FROM;           // a page not on main yet: any copy of main will do
      pageKind = kind; navboxLead = ''; portalBody = ''; pageSlug = slug; loadedTitle = ''; loadedBody = '';
      movedFrom = [];
      $('#settings').querySelectorAll('input[type=text], input[type=hidden], textarea').forEach((i) => i.value = '');
      $('#f-ooc').checked = false;
      $('#f-navbox-on').checked = true;
      $('#f-sidebar-on').checked = true;
      $('#canvas-title').textContent = '';
      setSlug(slug); slugTouched = !!slug;
      setInfobox(kind === 'article' ? (TEMPLATES[$('#f-type').value] || []) : []);
      body.innerHTML = '';
      // A portal has no body at all; a navbox opens on its first heading.
      if (kind === 'article') body.append(block('para'));
      else if (kind === 'navbox') body.append(block('section'));
      // A portal or navbox is named after its nation, so the slug is the nation id.
      if (slug && kind !== 'article') {
        const opt = [...$('#f-nation').options].find((o) => o.value === slug);
        if (opt) {
          $('#f-nation').value = slug;
          $('#f-title').value = kind === 'portal' ? `Portal:${opt.textContent}` : `${opt.textContent} Articles`;
          if (kind === 'navbox') {
            $('#f-crumb').value = `[[portal:${slug}|Portal:${opt.textContent}]] • [[${slug}|Overview]]`;
          }
        }
      }
      paintSettings();
      resetHistory();
      sync();
      // A new page has a draft of its own once it is written in; a nation's portal or
      // navbox not made yet already has the address it will be filed under.
      draftKey = slug ? `${kind}:${slug}` : newKey();
      opened = toMarkdown();
      kept = { key: draftKey, markdown: opened };
    }

    // The page being left keeps its draft, so starting another throws nothing away.
    const NEW = { '#new': 'article', '#new-portal': 'portal', '#new-navbox': 'navbox' };
    for (const [id, kind] of Object.entries(NEW)) $(id).onclick = () => blank(kind);

    // The nation is what a portal or a navbox is filed under, so it names the file.
    $('#f-nation').addEventListener('change', () => {
      if (pageKind === 'article' || !DEV) return;
      const id = $('#f-nation').value;
      const name = $('#f-nation').selectedOptions[0]?.textContent || id;
      if (!id) return;
      pageSlug = id;
      setSlug(id);
      if (!$('#f-title').value.trim()) {
        $('#f-title').value = pageKind === 'portal' ? `Portal:${name}` : `${name} Articles`;
      }
      if (pageKind === 'navbox' && !$('#f-crumb').value.trim()) {
        $('#f-crumb').value = `[[portal:${id}|Portal:${name}]] • [[${id}|Overview]]`;
      }
      sync();
    });

    $('#go-navbox').onclick = () => {
      const id = $('#f-nation').value;
      if (id) location.href = `${BASE.replace(/\/$/, '')}/edit?a=navbox:${id}`;
    };
    $('#f-banner-pick').onclick = () => { $('#f-banner').focus(); openMedia(); };
    ['#f-type', '#f-nation', '#f-navbox-on', '#f-sidebar-on'].forEach((id) => {
      $(id).addEventListener('change', paintSettings);
    });
    $('#settings').addEventListener('input', (e) => { paintSettings(); sync(e); });
    $('#settings').addEventListener('change', sync);

    const saveAs = (blob, name) => {
      const a = el('a');
      a.href = URL.createObjectURL(blob);
      a.download = name;
      a.click();
      URL.revokeObjectURL(a.href);
    };
    async function downloadPage() {
      const stem = slugify(slugValue() || pageSlug || $('#f-title').value) || 'article';
      const md = toMarkdown();
      const used = [...staged.entries()].filter(([p]) => md.includes(p));
      if (!used.length) { saveAs(new Blob([md], { type: 'text/markdown' }), `${stem}.md`); return; }
      const entries = [{ name: `${stem}.md`, data: new TextEncoder().encode(md) }];
      for (const [path, s] of used) {
        entries.push({ name: path.replace(/^\//, ''), data: new Uint8Array(await s.file.arrayBuffer()) });
      }
      saveAs(zip(entries), `${stem}.zip`);
      flash(`Zipped with ${used.length} image${used.length === 1 ? '' : 's'}.`);
    }
    /* ---------- publish: a pull request, straight from the browser ----------
       api.github.com allows cross-origin calls, so the whole flow runs here with no
       server of any kind. A contributor without push access gets a fork first. */

    const GH = 'https://api.github.com';
    const TOKEN_KEY = 'talopedia-gh-token';
    const token = {
      get: () => { try { return localStorage.getItem(TOKEN_KEY) || ''; } catch { return ''; } },
      set: (v) => { try { v ? localStorage.setItem(TOKEN_KEY, v) : localStorage.removeItem(TOKEN_KEY); } catch {} },
    };

    async function gh(path, opts = {}) {
      const r = await fetch(path.startsWith('http') ? path : GH + path, {
        ...opts,
        headers: {
          accept: 'application/vnd.github+json',
          authorization: `Bearer ${token.get()}`,
          ...(opts.body ? { 'content-type': 'application/json' } : {}),
          ...opts.headers,
        },
      });
      const text = await r.text();
      const data = text ? JSON.parse(text) : {};
      if (!r.ok) {
        const where = path.replace(GH, '').split('?')[0];
        // GitHub's own wording says nothing about which permission is missing, and the
        // cause is nearly always one of two things, so name whichever it is.
        const msg = data.message || '';
        const why = /Bad credentials/i.test(msg)
          ? '. The token is wrong or has expired'
          : /not accessible|Not Found|Resource not accessible/i.test(msg)
          ? '. The token is missing the public_repo scope'
          : '';
        throw new Error(`${msg || r.statusText} (${opts.method || 'GET'} ${where})${why}.`);
      }
      return data;
    }

    /** base64 of a byte array, in chunks: spreading a whole file blows the call stack. */
    function b64(bytes) {
      let out = '';
      for (let i = 0; i < bytes.length; i += 0x8000) {
        out += String.fromCharCode.apply(null, bytes.subarray(i, i + 0x8000));
      }
      return btoa(out);
    }
    const b64text = (s) => b64(new TextEncoder().encode(s));

    /** Where this page belongs in the repository. */
    function targetPath(slug) {
      if (pageKind === 'portal') return `src/content/portals/${slug}.md`;
      if (pageKind === 'navbox') return `src/content/data/navboxes/${slug}.yaml`;
      return `src/content/articles/${slug}.md`;
    }

    const pubSay = (msg, bad = false) => {
      const el = $('#pub-status');
      el.textContent = msg;
      el.className = 'pub-status' + (bad ? ' bad' : '');
    };

    async function putFile(repo, branch, path, contentB64, message) {
      // An existing file needs the blob it replaces, or GitHub refuses the write.
      let sha;
      try {
        sha = (await gh(`/repos/${repo}/contents/${encodeURI(path)}?ref=${branch}`)).sha;
      } catch { /* new file */ }
      await gh(`/repos/${repo}/contents/${encodeURI(path)}`, {
        method: 'PUT',
        body: JSON.stringify({ message, content: contentB64, branch, ...(sha && { sha }) }),
      });
    }

    /* ---------- reading a file back in ----------
       The editor writes a narrow slice of YAML, so it can read that slice back without
       carrying a parser. Anything it did not write is not promised. */

    const unquote = (v) => {
      const t = String(v).trim();
      return /^".*"$/.test(t)
        ? t.slice(1, -1).replace(/\\"/g, '"').replace(/\\\\/g, '\\')
        : t;
    };

    /** `{ label: "x", sub: true, value: "y" }` as an object. */
    function inlineObj(text) {
      const out = {};
      for (const m of text.replace(/^\{|\}$/g, '').matchAll(/(\w+):\s*("(?:[^"\\]|\\.)*"|[^,}]+)/g)) {
        const v = unquote(m[2]);
        out[m[1]] = v === 'true' ? true : v === 'false' ? false : v;
      }
      return out;
    }

    const indent = (l) => l.length - l.trimStart().length;

    /** The frontmatter block, and the infobox rows inside it. */
    function readHead(lines) {
      const data = {}, rows = [];
      for (let i = 0; i < lines.length; i++) {
        const line = lines[i];
        if (!line.trim() || indent(line) > 0) continue;
        const m = line.match(/^(\w+):\s*(.*)$/);
        if (!m) continue;
        const [, key, rest] = m;
        if (key === 'infobox') {
          // Rows run until the indentation comes back to the left margin.
          let j = i + 1;
          const block = [];
          while (j < lines.length && (!lines[j].trim() || indent(lines[j]) > 0)) block.push(lines[j++]);
          i = j - 1;
          for (let k = 0; k < block.length; k++) {
            const l = block[k];
            if (!/^\s*- /.test(l)) continue;
            const body = l.replace(/^\s*- /, '');
            if (body.startsWith('{')) { rows.push(inlineObj(body)); continue; }
            if (/^images:/.test(body)) {
              const images = [];
              let joined = false;
              let k2 = k + 1;
              while (k2 < block.length && indent(block[k2]) > indent(l)) {
                const im = block[k2].match(/^\s*- (\{.*\})\s*$/);
                if (im) images.push(inlineObj(im[1]));
                if (/^\s*join:\s*true\s*$/.test(block[k2])) joined = true;
                k2++;
              }
              rows.push({ images, ...(joined && { join: true }) });
              k = k2 - 1;
              continue;
            }
            if (/^pair:/.test(body)) {
              const pair = [], nest = {};
              let k2 = k + 1;
              while (k2 < block.length && indent(block[k2]) > indent(l)) {
                // A side opens on its items, or on the heading a side carried before its
                // name became the bold first line of its list.
                const side = block[k2].match(/^\s*- (heading|items):\s*(.*)$/);
                if (side) pair.push(side[1] === 'heading' ? { heading: unquote(side[2]), items: [] } : { items: [] });
                const it = block[k2].match(/^\s*- (".*")\s*$/);
                if (it && pair.length) pair[pair.length - 1].items.push(unquote(it[1]));
                // How deep its lists may nest and whether their lines are drawn, under the row itself.
                const opt = block[k2].match(/^\s*(depth|guides):\s*(\S+)\s*$/);
                if (opt) nest[opt[1]] = opt[1] === 'depth' ? Number(opt[2]) : opt[2] === 'true';
                k2++;
              }
              rows.push({ pair, ...nest });
              k = k2 - 1;
              continue;
            }
            // `- label: "x"` with its own indented keys under it
            const row = {};
            const first = body.match(/^(\w+):\s*(.*)$/);
            if (!first) continue;
            let k2 = k + 1;
            const take = (key2, rest2) => {
              if (rest2) {
                row[key2] = rest2 === 'true' ? true : rest2 === 'false' ? false : rest2 === '[]' ? []
                  : key2 === 'depth' ? Number(rest2) : unquote(rest2);
                return;
              }
              const list = [];
              while (k2 < block.length && /^\s*- /.test(block[k2]) && indent(block[k2]) > indent(l)) {
                list.push(unquote(block[k2].replace(/^\s*- /, '')));
                k2++;
              }
              row[key2] = list;
            };
            take(first[1], first[2]);
            while (k2 < block.length && indent(block[k2]) > indent(l) && !/^\s*- /.test(block[k2])) {
              const nx = block[k2].match(/^\s*(\w+):\s*(.*)$/);
              k2++;
              if (nx) take(nx[1], nx[2]);
            }
            rows.push(row);
            k = k2 - 1;
          }
          continue;
        }
        if (rest) {
          data[key] = /^\[.*\]$/.test(rest)
            ? rest.slice(1, -1).split(',').map((x) => x.trim()).filter(Boolean)
            : unquote(rest);
        } else {
          const list = [];
          let j = i + 1;
          while (j < lines.length && /^\s*- /.test(lines[j])) list.push(unquote(lines[j++].replace(/^\s*- /, '')));
          data[key] = list;
          i = j - 1;
        }
      }
      return { data, rows };
    }

    /** A navbox file's groups, which the block editor draws as headings and lists. */
    function readGroups(lines) {
      const groups = [];
      let group = null, row = null;
      for (const line of lines) {
        const t = line.trim();
        if (!t || t === 'groups:' || t === 'rows:') continue;
        let m;
        if ((m = t.match(/^- label:\s*(.*)$/)) && indent(line) <= 2) {
          group = { label: unquote(m[1]), rows: [] }; groups.push(group); row = null;
        } else if ((m = t.match(/^- label:\s*(.*)$/))) {
          row = { label: unquote(m[1]), items: [] }; group?.rows.push(row);
        } else if ((m = t.match(/^- note:\s*(.*)$/))) {
          group?.rows.push({ note: unquote(m[1]) }); row = null;
        } else if ((m = t.match(/^dates:\s*(.*)$/)) && row) {
          row.dates = unquote(m[1]);
        } else if (t === '- items:') {
          row = { items: [] }; group?.rows.push(row);
        } else if (t === 'items:') {
          if (row) row.items = [];
        } else if ((m = t.match(/^- (.*)$/)) && row) {
          row.items.push(unquote(m[1]));
        }
      }
      return groups;
    }

    /** Put a whole stored file back on screen. */
    function fromMarkdown(text) {
      resetHistory();
      const src = String(text).replace(/\r\n/g, '\n');
      if (!src.startsWith('---')) {
        // No frontmatter means a navbox, which is YAML all the way down.
        const lines = src.split('\n');
        const { data } = readHead(lines.filter((l) => indent(l) === 0 && !/^groups:/.test(l)));
        pageKind = 'navbox';
        navboxLead = (src.match(/^(?:#[^\n]*\n)+/) || [''])[0];
        $('#f-title').value = data.title || '';
        $('#f-crumb').value = data.crumb || '';
        setInfobox([]);
        body.innerHTML = '';
        navboxBlocks(readGroups(lines)).forEach((b) => body.append(block(b.kind, b)));
        sync();
        return;
      }
      const end = src.indexOf('\n---', 3);
      const head = src.slice(4, end === -1 ? src.length : end).split('\n');
      const rest = end === -1 ? '' : src.slice(end + 4).replace(/^\n+/, '');
      const { data, rows } = readHead(head);

      pageKind = data.type ? 'article' : 'portal';
      portalBody = pageKind === 'portal' ? rest : '';
      $('#f-title').value = data.title || '';
      $('#f-boxtitle').value = data.sidebarTitle || '';
      $('#f-native').value = [].concat(data.nativeTitle ?? []).join('\n');
      $('#f-romaji').value = [].concat(data.romaji ?? []).join('\n');
      $('#f-type').value = data.type || 'overview';
      $('#f-nation').value = data.nation || '';
      $('#f-icon').value = data.icon || '';
      $('#f-banner').value = data.banner || '';
      $('#f-welcome').value = data.welcome || '';
      $('#f-crumb').value = '';
      $('#f-authors').value = [].concat(data.authors ?? []).join(', ');
      $('#f-navbox-on').checked = data.navbox !== 'none';
      $('#f-sidebar-on').checked = !!rows.length;
      $('#f-coords').value = data.coords || '';
      $('#f-ooc').checked = data.ooc === true || data.ooc === 'true';
      setInfobox(rows);
      body.innerHTML = '';
      if (pageKind !== 'portal') parseBody(rest).forEach((b) => body.append(block(b.kind, b)));
      if (!body.children.length && pageKind === 'article') body.append(block('para'));
      sync();
    }

    if ($('#open-file')) {
      $('#open-file').onclick = () => $('#open-file-input').click();
      $('#duplicate').onclick = duplicate;
      $('#open-file-input').onchange = async (e) => {
        const f = e.target.files[0];
        e.target.value = '';
        if (!f) return;
        try {
          const text = await f.text();
          keep();
          fromMarkdown(text);
          pageSlug = f.name.replace(/\.(md|markdown|ya?ml)$/i, '');
          loadedFrom = '';               // a file from disk says nothing of which copy it was
          loadedTitle = $('#f-title').value.trim();
          setSlug(pageSlug); slugTouched = true;
          sync();
          draftKey = newKey();
          opened = toMarkdown();
          kept = { key: draftKey, markdown: opened };
          flash(`Opened ${f.name}.`);
        } catch (err) {
          flash(`Could not read ${f.name}: ${err.message}`, true);
        }
      };
    }

    /* ---------- the changes waiting to go ----------
       Kept in IndexedDB rather than localStorage: a change carries the image files
       that go with it, and those are Blobs, which localStorage cannot hold. */

    /** One IndexedDB store of records keyed by `key`, in a database of its own. Declared
        rather than assigned: the drafts, further up the file, are kept in one too. */
    function shelf(name, storeName) {
      let dbp = null;
      const db = () => (dbp ??= new Promise((res, rej) => {
        const r = indexedDB.open(name, 1);
        r.onupgradeneeded = () => r.result.createObjectStore(storeName, { keyPath: 'key' });
        r.onsuccess = () => res(r.result);
        r.onerror = () => rej(r.error);
      }));
      const store = async (mode, run) => {
        const tx = (await db()).transaction(storeName, mode);
        const req = run(tx.objectStore(storeName));
        return new Promise((res, rej) => {
          tx.oncomplete = () => res(req.result);
          tx.onerror = () => rej(tx.error);
        });
      };
      return {
        all: () => store('readonly', (s) => s.getAll()),
        put: (v) => store('readwrite', (s) => s.put(v)),
        drop: (k) => store('readwrite', (s) => s.delete(k)),
        clear: () => store('readwrite', (s) => s.clear()),
      };
    }

    /** This page as a change: the file it writes, and the pictures it brings with it. */
/**
 * The line that goes into the commit and so into the page's history. Every commit the
 * editor made before this field existed says the same thing, which made the log
 * useless for review.
 */
    const commitMsg = (slug, summary, from) => `${slug}: ${summary || 'edit from the wiki editor'}`
      + (from ? `\n\nBased-on: ${from}` : '');

    /** How a page is named in the index: bare for an article, prefixed for the rest.
        Declared rather than assigned: it is called from further up the file. */
    function indexKey(kind, slug) { return kind === 'article' ? slug : `${kind}:${slug}`; }

    /**
     * The first page in a push that the workflow will not merge on its own, if there
     * is one, so the writer is told what actually happens rather than a hopeful guess.
     * The rule lives in .github/gate.mjs; this is the sentence of it that decides the
     * ordinary case, which is that a nation is editing a page credited to it alone.
     */
    function heldBack(changes, login) {
      if (login === ADMIN) return null;
      const mine = NATION_OF[login];
      for (const c of changes) {
        const held = ARTICLES.find((a) => a.slug === indexKey(c.kind, c.slug));
        // A page not on the site yet is the writer's when it credits their own nation,
        // which is the same test the gate puts it to.
        const by = held ? held.by : creditIn(c.markdown || '', c.kind, c.slug);
        // ...and one not on the site yet with no nation on it at all is theirs too: it
        // lands credited to their nation, which the merge writes in.
        if (!held && !by.length && mine && c.kind === 'article') continue;
        if (!mine || by.length !== 1 || by[0] !== mine) return { title: held?.title || c.title || c.slug, by };
      }
      return null;
    }

    /** Who a page's own text credits: the byline, as .github/gate.mjs reads it. */
    function creditIn(md, kind, slug) {
      if (kind === 'navbox') return slug === 'site' ? [] : [slug];
      const head = md.startsWith('---') ? md.slice(3, md.indexOf('\n---', 3)) : '';
      const clean = (x) => x.trim().replace(/^["']|["']$/g, '');
      const list = head.match(/^authors:[ \t]*\[([^\]]*)\]/m);
      if (list) return list[1].split(',').map(clean).filter(Boolean);
      const one = head.match(/^nation:[ \t]*(\S.*)$/m);
      return one ? [clean(one[1])] : [];
    }

    /** What to tell the writer once the pull request is open. */
    function sentWord(changes, login) {
      const held = heldBack(changes, login);
      if (!held) return 'Your edit is on its way.';
      const who = held.by.map((n) => NATION_NAMES[n] || n).join(' and ');
      return `Sent. ${held.title} is credited to ${who || 'nobody'}, so it waits for a look.`;
    }

    /* ---------- sending them ---------- */

    /**
     * Send these changes as one pull request. A moved page goes to its new address, its
     * old file goes, and every page linking to it is rewritten to the new address: the
     * ones in this batch in their own text, the rest read off the branch.
     */
    async function publishAll(list) {
      if (!list.length) { pubSay('Nothing ticked.', true); return; }

      $('#pub-go').disabled = true;
      try {
        pubSay('Checking the token…');
        const me = await gh('/user');
        try { localStorage.setItem(LOGIN_KEY, me.login); } catch {}
        const base = await gh(`/repos/${REPO}`);
        const canPush = !!base.permissions?.push;
        const mine = (base.owner?.login || '').toLowerCase() === (me.login || '').toLowerCase();

        let work = REPO;
        if (!canPush) {
          if (mine) {
            throw new Error(`This token cannot write to ${REPO}, which you own. `
              + 'It needs the public_repo scope.');
          }
          pubSay(`Forking ${REPO}…`);
          await gh(`/repos/${REPO}/forks`, { method: 'POST' });
          work = `${me.login}/${base.name}`;
          for (let i = 0; i < 20; i++) {
            try { await gh(`/repos/${work}`); break; }
            catch { await new Promise((r) => setTimeout(r, 1500)); }
          }
          // An old fork still sits where it was left, so bring it level first.
          try {
            await gh(`/repos/${work}/merge-upstream`, {
              method: 'POST', body: JSON.stringify({ branch: base.default_branch }),
            });
          } catch {
            // GitHub refuses whenever main has changed a workflow file, which this token
            // may not touch, so a fork can sit days behind. The branch then starts from
            // that old copy; the Based-on line on each commit is what lets it merge.
          }
        }

        const main = base.default_branch;
        const tip = await gh(`/repos/${work}/git/ref/heads/${main}`);
        const branch = `talopedia/${list.length > 1 ? 'batch' : list[0].slug}-${Date.now().toString(36)}`;
        pubSay('Making a branch…');
        await gh(`/repos/${work}/git/refs`, {
          method: 'POST',
          body: JSON.stringify({ ref: `refs/heads/${branch}`, sha: tip.object.sha }),
        });

        const moves = list.filter((c) => c.moved);
        for (const m of moves) for (const c of list) c.markdown = relink(c.markdown, c.kind, m.moved, m.slug);

        let done = 0;
        for (const c of list) {
          pubSay(`Committing ${++done} of ${list.length}: ${c.title}…`);
          await putFile(work, branch, c.path, b64text(c.markdown), commitMsg(c.slug, c.summary, c.from));
          if (c.moved) {
            await deleteFile(work, branch, pathFor('article', c.moved), commitMsg(c.slug, `moved from ${c.moved}`, c.from));
          }
          for (const im of c.images) {
            const bytes = new Uint8Array(await im.file.arrayBuffer());
            await putFile(work, branch, 'public' + im.path, b64(bytes),
              `${c.slug}: add ${im.path.split('/').pop()}`);
          }
        }

        if (moves.length) {
          const into = await linksIndex();
          const sending = new Set(list.map((c) => c.path));
          const pages = new Map();
          for (const m of moves) {
            for (const key of into[m.moved] || []) {
              const path = keyPath(key);
              if (sending.has(path) || moves.some((x) => pathFor('article', x.moved) === path)) continue;
              if (!pages.has(path)) {
                pubSay(`Reading ${path.split('/').pop()}…`);
                const f = await gh(`/repos/${work}/contents/${encodeURI(path)}?ref=${branch}`).catch(() => null);
                if (!f) continue;
                const text = new TextDecoder().decode(Uint8Array.from(atob(f.content.replace(/\n/g, '')), (ch) => ch.charCodeAt(0)));
                pages.set(path, { key, was: text, text });
              }
              const p = pages.get(path);
              p.text = relink(p.text, key.startsWith('navbox:') ? 'navbox' : 'article', m.moved, m.slug);
            }
          }
          for (const [path, p] of pages) {
            if (p.text === p.was) continue;
            pubSay(`Relinking ${path.split('/').pop()}…`);
            const name = p.key.replace(/^(portal|navbox):/, '');
            await putFile(work, branch, path, b64text(p.text),
              commitMsg(name, `links to ${moves.map((m) => m.slug).join(', ')}`, tip.object.sha));
          }
        }

        pubSay('Opening the pull request…');
        const lines = list.map((c) => `- \`${c.path}\`${c.moved ? ` (moved from \`${pathFor('article', c.moved)}\`)` : ''}`).join('\n');
        const pr = await gh(`/repos/${REPO}/pulls`, {
          method: 'POST',
          body: JSON.stringify({
            title: list.length === 1 ? list[0].title : `${list.length} pages from the wiki editor`,
            head: canPush ? branch : `${me.login}:${branch}`,
            base: main,
            body: `Written in the wiki editor by @${me.login}.\n\n${lines}\n`,
          }),
        });
        saveSent([{ n: pr.number, url: pr.html_url, title: pr.title, at: Date.now() }, ...sentList()]);

        // What went is in the pull request now, so its drafts go.
        for (const c of list) { await drafts.drop(c.key).catch(() => {}); notes.drop(c.key); }
        if (list.some((c) => c.key === draftKey)) {
          opened = toMarkdown(); kept = { key: draftKey, markdown: opened };
          if (slugValue() !== pageSlug) { pageSlug = slugify(slugValue()); }
        }
        pubSay('');
        flash(sentWord(list, me.login));
        await paintPublish();
        paintPending();
      } catch (e) {
        pubSay(String(e.message || e), true);
      } finally {
        $('#pub-go').disabled = false;
      }
    }

    async function deleteFile(repo, branch, path, message) {
      let sha;
      try { sha = (await gh(`/repos/${repo}/contents/${encodeURI(path)}?ref=${branch}`)).sha; } catch { return; }
      await gh(`/repos/${repo}/contents/${encodeURI(path)}`, {
        method: 'DELETE', body: JSON.stringify({ message, sha, branch }),
      });
    }

    /**
     * A page's text with every link to `old` pointed at `now`: [[links]] and :icon[]
     * tokens anywhere, and a navbox's bare entries. A bare nation id in a navbox names
     * the nation rather than its article, and is left.
     */
    function relink(text, kind, old, now) {
      const o = old.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      let t = text.replace(new RegExp(`\\[\\[${o}(?=[\\]|#])`, 'g'), `[[${now}`)
        .replace(new RegExp(`:icon\\[${o}\\]`, 'g'), `:icon[${now}]`);
      if (kind === 'navbox' && !NATION_NAMES[old]) {
        t = t.replace(new RegExp(`(^\\s*-\\s*["']?|[\\[,]\\s*["']?|^\\s+["']?)${o}(?=(?:\\|[^"'\\],\\n]*)?["']?\\s*(?:,|\\]|$))`, 'gm'), `$1${now}`);
      }
      return t;
    }

    /* ---------- publishing ----------
       Every page with unsent edits is a change. Publish lists them: each can be left
       out, opened, or reset to the site's copy, and carries a line for its history. */
    const LOGIN_KEY = 'talopedia-gh-login', SENT_KEY = 'talopedia-sent', NOTES_KEY = 'talopedia-notes';
    const store = (k, fallback) => ({
      get: () => { try { return JSON.parse(localStorage.getItem(k) || 'null') ?? fallback; } catch { return fallback; } },
      set: (v) => { try { localStorage.setItem(k, JSON.stringify(v)); } catch {} },
    });
    const sentStore = store(SENT_KEY, []);
    const sentList = () => sentStore.get();
    const saveSent = (l) => sentStore.set(l.slice(0, 20));
    /** Each change's line for the history, and whether it is left out, by draft. */
    const notesStore = store(NOTES_KEY, {});
    const notes = {
      of: (k) => notesStore.get()[k] || {},
      set: (k, v) => { const all = notesStore.get(); all[k] = { ...all[k], ...v }; notesStore.set(all); },
      drop: (k) => { const all = notesStore.get(); delete all[k]; notesStore.set(all); },
    };
    const pathFor = (kind, slug) => (kind === 'portal' ? `src/content/portals/${slug}.md`
      : kind === 'navbox' ? `src/content/data/navboxes/${slug}.yaml` : `src/content/articles/${slug}.md`);
    const keyPath = (key) => (key.startsWith('portal:') ? pathFor('portal', key.slice(7))
      : key.startsWith('navbox:') ? pathFor('navbox', key.slice(7)) : pathFor('article', key));
    let linksCache = null;
    const linksIndex = () => (linksCache ||= fetch(`${BASE.replace(/\/$/, '')}/links.json`)
      .then((r) => r.json()).catch(() => ({})));

    /** A draft as the change it makes. */
    function changeOf(d) {
      const slug = slugify(d.slug || d.file || d.title || '');
      const moved = d.kind === 'article' && d.file && slug && slug !== d.file && onSiteKey('article', d.file) ? d.file : null;
      const n = notes.of(d.key);
      return {
        key: d.key, kind: d.kind, slug, title: d.title || slug, summary: n.summary || '', skip: !!n.skip,
        path: pathFor(d.kind, slug), from: d.snap?.from || '', markdown: d.markdown,
        images: d.images || [], moved, file: d.file || '',
      };
    }
    /** What stops a change going: the address another page has, or a page written over. */
    function problem(c, d) {
      if (!c.slug) return 'No title';
      const held = ARTICLES.find((a) => a.slug === indexKey(c.kind, c.slug));
      if (held && c.slug !== c.file && held.title !== c.title) return `/${c.slug} is ${held.title}`;
      if (c.file === c.slug && d.loadedTitle && c.title !== d.loadedTitle
          && wordsKept(d.loadedBody, d.markdown) < 0.35) return `Replaces ${d.loadedTitle}`;
      return null;
    }
    function wordsKept(was, now) {
      const words = (t) => new Set(String(t).toLowerCase().split(/[^a-z0-9À-￿]+/).filter((w) => w.length > 3));
      const a = words(was);
      if (a.size < 20) return 1;
      const b = words(now);
      let hit = 0;
      for (const w of a) if (b.has(w)) hit++;
      return hit / a.size;
    }
    /** Words in and out, against the page as it was opened. */
    function wordDiff(was, now) {
      const count = (t) => { const m = new Map(); for (const w of String(t).split(/\s+/).filter(Boolean)) m.set(w, (m.get(w) || 0) + 1); return m; };
      const a = count(was), b = count(now);
      let add = 0, del = 0;
      for (const [w, n] of b) add += Math.max(0, n - (a.get(w) || 0));
      for (const [w, n] of a) del += Math.max(0, n - (b.get(w) || 0));
      return [add, del];
    }
    /** Whether the gate holds this change: the page is not the writer's alone, or a move
        rewrites links on pages that are not. */
    async function held(c, login) {
      if (!login || login === ADMIN) return false;
      if (heldBack([c], login)) return true;
      if (!c.moved) return false;
      const mine = NATION_OF[login];
      const into = await linksIndex();
      return (into[c.moved] || []).some((k) => {
        const by = k.startsWith('navbox:') ? (k === 'navbox:site' ? [] : [k.slice(7)])
          : ARTICLES.find((a) => a.slug === k)?.by || [];
        return by.length !== 1 || by[0] !== mine;
      });
    }

    async function paintPending() {
      const all = await drafts.all().catch(() => []);
      $('#pub-n').textContent = all.length;
      $('#pub-n').hidden = !all.length;
      $('#draft-state').hidden = !all.some((d) => d.key === draftKey);
    }

    async function paintPublish() {
      await keep();
      const all = (await drafts.all().catch(() => [])).sort((a, b) => b.at - a.at);
      const login = (() => { try { return localStorage.getItem(LOGIN_KEY) || ''; } catch { return ''; } })();
      const box = $('#pub-list');
      box.replaceChildren();
      $('#pub-empty').hidden = !!all.length;
      for (const d of all) {
        const c = changeOf(d);
        const bad = problem(c, d);
        const row = el('div', 'pr-row' + (bad ? ' bad' : ''));
        const tick = el('input');
        tick.type = 'checkbox';
        tick.checked = !bad && !c.skip;
        tick.disabled = !!bad;
        tick.onchange = () => { notes.set(d.key, { skip: !tick.checked }); paintGo(); };
        const main = el('div', 'pr-main');
        const top = el('div', 'pr-top');
        top.append(el('b', null, c.title));
        if (bad) top.append(el('span', 'pr-tag bad', bad));
        else if (login) {
          const tag = el('span', 'pr-tag');
          top.append(tag);
          held(c, login).then((h) => { tag.textContent = h ? 'Review' : 'Live'; tag.classList.add(h ? 'review' : 'live'); });
        }
        const [add, del] = wordDiff(d.opened || '', d.markdown);
        const delta = el('span', 'pr-delta');
        delta.append(el('span', 'pr-add', `+${add}`), el('span', 'pr-del', `−${del}`));
        const meta = el('div', 'pr-meta');
        if (c.moved) meta.append(el('span', null, `/${c.moved}`), el('span', 'pr-arrow', '→'), el('span', 'pr-to', `/${c.slug}`));
        else meta.append(el('span', null, `/${c.kind === 'portal' ? 'portal/' : ''}${c.slug}`));
        const note = el('input', 'pr-note');
        note.placeholder = 'What changed?';
        note.value = c.summary;
        note.oninput = () => notes.set(d.key, { summary: note.value });
        main.append(top, meta, note);
        const acts = el('div', 'pr-acts');
        const open = el('button', 'pub-ico');
        open.innerHTML = '<svg viewBox="0 0 16 16"><path d="M9.5 2.5h4v4M13.5 2.5 8 8M11.5 9.5v4h-9v-9h4"/></svg>';
        open.title = 'Open';
        open.type = 'button';
        open.onclick = async () => {
          $('#pub-panel').hidden = true;
          if (d.key === draftKey) return;
          await keep();
          const now = (await drafts.all().catch(() => [])).find((x) => x.key === d.key);
          if (now) reopen(now);
        };
        const reset = el('button', 'pub-ico');
        reset.innerHTML = '<svg viewBox="0 0 16 16"><path d="M3 8a5 5 0 1 0 1.6-3.7"/><path d="M4.4 1.8v2.8h2.8"/></svg>';
        reset.title = 'Reset';
        reset.type = 'button';
        reset.onclick = async () => {
          if (!confirm(`Reset ${c.title}?`)) return;
          await resetDraft(d);
          paintPublish();
        };
        acts.append(delta, open, reset);
        row.append(tick, main, acts);
        box.append(row);
      }
      paintGo();
      paintSent();
    }
    function paintGo() {
      const n = [...$('#pub-list').querySelectorAll('input[type=checkbox]')].filter((t) => t.checked).length;
      $('#pub-go').textContent = n ? `Publish ${n}` : 'Publish';
