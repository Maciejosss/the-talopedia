    /**
     * Up or down a line inside the box, as the arrow keys move; false when the caret is
     * already on its first or last line. On a Mac, Up on the first line runs the caret to
     * the start of it rather than refusing, so a move counts only if the line changed.
     */
    function lineWithin(box, back) {
