      max-width: min(560px, calc(100vw - 32px)); overflow: hidden; text-overflow: ellipsis;
      font-size: 13px; color: var(--ink); padding: 9px 16px; white-space: nowrap;
      background: var(--lift); border: 1px solid var(--rule); border-radius: 9px; box-shadow: 0 8px 24px rgb(0 0 0 / .5);
    }
    .ed-tools .status:empty { display: none; }
    .ed-tools .status.good { color: var(--ink); }
    .ed-tools .status.bad { color: var(--link-new); }

    .drop { position: relative; }
    .drop-menu {
      position: absolute; top: calc(100% + 8px); left: 0; z-index: 30; min-width: 200px;
      display: flex; flex-direction: column; padding: 5px;
      background: var(--lift); border: 1px solid var(--rule); border-radius: 8px;
      box-shadow: 0 10px 28px rgb(0 0 0 / .55);
    }
    .drop-menu.right { left: auto; right: 0; }
    .drop-menu[hidden] { display: none; }
    /* A title too long for one line wraps, so the row grows and the text stays left:
       a button centres its text by default and a fixed height would clip the second line. */
    .drop-menu.list button, .ctl-menu button {
      justify-content: flex-start; text-align: left; width: 100%;
      padding: 6px 10px; height: auto; min-height: 32px; line-height: 1.35;
    }

    .drop-menu .menu-sep { height: 1px; background: var(--rule); margin: 5px 0; }
    .drop-menu input[type=search] {
      height: 30px; margin: 0 0 6px; font: 12.5px var(--body); padding: 0 8px;
      color: var(--ink); background: var(--paper); border: 1px solid var(--rule); border-radius: 6px;
    }
    .drop-menu input[type=search]:focus { outline: none; border-color: var(--link); }
    .menu-list { max-height: 260px; overflow-y: auto; display: flex; flex-direction: column; }
    /* A draft: its page, when it was last written, and a cross to throw it away. */
    .draft-row { display: flex; align-items: center; gap: 2px; }
    .drop-menu.list .draft-row > button:first-child {
      flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 1px;
    }
    .draft-row small { font-size: 11px; color: var(--muted); }
    .drop-menu.list .draft-x { flex: none; width: 30px; padding: 0; justify-content: center; color: var(--muted); }
    .drop-menu.list .draft-x:hover { color: var(--ink); }

    /* ---- layout ---- */
    .ed-main { display: flex; align-items: flex-start; gap: 20px; padding: 0 24px; min-width: 0; }
    .ed-rail {
      flex: none; width: 210px; font-size: 13.5px;
      position: sticky; top: calc(var(--mast) + 74px);
      max-height: calc(100vh - var(--mast) - 96px); overflow-y: auto;
      padding-top: 16px;
    }
    .ed-rail .toc-head { margin-bottom: 8px; }
    .ed-rail .toc-head b { font-size: 15px; }
    .ed-rail .toc-list a { cursor: pointer; }

    /* ---- media picker ---- */
    .drop-menu.wide { width: 452px; padding: 0; overflow: hidden; }
    .mp-tabs { display: flex; border-bottom: 1px solid var(--rule); }
    .mp-tabs button {
      flex: 1; height: 40px; font: 13px var(--body); color: var(--muted);
      background: none; border: 0; border-bottom: 2px solid transparent; cursor: pointer;
      border-radius: 0; justify-content: center;
    }
    .mp-tabs button:hover { color: var(--ink); background: var(--band); }
    .mp-tabs button.on { color: var(--ink); border-bottom-color: var(--link); }
    #mp-iq {
      display: block; box-sizing: border-box; width: 100%; height: 32px;
      margin: 14px 0 8px; padding: 0 10px; font: 13px var(--body);
      color: var(--ink); background: var(--paper); border: 1px solid var(--rule); border-radius: 6px;
    }
    #mp-iq:focus { outline: none; border-color: var(--link); }
    /* One gutter for the whole pane, so nothing sits proud of the panel edge. */
    .mp-pane { padding: 0 16px; }
    .mp-pane.over { box-shadow: inset 0 0 0 2px var(--link); }
    /* How it goes in, then where it comes from: the options above a rule, the link and
       its Insert button under it, as the last thing to do. */
    .mp-opts { display: grid; gap: 12px; padding: 16px 0 14px; }
    .mp-src { border-top: 1px solid var(--rule); padding: 14px 0 16px; }
    .mp-row { display: flex; align-items: flex-start; gap: 12px; }
    .mp-row[hidden] { display: none; }
    .mp-col { display: grid; gap: 6px; min-width: 0; }
    .mp-lbl {
      flex: none; width: 72px; line-height: 28px; white-space: nowrap;
      font: 12px/28px var(--body); color: var(--muted);
    }
    .mp-desc { margin: 0; font: 11.5px var(--body); color: var(--muted); }
    /* A segmented control is one bordered strip; a hidden option leaves no gap in it. */
    .mp-seg { display: inline-flex; border: 1px solid var(--rule); border-radius: 6px; overflow: hidden; }
    .mp-seg button {
      display: inline-flex; align-items: center; gap: 6px; height: 28px; padding: 0 11px;
      font: 12px var(--body); color: var(--muted); background: transparent; border: 0; cursor: pointer;
    }
    .mp-seg button + button { border-left: 1px solid var(--rule); }
    .mp-seg button[hidden] { display: none; }
    .mp-seg button:hover { color: var(--ink); background: var(--band); }
    .mp-seg button.on { color: var(--ink); background: color-mix(in srgb, var(--link) 22%, transparent); }
    .mp-pic { width: 18px; height: 13px; fill: none; stroke: currentColor; stroke-width: 1.4; flex: none; }
    .mp-link-row { display: flex; gap: 8px; }
    .mp-link-row input {
      flex: 1; min-width: 0; height: 32px; box-sizing: border-box; font: 13px var(--body); padding: 0 10px;
      color: var(--ink); background: var(--paper); border: 1px solid var(--rule); border-radius: 6px;
    }
    .mp-link-row input:focus { outline: none; border-color: var(--link); }
    .mp-link-row button { flex: none; height: 32px; padding: 0 16px; border-radius: 6px; font: 13px var(--body); }
    .mp-hint { margin: 7px 0 0; font: 11.5px var(--body); color: var(--muted); }
    .mp-hint:empty { display: none; }
    .mp-upload { display: flex; align-items: center; gap: 10px; margin-top: 12px; }
    .mp-or { font: 11.5px var(--body); color: var(--muted); }
    .mp-hint.ok { color: #7fae8a; }
    .mp-hint.bad { color: #d08a8a; }
    /* The editor shows a chosen shape the same way the article does. */
    .blk figure[class*="r-"] img { width: 100%; height: 100%; object-fit: cover; }
    .blk .r-16x9 img { aspect-ratio: 16 / 9; }
    .blk .r-3x2  img { aspect-ratio: 3 / 2; }
    .blk .r-4x3  img { aspect-ratio: 4 / 3; }
    .blk .r-1x1  img { aspect-ratio: 1 / 1; }
    .blk .r-3x4  img { aspect-ratio: 3 / 4; }
    .mp-file-btn {
      height: 30px; font: 12.5px var(--body); color: var(--ink); background: var(--band);
      border: 1px solid var(--rule); border-radius: 6px; padding: 0 12px; cursor: pointer;
    }
    .mp-file-btn:hover { background: var(--hair); }
    .mp-body { max-height: min(380px, 50vh); overflow-y: auto; margin: 0 -16px; padding: 0 16px 10px; }
    .mp-body[hidden] { display: none; }
    /* Each group under a rule, its name and count pinned while its rows scroll past. */
    .mp-group {
      position: sticky; top: 0; z-index: 1; display: flex; justify-content: space-between; align-items: baseline;
      margin: 8px -16px 4px; padding: 8px 22px 6px; background: var(--lift);
      border-top: 1px solid var(--rule); border-bottom: 1px solid var(--hair);
      font: 600 11px var(--body); color: var(--muted); letter-spacing: .05em; text-transform: uppercase;
    }
    .mp-group:first-child { margin-top: 0; border-top: 0; }
    .mp-n { font-weight: 400; letter-spacing: 0; font-variant-numeric: tabular-nums; }
    .mp-icon {
      display: flex; align-items: center; gap: 10px; width: 100%; padding: 6px 6px; height: auto;
      background: none; border: 0; border-radius: 6px; cursor: pointer; text-align: left;
    }
    .mp-icon img { width: 22px; height: 15px; object-fit: contain; flex: none; }
    .mp-icon .tok.arrow { width: 22px; flex: none; text-align: center; margin: 0; font-size: 13px; }
    .mp-icon span { font-size: 12.5px; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .mp-icon:hover { background: var(--band); }
    .mp-empty { font-size: 12px; color: var(--muted); padding: 10px 2px; margin: 0; }
    .ed-canvas.drop { outline: 2px dashed var(--link); outline-offset: -10px; border-radius: 10px; }

    /* ---- settings strip ---- */
    /* The panel is a plain stack: a grid of fields, then the switches under a rule.
       It used to be a three-column grid holding those two as its children, which
       squeezed every field into the first third and left the rest of the strip bare. */
    .ed-settings {
      margin: 0 24px 14px; padding: 16px 20px 18px;
      background: var(--lift); border: 1px solid var(--rule); border-radius: 9px;
    }
    /* Any author rule that sets `display` beats the browser's own [hidden] rule, which
       is why hidden settings fields kept showing. One line covers every case rather
       than chasing each selector that happens to set a display. */
    .ed [hidden], .ed-settings[hidden] { display: none !important; }
    /* A block, not a column flex: the name, its asterisk and its "optional" are one
       inline line that way, instead of each landing on a line of its own. */
    .ed-settings label { display: block; font: 500 12px/1.4 var(--body); color: var(--ink); }
    .ed-settings label > input, .ed-settings label > select,
    .ed-settings label > textarea, .ed-settings label > .f-with-btn {
      display: block; width: 100%; margin-top: 5px;
    }
    .ed-settings label > .f-with-btn { display: flex; }
    .ed-settings input, .ed-settings select, .ed-settings textarea {
      box-sizing: border-box; font: 13.5px var(--body); padding: 7px 9px; color: var(--ink);
      background: var(--paper); border: 1px solid var(--rule); border-radius: 5px;
    }
    .ed-settings input:focus, .ed-settings select:focus, .ed-settings textarea:focus {
      outline: none; border-color: var(--link);
    }
    .ed-settings input::placeholder, .ed-settings textarea::placeholder { color: #5c656e; }
    /* A byline that is settled. Readable, plainly not typeable. The attribute rather
       than :read-only, which also matches every checkbox. */
    .ed-settings input[readonly], .ed-settings select:disabled {
      color: var(--muted); background: var(--band); cursor: default;
    }
    /* One row that matches an input exactly, and still pulls open for a second
       official language. The taller line box was what made it stand proud. */
    .ed-settings textarea { resize: vertical; line-height: normal; min-height: 0; }
    .ed-settings .check {
      display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 400;
      color: var(--ink); cursor: pointer;
    }
    .ed-settings .check input { width: auto; margin: 0; }

    /* ---- canvas ---- */
    .ed-canvas { flex: 1; min-width: 0; max-width: 1020px; padding: 14px 8px 60px 104px; }
    /* The title, and at the far end of its line the page's details, folded away. */
    .title-row {
      display: flex; align-items: baseline; gap: 16px; margin: 0 0 8px;
      padding-bottom: 10px; border-bottom: 1px solid var(--rule);
    }
    #canvas-title { flex: 1; min-width: 0; font: 400 32px/1.25 var(--display); margin: 0; outline: none; }
    .canvas-sub { font-size: 13px; color: var(--muted); min-height: 1.3em; margin-bottom: 16px; }
    .canvas-sub[hidden] { display: none; }

    /* ---- the page's details, under its title ----
       Values read as text and turn into controls under the pointer, so the block is a
       record of the page rather than a form standing over it. */
    .page-props {
      display: grid; grid-template-columns: 104px minmax(0, 1fr); gap: 2px 12px; align-items: center;
      margin: 6px 0 22px; padding-bottom: 14px; border-bottom: 1px solid var(--hair); font-size: 13px;
    }
    .page-props .pp-row { display: contents; }
    .page-props .pp-row[hidden], .page-props.closed .pp-row { display: none; }
    .page-props.closed { display: none; }
    .pp-toggle {
      flex: none; display: inline-flex; align-items: center; gap: 5px; height: 28px; padding: 0 8px 0 10px;
      font: 600 11px var(--body); letter-spacing: .05em; text-transform: uppercase; color: var(--muted);
      background: none; border: 0; border-radius: 6px; cursor: pointer;
    }
    .pp-toggle:hover, .pp-toggle[aria-expanded="true"] { color: var(--ink); background: var(--band); }
    .pp-toggle svg { width: 13px; height: 13px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; transition: transform .12s; }
    .pp-toggle[aria-expanded="true"] svg { transform: rotate(180deg); }
    .pp-k { color: var(--muted); font-size: 12.5px; line-height: 30px; }
    .pp-v { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; min-width: 0; min-height: 30px; }
    .page-props input[type=text], .page-props select {
      height: 28px; box-sizing: border-box; padding: 0 8px; margin-left: -8px;
      font: 13px var(--body); color: var(--ink); background-color: transparent;
      border: 1px solid transparent; border-radius: 6px; transition: background-color .1s, border-color .1s;
    }
    .page-props input[type=text] { width: min(360px, 100%); }
    .page-props select {
      justify-self: start; width: auto; max-width: 100%; appearance: none; -webkit-appearance: none; padding-right: 24px; cursor: pointer;
      background-image: linear-gradient(45deg, transparent 50%, var(--muted) 50%), linear-gradient(135deg, var(--muted) 50%, transparent 50%);
      background-position: right 12px top 12px, right 8px top 12px; background-size: 4px 4px; background-repeat: no-repeat;
    }
    .page-props select option { background: var(--lift); }
    .page-props input[type=text]:hover, .page-props select:hover { background-color: var(--band); }
    .page-props input:focus, .page-props select:focus { outline: none; background-color: var(--paper); border-color: var(--link); }
    .page-props input::placeholder { color: #5c656e; }
    .page-props select:disabled { opacity: 1; cursor: default; background-image: none; }
    .page-props select:disabled:hover { background-color: transparent; }
    .page-props > .pp-row > input[type=text] { justify-self: start; }
    .pp-url { gap: 0; }
    .pp-base { color: var(--muted); }
    .page-props .pp-url input[type=text] { margin-left: 0; padding-left: 1px; }
    .pp-slug { color: var(--ink); }
    .pp-was { color: var(--muted); margin-left: 10px; font-size: 12px; }
    .pp-was:empty { display: none; }
    .page-props .pp-btn {
      height: 26px; padding: 0 8px; margin-left: 8px; font: 12.5px var(--body); color: var(--link);
      background: none; border: 0; border-radius: 6px; cursor: pointer;
    }
    .page-props .pp-btn:hover { background: var(--band); }
    .pp-muted { color: var(--muted); }
    .pp-x, .pp-chip-x {
      width: 22px; height: 22px; padding: 0; border: 0; border-radius: 5px; cursor: pointer;
      background: none; color: var(--muted); font-size: 11px;
    }
    .pp-x:hover, .pp-chip-x:hover { color: var(--ink); background: var(--band); }
    .pp-chips { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
    .pp-chip {
      display: inline-flex; align-items: center; gap: 6px; height: 24px; padding: 0 3px 0 8px;
      background: var(--band); border: 1px solid var(--hair); border-radius: 12px; font-size: 12.5px;
    }
    .pp-chip img { width: 17px; height: 12px; object-fit: contain; }
    .pp-chip:not(:has(.pp-chip-x)) { padding-right: 10px; }
    .pp-chip-x { width: 18px; height: 18px; border-radius: 9px; font-size: 10px; }
    .pp-add {
      height: 24px; padding: 0 9px; font: 12.5px var(--body); color: var(--muted); cursor: pointer;
      background: none; border: 1px dashed var(--rule); border-radius: 12px;
    }
    .pp-add:hover { color: var(--ink); border-style: solid; }
    .f-with-btn input[type=text] { flex: 1; }
    .f-with-btn .pp-btn { margin-left: 0; }
    .pp-sws { gap: 18px; }
    .pp-sw { display: inline-flex; align-items: center; gap: 7px; cursor: pointer; color: var(--ink); font-size: 12.5px; }
    .pp-sw input { position: absolute; opacity: 0; pointer-events: none; }
    .pp-sw span { display: inline-block; flex: none; position: relative; width: 26px; height: 15px; border-radius: 8px; background: var(--rule); transition: background .12s; }
    .pp-sw span::after {
      content: ''; position: absolute; left: 2px; top: 2px; width: 11px; height: 11px;
      border-radius: 50%; background: #fff; transition: transform .12s;
    }
    .pp-sw input:checked + span { background: var(--link); }
    .pp-sw input:checked + span::after { transform: translateX(11px); }
    .pp-sw input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
    .pp-pop {
      position: fixed; z-index: 70; width: 230px; padding: 6px;
      background: var(--lift); border: 1px solid var(--rule); border-radius: 8px; box-shadow: 0 10px 28px rgb(0 0 0 / .55);
    }
    .pp-pop[hidden] { display: none; }
    .pp-pop input {
      width: 100%; height: 28px; box-sizing: border-box; padding: 0 8px; margin-bottom: 4px;
      font: 13px var(--body); color: var(--ink); background: var(--paper); border: 1px solid var(--rule); border-radius: 6px;
    }
    .pp-pop input:focus { outline: none; border-color: var(--link); }
    .pp-pop-list { max-height: 260px; overflow-y: auto; }
    .pp-pop-list button {
      display: flex; align-items: center; gap: 8px; width: 100%; padding: 5px 7px; font: 13px var(--body);
      color: var(--ink); background: none; border: 0; border-radius: 5px; cursor: pointer; text-align: left;
    }
    .pp-pop-list button:hover { background: var(--band); }
    .pp-pop-list img { width: 18px; height: 12px; object-fit: contain; }

    /* ---- publish ---- */
    .draft-state { flex: none; font: 12px var(--body); color: var(--muted); display: inline-flex; align-items: center; gap: 6px; margin-right: 8px; white-space: nowrap; }
    .draft-state::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: #7fae8a; }
    .draft-state[hidden] { display: none; }
    .ed-tools #publish { flex: none; display: inline-flex; align-items: center; gap: 8px; }
    .ed-tools #publish .cart-n { margin: 0; background: rgb(255 255 255 / .18); border-color: transparent; color: #fff; }
    .ed-tools #publish .cart-n[hidden] { display: none; }
    .pub.pubs { width: min(600px, 100%); padding: 0; display: flex; flex-direction: column; max-height: calc(100vh - 60px); overflow: hidden; }
    .pub-head { display: flex; align-items: center; justify-content: space-between; padding: 18px 22px 12px; }
    .pub .pub-head h2 { margin: 0; }
    .pub-ico {
      display: inline-grid; place-items: center; width: 30px; height: 30px; padding: 0; flex: none;
      background: none; border: 0; border-radius: 7px; color: var(--muted); cursor: pointer;
    }
    .pub-ico:hover { color: var(--ink); background: var(--band); }
    .pub-ico svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
    .pr-list { overflow-y: auto; padding: 0 22px; border-top: 1px solid var(--hair); }
    .pr-list:empty { display: none; }
    .pr-row { display: grid; grid-template-columns: 16px minmax(0, 1fr) auto; gap: 12px; align-items: start; padding: 14px 0; border-bottom: 1px solid var(--hair); }
    .pr-row:last-child { border-bottom: 0; }
    .pub .pr-row > input { display: inline-block; width: 16px; height: 16px; margin: 2px 0 0; padding: 0; accent-color: var(--link); cursor: pointer; }
    .pr-top { display: flex; align-items: center; gap: 8px; min-width: 0; }
    .pr-top b { font: 600 14px var(--body); color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .pr-tag { flex: none; font: 600 10.5px var(--body); padding: 2px 7px; border-radius: 9px; background: var(--band); color: var(--muted); }
    .pr-tag:empty { display: none; }
    .pr-tag.live { color: #8fc49b; background: rgb(127 174 138 / .14); }
    .pr-tag.review { color: #e2c06b; background: rgb(226 192 107 / .13); }
    .pr-tag.bad { color: #e8a0a0; background: rgb(224 140 140 / .13); }
    .pr-tag.closed { color: var(--muted); }
    .pr-delta { flex: none; display: flex; gap: 6px; margin-right: 8px; font: 12px var(--body); font-variant-numeric: tabular-nums; }
    .pr-add { color: #8fc49b; }
    .pr-del { color: #e8a0a0; }
    .pr-meta { display: flex; align-items: center; gap: 6px; margin-top: 3px; font: 12.5px var(--body); color: var(--muted); min-width: 0; white-space: nowrap; overflow: hidden; }
    .pr-meta span { overflow: hidden; text-overflow: ellipsis; }
    .pr-arrow { flex: none; }
    .pr-to { color: var(--ink); }
    .pub .pr-note {
      margin-top: 9px; height: 30px; padding: 0 9px; font-size: 13px;
      background: var(--paper); border: 1px solid var(--hair); border-radius: 6px;
    }
    .pr-acts { display: flex; align-items: center; gap: 2px; margin-top: -5px; }
    .pr-empty { color: var(--muted); font-size: 13px; margin: 0; padding: 14px 22px; border-top: 1px solid var(--hair); }
    .pr-empty[hidden] { display: none; }
    .pr-sent { padding: 12px 22px 4px; border-top: 1px solid var(--hair); }
    .pr-sent[hidden] { display: none; }
    .pr-sent h3 { font: 600 11px var(--body); color: var(--muted); letter-spacing: .05em; text-transform: uppercase; margin: 0 0 4px; }
    .pr-sent-row { display: flex; align-items: center; gap: 8px; padding: 5px 0; font-size: 13px; }
    .pr-sent-title { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .pr-sent-row a { color: var(--link); font-size: 12.5px; font-variant-numeric: tabular-nums; }
    .pub-token { display: flex; align-items: center; gap: 12px; padding: 12px 22px; border-top: 1px solid var(--hair); font-size: 13px; }
    .pt-k { flex: none; color: var(--muted); }
    .pt-set, .pt-new { display: flex; align-items: center; gap: 10px; flex: 1; min-width: 0; }
    .pt-set[hidden], .pt-new[hidden] { display: none; }
    .pub .pt-new input { margin: 0; height: 30px; padding: 0 9px; flex: 1; }
    .pt-link { flex: none; font: 12.5px var(--body); color: var(--link); background: none; border: 0; padding: 0; cursor: pointer; }
    .pt-link:hover { text-decoration: underline; }
    .pub-token .pt-help { margin-left: auto; }
    .guide-back { z-index: 85; }
    .pub.guide { width: min(500px, 100%); padding: 0; }
