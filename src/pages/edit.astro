              if (!hasContent(cbox)) {
                if (levelOf(cur) > 0) nest(cur, levelOf(cur) - 1); else outOf([cur]);
                return;
              }
              // What follows the caret goes down into a new item, as Enter splits a line.
              const tail = document.createRange();
              tail.selectNodeContents(cbox);
              tail.setStart(s.focusNode, s.focusOffset);
              const next = item('', levelOf(cur));
              const rest = tail.extractContents();
