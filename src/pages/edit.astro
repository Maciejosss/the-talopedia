     * picture counts as well as a letter; the one <br> a browser leaves at the end of a
     * box to hold an empty last line open does not, because nothing shows for it.
     */
    function caretEdges(box) {
      const s = getSelection();
      const some = (r, tail) => {
        const f = r.cloneContents();
