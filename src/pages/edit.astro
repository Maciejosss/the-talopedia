    }

    // The three shapes a picture can take, in the order the button walks them.
    const LAYOUTS = ['image', 'float', 'grid'];
    const LAYOUT_GLYPH = { image: '\u25AD', float: '\u25E7', grid: '\u25A6' };
    const LAYOUT_NAME = { image: 'static', float: 'floating', grid: 'grid' };

    /** Rebuild this picture's block as the next shape, keeping what it holds. */
    function cycleLayout(fig) {
      const blk = fig.closest('.blk');
      if (!blk || !LAYOUTS.includes(blk.dataset.kind)) return;
      const to = LAYOUTS[(LAYOUTS.indexOf(blk.dataset.kind) + 1) % LAYOUTS.length];
      const held = [...blk.querySelectorAll('figure')].map((x) => ({
        src: x.querySelector('input.path')?.value.trim() || '',
        caption: htmlToMd(x.querySelector('.cap')).trim(),
      }));
      // A grid holds several pictures; leaving it gives each one a block of its own
      // rather than quietly dropping all but the first.
      const made = to === 'grid'
        ? [block('grid', { items: held })]
        : held.map((h) => block(to, to === 'float' ? { ...h, align: 'right', width: 320 } : h));
      blk.replaceWith(...made);
      const tools = made[0]?.querySelector('.fig-tools');
      if (tools) {
        tools.classList.add('stay');
        addEventListener('mousemove', () => tools.classList.remove('stay'), { once: true });
      }
      made[0]?.querySelector('.cap')?.focus();
      sync();
      flash(`Now ${LAYOUT_NAME[to]}${made.length > 1 ? `, ${made.length} blocks` : ''}.`);
    }

    function figure(d = {}, removable = false) {
      const f = el('figure');
      if (d.ratio) f.classList.add(`r-${d.ratio}`);
      const img = el('img'); img.alt = '';
      // Nobody types a path any more; the Media panel fills it. The field stays
      // because it is what the panel aims at, and stays out of sight otherwise.
      const src = el('input', 'path'); src.value = d.src || '';
      src.tabIndex = -1;
      const choose = (e) => { e.stopPropagation(); openFor(src); };
      // Only until a picture is chosen: an empty figure has nothing to see or aim at.
      const empty = el('button', 'fig-empty', 'No picture'); empty.type = 'button';
      empty.onclick = choose;
      const paint = () => {
        if (src.value) { img.src = srcFor(src.value); img.hidden = false; } else img.hidden = true;
        empty.hidden = !!src.value;
