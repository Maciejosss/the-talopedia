      // background, and a picture added there would keep a blank, hidden button forever.
      setTimeout(() => {
        const kind = f.closest('.blk')?.dataset.kind;
        if (!LAYOUTS.includes(kind)) { lay.hidden = true; return; }
        const next = LAYOUTS[(LAYOUTS.indexOf(kind) + 1) % LAYOUTS.length];
        lay.textContent = LAYOUT_GLYPH[kind];
        lay.title = `Layout: ${LAYOUT_NAME[kind]}. Click for ${LAYOUT_NAME[next]}.`;
      });
      const swap = el('button', null, '⇄'); swap.type = 'button'; swap.title = 'Change this picture';
      swap.onmousedown = (e) => e.preventDefault();
      swap.onclick = choose;
      tools.append(lay, swap);
      if (removable) {
        const x = el('button', null, '✕'); x.type = 'button'; x.title = 'Remove this picture';
        x.onmousedown = (e) => e.preventDefault();
