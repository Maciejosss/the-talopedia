    /* ---------- the page's details, under its title ---------- */
    // Folded away until asked for.
    function showDetails(open) {
      $('#settings').classList.toggle('closed', !open);
      $('#pp-toggle').setAttribute('aria-expanded', String(open));
    }
    showDetails(false);
    $('#pp-toggle').onclick = () => showDetails($('#settings').classList.contains('closed'));
    const onSiteKey = (kind, slug) => !!slug && ARTICLES.some((a) => a.slug === indexKey(kind, slug));
    const assetSrc = (p) => (String(p || '').startsWith('/') ? BASE.replace(/\/$/, '') + p : p);
    /** A page on the site shows its address and moves; a new one types its own. */
    function paintAddress() {
      const live = onSiteKey(pageKind, pageSlug);
      const now = slugify(slugValue() || pageSlug);
      $('#pp-base').textContent = pageKind === 'portal' ? '/portal/' : '/';
      $('#f-slug').hidden = live;
      $('#pp-slug').hidden = !live;
      $('#pp-slug').textContent = now;
      $('#pp-was').textContent = live && now !== pageSlug ? `from /${pageSlug}` : '';
      $('#pp-move').hidden = !(live && pageKind === 'article' && pageSlug !== 'home');
    }
    function paintAuthors() {
      const box = $('#pp-authors');
      const ids = $('#f-authors').value.split(',').map((x) => x.trim()).filter(Boolean);
      const locked = $('#f-authors').readOnly;
      box.replaceChildren();
      for (const id of ids) {
        const chip = el('span', 'pp-chip');
        if (FLAGS[id]) { const im = el('img'); im.src = assetSrc(FLAGS[id]); im.alt = ''; chip.append(im); }
        chip.append(el('span', null, NATION_NAMES[id] || id));
        if (!locked) {
          const x = el('button', 'pp-chip-x', '✕');
          x.type = 'button';
          x.title = 'Remove';
          x.onclick = () => setAuthors(ids.filter((i) => i !== id));
          chip.append(x);
        }
        box.append(chip);
      }
      if (!locked) {
        const add = el('button', 'pp-add', '+ Add');
        add.type = 'button';
        add.onclick = (e) => { e.stopPropagation(); nationPick(add, ids, (id) => setAuthors([...ids, id])); };
        box.append(add);
      }
    }
    function setAuthors(ids) { $('#f-authors').value = ids.join(', '); paintSettings(); sync(); }
    /** A list of nations to choose from, under the button that asked. */
    const pickPop = el('div', 'pp-pop');
    pickPop.hidden = true;
    document.body.append(pickPop);
    function nationPick(anchor, exclude, done) {
      pickPop.replaceChildren();
      const q = el('input');
      q.placeholder = 'Nation';
      const list = el('div', 'pp-pop-list');
      const paint = () => {
        list.replaceChildren();
        const f = fold(q.value.trim());
        for (const [id, name] of Object.entries(NATION_NAMES).sort((a, b) => a[1].localeCompare(b[1]))) {
          if (exclude.includes(id) || (f && !fold(name).includes(f))) continue;
          const b = el('button');
          b.type = 'button';
          if (FLAGS[id]) { const im = el('img'); im.src = assetSrc(FLAGS[id]); im.alt = ''; b.append(im); }
          b.append(el('span', null, name));
          b.onclick = () => { pickPop.hidden = true; done(id); };
          list.append(b);
        }
      };
      q.oninput = paint;
      q.onkeydown = (e) => {
        if (e.key === 'Enter') { e.preventDefault(); list.querySelector('button')?.click(); }
        if (e.key === 'Escape') pickPop.hidden = true;
      };
      paint();
      pickPop.append(q, list);
      const r = anchor.getBoundingClientRect();
      pickPop.style.left = `${Math.min(r.left, innerWidth - 240)}px`;
      pickPop.style.top = `${r.bottom + 4}px`;
      pickPop.hidden = false;
      q.focus();
    }
    document.addEventListener('mousedown', (e) => { if (!pickPop.hidden && !pickPop.contains(e.target)) pickPop.hidden = true; });

    /* Moving: a new address, and the pages that link to the old one. */
    async function openMove() {
      $('#mv-slug').value = slugify(slugValue() || pageSlug);
      $('#mv-err').textContent = '';
      $('#move-panel').hidden = false;
      $('#mv-slug').focus();
      $('#mv-slug').select();
      const into = await linksIndex();
      const from = into[pageSlug] || [];
      const titleOf = (k) => ARTICLES.find((a) => a.slug === k)?.title
        || (k.startsWith('navbox:') ? `Navbox: ${NATION_NAMES[k.slice(7)] || 'Site'}` : k);
      $('#mv-n').textContent = from.length;
      $('#mv-list').replaceChildren(...from.map(titleOf).sort((a, b) => a.localeCompare(b)).map((t) => el('div', null, t)));
    }
    function moveTo() {
      const to = slugify($('#mv-slug').value);
      if (!to) { $('#mv-err').textContent = 'Empty'; return; }
      const taken = to !== pageSlug && ARTICLES.find((a) => a.slug === to);
      if (taken) { $('#mv-err').textContent = `Taken: ${taken.title}`; return; }
      setSlug(to);
      slugTouched = true;
      $('#move-panel').hidden = true;
      paintSettings();
      sync();
    }
    $('#pp-move').onclick = openMove;
    $('#mv-go').onclick = moveTo;
    $('#mv-cancel').onclick = () => { $('#move-panel').hidden = true; };
    $('#mv-x').onclick = () => { $('#move-panel').hidden = true; };
    $('#move-panel').onclick = (e) => { if (e.target === $('#move-panel')) $('#move-panel').hidden = true; };
    $('#mv-slug').onkeydown = (e) => {
      if (e.key === 'Enter') { e.preventDefault(); moveTo(); }
      if (e.key === 'Escape') $('#move-panel').hidden = true;
    };
    $('#mv-slug').oninput = () => { $('#mv-err').textContent = ''; };


    $('#download').onclick = downloadPage;
    $('#copy').onclick = async () => {
      await navigator.clipboard.writeText(toMarkdown());
      flash('Markdown copied.');
    };

    /* ---------- save to disk (dev server only) ---------- */
    const slugify = (s) => s.trim().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    let slugTouched = false;

    $('#f-slug').oninput = () => { slugTouched = true; showUrl($('#f-slug').value); };
    if (DEV) {
      $('#save').onclick = async () => {
        $('#more-menu').hidden = true;
        const slug = slugify(slugValue() || $('#f-title').value);
        if (!slug) { flash('Give the article a title first.', true); return; }
        const held = occupiedBy(slug);
        if (held) { refuseReplace(slug, held); return; }
        if (overwrites(slug)) {
          if (keptFraction() < 0.35) { refuseReplace(slug, loadedTitle); return; }
          if (!confirm(`${slug} is "${loadedTitle}". Saving renames it to "${$('#f-title').value.trim()}".\n\n`
              + 'To keep both, cancel and use File \u25b8 Duplicate as a new page.')) return;
        }
        setSlug(slug);
        try {
          const r = await fetch(`${BASE.replace(/\/$/, '')}/__save`, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ slug, markdown: toMarkdown(), kind: pageKind }),
          });
          const out = await r.json();
          if (!r.ok) throw new Error(out.error || r.statusText);
          const line = `${out.created ? 'Created' : 'Updated'} ${out.file}`;
          flash(line);
          // Writing into src/ restarts the dev server, which reloads this page; the line
          // is said again once it has, over the page as now saved.
          try { sessionStorage.setItem(SAVED, line); } catch {}
        } catch (e) {
          flash(`Not saved: ${e.message}`, true);
        }
      };
    }

    /* ---------- staged images (no server to upload to) ---------- */
    const staged = new Map();           // '/assets/media/x.jpg' -> { file, url }
    const slugFile = (n) => n.toLowerCase().replace(/[^a-z0-9.]+/g, '-').replace(/^-|-$/g, '');
    const ALLOWED = /\.(png|jpe?g|webp|gif|avif)$/i;

    /** Writes an upload to disk. Only the dev server offers uploads, so only it calls this. */
    async function takeImage(file, chosen) {
      if (!ALLOWED.test(file.name)) { flash(`${file.name} is not an allowed image type.`, true); return null; }
      // Every upload is named by hand; that name, kebab-cased, is the filename the article carries.
      const ext = (file.name.match(/\.[^.]+$/) || [''])[0].toLowerCase();
      const name = chosen ? slugFile(chosen).replace(/\.[^.]*$/, '') + ext : slugFile(file.name);
      const data = await new Promise((res) => {
        const fr = new FileReader();
        fr.onload = () => res(String(fr.result).split(',')[1]);
        fr.readAsDataURL(file);
      });
      const r = await fetch(`${BASE.replace(/\/$/, '')}/__upload`, {
        method: 'POST', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ name, data }),
      });
      const out = await r.json();
      if (!r.ok) { flash(out.error || 'Upload failed.', true); return null; }
      flash(`Uploaded ${out.path}`);
      loadAssets(true);
      return out.path;
    }

    /** A staged file has no server path yet, so previews come from the blob. */
    // A staged upload shows from memory; anything else is a site path, which on a
    // project site lives under /<repo>/. Every <img> in the editor goes through here,
    // or it 404s wherever the site is not served from the domain root.
    const srcFor = (p) => staged.get(p)?.url || (String(p || '').startsWith('/')
      ? BASE.replace(/\/$/, '') + p : p);

    /* ---------- media panel ---------- */
    let ASSETS = [];
    let assetsLoaded = null;

    const mpIcons = $('#mp-icons');

    function loadAssets(force = false) {
      if (!force && assetsLoaded) return assetsLoaded;
      assetsLoaded = fetch(`${BASE.replace(/\/$/, '')}/assets.json`)
        .then((r) => r.json()).then((a) => { ASSETS = a; paintAssets(); })
        .catch(() => { $('#mp-icons').innerHTML = '<p class="mp-empty">Could not read the asset list.</p>'; });
      return assetsLoaded;
    }

    // macOS stores "Kōrihama" decomposed, as o plus a combining macron, while typing
    // it gives the single precomposed character. Comparing them raw finds nothing, so
    // both sides are folded down to plain letters first.
    const fold = (s) => String(s).toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');

    function paintAssets() {
      const iq = fold($('#mp-iq').value.trim());
      // Inline icons: the trend arrows, then nation flags, then articles with an icon.
      mpIcons.innerHTML = '';
      const arrows = [
        { kind: 'up', label: 'Up', terms: 'up rise increase arrow green' },
        { kind: 'down', label: 'Down', terms: 'down fall decrease arrow red' },
      ].filter((a) => !iq || a.terms.includes(iq));
      const group = (name, n) => {
        const g = el('div', 'mp-group');
        g.append(el('span', null, name), el('span', 'mp-n', String(n)));
        return g;
      };
      if (arrows.length) mpIcons.append(group('Arrows', arrows.length));
      for (const a of arrows) {
        const b = el('button', 'mp-icon');
        b.type = 'button';
        b.title = `:${a.kind}`;
        b.append(el('span', `tok arrow ${a.kind}`, ARROW[a.kind]), el('span', null, a.label));
        b.onmousedown = (e) => e.preventDefault();
        b.onclick = () => insertToken(a.kind);
        mpIcons.append(b);
      }
      // Registered nations first: those insert :flag[slug], which follows a rename.
      const icons = Object.entries(ICONS)
        // A nation names itself: the flag registry knows "E.S.U." where the slug reads esu.
        .map(([slug, src]) => ({ slug, src, kind: FLAGS[slug] ? 'flag' : 'icon',
          label: NATION_NAMES[slug] || displayOf(slug) }));
      // Then every other flag and emblem sitting in the folders. Most of what a war
      // article needs is here: former states, colonies and wartime variants are not
      // nations in the registry, so nothing in the registry could ever offer them.
      const held = new Set(icons.map((i) => i.src));
      // The flags, and the icons folder (medals and the like). Everything else that used
      // to be offered here now lives in the archive, which is closed: a new picture
      // comes from an image host instead.
      const GROUP = { flags: 'flag', icons: 'symbol' };
      for (const a of ASSETS) {
        if (!GROUP[a.group] || held.has(a.path)) continue;
        const stem = a.name.replace(/\.[^.]+$/, '');
        const label = displayOf(stem);
        // The icons folder splits by use: medals, and the marks for how a commander's
        // war ended. Anything else in it is gathered under Other icons.
        const kind = GROUP[a.group] === 'symbol'
          ? /-medal$/.test(stem) ? 'medal' : /^(executed|killed-in-action|surrendered)$/.test(stem) ? 'fate' : 'symbol'
          : GROUP[a.group];
        icons.push({ slug: a.path, src: a.path, kind, label, loose: true });
      }
      // Next to the arrows the icons, then flags, then emblems. Medals go gold, silver,
      // bronze, as they are won, rather than by name.
      const RANK = { medal: 0, fate: 1, symbol: 2, flag: 3, icon: 4 };
      const PODIUM = ['gold', 'silver', 'bronze'];
      const place = (i) => (i.kind === 'medal' ? PODIUM.findIndex((m) => i.label.toLowerCase().startsWith(m)) : 0);
      icons.sort((a, b) => RANK[a.kind] - RANK[b.kind] || place(a) - place(b) || a.label.localeCompare(b.label));
      const shown = icons.filter((i) => !iq || fold(i.label).includes(iq) || fold(i.slug).includes(iq));
      if (!shown.length && !arrows.length) { mpIcons.innerHTML = '<p class="mp-empty">Nothing matches.</p>'; }
      let kind = null;
      for (const i of shown) {
        if (i.kind !== kind) {
          kind = i.kind;
          mpIcons.append(group({ medal: 'Medals', fate: 'Commanders', symbol: 'Other icons', flag: 'Flags', icon: 'Emblems' }[kind],
            shown.filter((x) => x.kind === kind).length));
        }
        const b = el('button', 'mp-icon');
        b.type = 'button';
        // A registered nation goes in by name, so renaming it carries. One that is
        // only a file goes in by path, because there is no name to follow.
        const token = i.loose ? 'img' : i.kind;
        b.title = `:${token}[${i.slug}]`;
        const img = el('img'); img.src = srcFor(i.src); img.alt = '';
        b.append(img, el('span', null, i.label));
        b.onmousedown = (e) => e.preventDefault();
        b.onclick = () => insertToken(token, i.slug);
        mpIcons.append(b);
      }
    }

    const fill = (input, path) => {
      input.value = path;
      input.dispatchEvent(new Event('input', { bubbles: true }));
      input.focus();
    };

    /** Clicking an image fills whichever image field you were last in, else adds a block. */
    /* ---------- pictures kept somewhere else ----------
       The archive in this repository is closed: new pictures live on an image host and
       the article keeps the link. Only hosts that serve a stable direct link are taken,
       because the alternative is an article whose pictures quietly vanish. */

    const HOSTS = ['i.ibb.co', 'ibb.co', 'i.imgur.com', 'imgur.com', 'files.catbox.moe',
      'drive.google.com', 'lh3.googleusercontent.com'];
    const hostOf = (u) => { try { return new URL(u).hostname.toLowerCase().replace(/^www\./, ''); } catch { return ''; } };
    const allowed = (u) => HOSTS.includes(hostOf(u));

    /**
     * Neither Drive nor Photos hands you a picture's own address. The share button gives
     * a page, and the picture sits at a fixed address elsewhere. Drive writes the file's
     * id into every shape of link it produces, so that address can be built here. Photos
     * does not, and its share page refuses cross-origin reads, so the address has to come
     * off the picture itself with Copy image address.
     */
    const DRIVE_ID = /(?:\/file\/d\/|[?&](?:id|docid)=|\/d\/)([A-Za-z0-9_-]{20,})/;
    const PHOTO_ID = /^https:\/\/lh3\.googleusercontent\.com\/(pw\/[A-Za-z0-9_-]+)/;
    // Wider than any column on the site, and Google does the scaling rather than the reader.
    const SIZE = 2000;

    function normaliseLink(u) {
      const host = hostOf(u);
      if (host !== 'drive.google.com' && host !== 'lh3.googleusercontent.com') return u;
      const photo = u.match(PHOTO_ID);
      // Whatever size the copied address asked for is dropped: a pasted one often carries
      // a crop, and every picture here should arrive whole and at a predictable width.
      if (photo) return `https://lh3.googleusercontent.com/${photo[1]}=w${SIZE}`;
      const id = (u.match(DRIVE_ID) || [])[1];
      // Drive's own /thumbnail address only redirects here, and carries a query string
      // that the markdown escapes twice on the way to the page. This form has neither.
      return id ? `https://lh3.googleusercontent.com/d/${id}=w${SIZE}` : u;
    }

    /** What is wrong with this link, or '' if nothing is. */
    function linkTrouble(u) {
      const host = hostOf(u);
      if (!host) return 'That is not a link.';
      // imgbb and imgur give a page for the picture first, and that is the link people
      // copy. The page is not an image, so the picture never shows.
      if (host === 'ibb.co' || host === 'imgur.com') {
        return `That is ${host}'s page for the picture, not the picture itself. Use the `
          + `direct link, the one starting https://i.${host}/`;
      }
      if (host === 'photos.google.com' || host.endsWith('goo.gl')) {
        return 'That is the share page rather than the picture. Open it, right-click the '
          + 'picture, Copy image address, and paste that.';
      }
      if (!allowed(u)) {
        return /discord/.test(host)
          ? 'Discord links expire after a few days. Upload it to imgbb instead.'
          : `${host} is not on the list.`;
      }
      if (host === 'drive.google.com' && !DRIVE_ID.test(u)) {
        return 'That Drive link has no file id in it. Use Share \u2192 Copy link.';
      }
      if (host === 'lh3.googleusercontent.com' && !PHOTO_ID.test(u) && !DRIVE_ID.test(u)) {
        return 'That is a Google address but not a picture. Use Copy image address.';
      }
      return '';
    }

    function linkNote() {
      const raw = $('#mp-link').value.trim();
      const note = $('#mp-link-note');
      if (!raw) {
        note.textContent = 'Accepted: imgbb, imgur, catbox, Google Drive, Google Photos';
        note.className = 'mp-hint';
        return;
      }
      const bad = linkTrouble(raw);
      const host = hostOf(raw);
      note.textContent = bad
        || (PHOTO_ID.test(raw) ? 'Google Photos \u2713  the picture must be shared'
        : host.includes('google') ? 'Google Drive \u2713  the file must be shared with anyone who has the link'
        : `${host} \u2713`);
      note.className = 'mp-hint ' + (bad ? 'bad' : 'ok');
    }

    /**
     * Cut this page loose from the file it was opened from, so what follows is saved
     * as a new one. Using an article as a template and saving it back over the
     * original is the accident this exists to prevent.
     */
    function duplicate() {
      if (!pageSlug && !slugValue()) { flash('Nothing is open to copy.', true); return; }
      keep();
      const from = pageSlug || slugValue();
      pageSlug = '';
      loadedFrom = BUILT_FROM;           // the copy is a new page, not on main yet
      loadedTitle = '';
      loadedBody = '';
      setSlug('');
      slugTouched = false;          // the URL follows the title again until it is typed in
      movedFrom = [];
      // The copy is a page of its own; undoing back past this would put the old
      // page's address on it again.
      resetHistory();
      sync();
      draftKey = newKey();
      opened = toMarkdown();
      kept = { key: draftKey, markdown: opened };
      $('#canvas-title').focus();
      flash(`Copy of ${from}.`);
    }

    /**
     * The subject already living at this file name, when that file is not the one this
     * page was opened from. Writing there replaces one subject with another, which is
     * how three articles were lost in a day: everything changed except the file name.
     *
     * Read from the live index rather than from what was loaded, so a name typed by
     * hand, restored from a draft, or left behind by a copy is caught the same way.
     * A matching title is the same subject arriving by another route, and is allowed.
     */
    function occupiedBy(slug) {
      if (!slug || (pageSlug && slug === pageSlug)) return null;
      const key = pageKind === 'article' ? slug : `${pageKind}:${slug}`;
      const held = ARTICLES.find((a) => a.slug === key);
      if (!held) return null;
      return held.title === $('#f-title').value.trim() ? null : held.title;
    }

    /**
     * How much of the page that was opened is still on screen, by distinct words. A
     * rename keeps the article and changes the name; using one as a template keeps
     * the name of the file and changes everything else. This is what separates them.
     */
    function keptFraction() {
      if (!loadedBody) return 1;
      const words = (t) => new Set(t.toLowerCase().split(/[^a-z0-9\u00c0-\uffff]+/).filter((w) => w.length > 3));
      const was = words(loadedBody);
      if (was.size < 20) return 1;             // too little to judge; fall back to the prompt
      const now = words(toMarkdown());
      let hit = 0;
      for (const w of was) if (now.has(w)) hit++;
      return hit / was.size;
    }

    /** Refuse the write and put the writer in the field they have to change. */
    function refuseReplace(slug, held) {
      flash(`/${slug} is \u201c${held}\u201d.`, true);
      if (!$('#pp-move').hidden) { openMove(); return; }
      showDetails(true);
      $('#f-slug').focus();
      $('#f-slug').select();
    }

    /**
     * True when saving now would write over the page this one was opened from, under a
     * title that is no longer that page's.
     */
    function overwrites(slug) {
      if (!pageSlug || slug !== pageSlug || !loadedTitle) return false;
      return $('#f-title').value.trim() !== loadedTitle;
    }

    /** The file name this page is saved under, wherever it was typed. Declared
        rather than assigned: it is called from further up the file than it sits. */
    function slugValue() { return $('#f-slug').value || $('#slug')?.value || ''; }
    function setSlug(v) {
      $('#f-slug').value = v;
      if ($('#slug')) $('#slug').value = v;
      showUrl(v);
    }

    /**
     * Keep the address bar naming the page that would be written. A new page made by
     * copying an old one used to leave the old one's address on screen, which reads
     * like the original is still open and about to be written over.
     */
    function showUrl(slug) {
      const prefix = pageKind === 'article' ? '' : `${pageKind}:`;
      const q = slug ? `?a=${encodeURIComponent(prefix + slug)}` : '';
      history.replaceState(null, '', location.pathname + q);
    }

    // The picture the Media panel was opened for. Working this out from whatever has
    // focus does not survive the panel taking focus itself, so the caller says outright.
    let pickTarget = null;
    const openFor = (field) => {
      pickTarget = field;
      // A sidebar picture cannot float: the column is the frame. Choosing Static or a
      // Grid there changes how many pictures the row holds instead.
      const inSidebar = !!field?.closest?.('.ib-media');
      document.querySelector('[data-as="float"]')?.toggleAttribute('hidden', inSidebar);
      // Opened for a picture's own field, the panel fills it; an icon has no business here.
      document.querySelector('[data-as="icon"]')?.toggleAttribute('hidden', !!field);
      // Set back by hand: pressing Static here would also turn a sidebar pair into one picture.
      if (field && insertAs === 'icon') {
        insertAs = 'image';
        document.querySelectorAll('[data-as]').forEach((x) => x.classList.toggle('on', x.dataset.as === 'image'));
        $('#mp-outline-row').hidden = true;
        $('#mp-ratio').closest('.mp-row').hidden = false;
      }
      if (inSidebar) {
        const slots = field.closest('.ib-media').querySelectorAll('.ib-slot').length;
        const want = slots > 1 ? 'grid' : 'image';
        document.querySelectorAll('[data-as]').forEach((x) => x.classList.toggle('on', x.dataset.as === want));
        insertAs = want;
      }
      paintAsDesc();
      openMedia();
    };
    /** A line under Placement saying what the chosen one does, which the names alone don't. */
    function paintAsDesc() {
      const d = $('#mp-as-desc');
      if (!d) return;
      const side = !!pickTarget?.closest?.('.ib-media');
      d.textContent = side
        ? { image: 'One picture across the sidebar.', grid: 'Two pictures side by side in this row.' }[insertAs] || ''
        : { image: 'Full width, on a line of its own.', float: 'Beside the text, which wraps around it.',
            grid: 'Several pictures side by side in a row.', icon: 'Small, inside a line of text, like a flag.' }[insertAs] || '';
    }

    /** Make a sidebar picture row hold one picture or two. */
    function setSidebarSlots(cell, n) {
      const tr = cell.closest('tr');
      const rows = readInfobox();
      const i = [...ib.querySelectorAll('tr[data-kind]')].indexOf(tr);
      if (i < 0) return;
      const cur = rows[i];
      const held = cur.images || [{ src: cur.image || '', caption: cur.caption || '' }];
      if (held.length === n) return;
      const next = n > held.length ? [...held, { src: '', caption: '' }] : held.slice(0, n);
      rows[i] = {
        ...(next.length > 1 ? { images: next } : { image: next[0].src, caption: next[0].caption }),
        ...(cur.join && { join: true }),
      };
      // Rebuilt from the row data rather than by moving nodes, so every slot comes
      // out with its own handlers.
      setInfobox(rows);
      sync();
    }

    /* ---------- sidebar pictures, dragged ----------
       Onto another sidebar picture, a picture goes beside it on whichever side the pointer
       is, two to a row as ever; within its own pair, that changes sides. Onto any other row,
       or a full pair, it takes a row of its own above or below. Like setSidebarSlots, the
       move is made on the row data and the sidebar rebuilt from it. */
    let dragging = null;
    let marked = [];
    const filledSlot = (s) => !!(s.querySelector('input.path')?.value || s.querySelector('.ce')?.textContent.trim());
    const picturesOf = (r) => (r.images ? r.images.map((x) => ({ ...x })) : [{ src: r.image || '', caption: r.caption || '' }])
      .filter((x) => x.src || x.caption);
    const pictureRow = (pics, join) => ({
      ...(pics.length > 1 ? { images: pics } : { image: pics[0].src, caption: pics[0].caption }),
      ...(join && { join: true }),
    });
    function pictureDrag(e, slot) {
      const tr = slot.closest('tr');
      dragging = {
        el: slot,
        row: [...ib.querySelectorAll('tr[data-kind]')].indexOf(tr),
        slot: [...tr.querySelectorAll('.ib-slot')].filter(filledSlot).indexOf(slot),
      };
      // Only this editor's own kind of drag, so a drop in the article inserts nothing.
      e.dataTransfer.clearData();
      e.dataTransfer.setData('text/x-talopedia-picture', '');
      e.dataTransfer.effectAllowed = 'move';
      slot.classList.add('dragging');
    }
    function pictureMark(to) {
      marked.forEach(([node, c]) => node.classList.remove(c));
      marked = [];
      if (!to) return;
      const [node, c] = to.beside ? [to.slot, to.before ? 'drop-before' : 'drop-after'] : [to.tr, to.above ? 'drop-above' : 'drop-below'];
      node.classList.add(c);
      marked.push([node, c]);
    }
    function pictureDone() {
      dragging?.el.classList.remove('dragging');
      dragging = null;
      pictureMark(null);
    }
    /** Where a picture let go at this point goes: beside a picture, or a row of its own. */
    function pictureDrop(e) {
      const tr = e.target.closest?.('tr[data-kind]');
      if (!tr || !ib.contains(tr)) return null;
      const row = [...ib.querySelectorAll('tr[data-kind]')].indexOf(tr);
      const slot = e.target.closest('.ib-slot');
      if (slot && tr.dataset.kind === 'image') {
        const filled = [...tr.querySelectorAll('.ib-slot')].filter(filledSlot);
        if (row === dragging.row || filled.length < 2) {
          const box = slot.getBoundingClientRect();
          const before = e.clientX < box.left + box.width / 2;
          const k = filled.indexOf(slot);
          return { row, slot, beside: true, before, at: k < 0 ? filled.length : k + (before ? 0 : 1) };
        }
      }
      const box = tr.getBoundingClientRect();
      return { row, tr, above: e.clientY < box.top + box.height / 2 };
    }
    function pictureMove(to) {
      const rows = readInfobox();
      const out = rows.map((r) => [r]);
      const from = picturesOf(rows[dragging.row]);
      const [pic] = from.splice(dragging.slot, 1);
      if (!pic) return;
      out[dragging.row] = from.length ? [pictureRow(from, rows[dragging.row].join)] : [];
      if (to.beside) {
        const into = to.row === dragging.row ? from : picturesOf(rows[to.row]);
        into.splice(to.row === dragging.row && dragging.slot < to.at ? to.at - 1 : to.at, 0, pic);
        out[to.row] = [pictureRow(into, rows[to.row].join)];
      } else {
        const alone = pictureRow([pic]);
        out[to.row] = to.above ? [alone, ...out[to.row]] : [...out[to.row], alone];
      }
      setInfobox(out.flat());
      sync();
    }
    ib.addEventListener('dragover', (e) => {
      if (!dragging) return;
      const to = pictureDrop(e);
      pictureMark(to);
      if (!to) return;
      e.preventDefault();
      e.dataTransfer.dropEffect = 'move';
    });
    ib.addEventListener('dragleave', (e) => { if (dragging && !ib.contains(e.relatedTarget)) pictureMark(null); });
    ib.addEventListener('drop', (e) => {
      if (!dragging) return;
      e.preventDefault();
      const to = pictureDrop(e);
      if (to) pictureMove(to);
      pictureDone();
    });

    // Static, floating or a grid: whichever the Media panel is set to, and the shape
    // the picture is cut to, which is its own proportions unless one is chosen.
    let insertAs = 'image';
    // As an icon: whether it wears the white outline a flag gets against the page.
    let insertOutline = true;
    let insertRatio = '';

    /** How wide a picture dropped into a table cell starts out. */
    const CELL_WIDTH = 96;

    function useImage(path) {
      // Whatever the panel was opened for wins, then a field still being typed in.
      if (pickTarget?.isConnected) {
        const t = pickTarget;
        pickTarget = null;
        return fill(t, path);
      }
      const field = activeField();
      if (field) return fill(field, path);
      // As an icon: any picture, in the line wherever the caret is, drawn the height of
      // the text beside it. It needs no place on the icon list.
      if (insertAs === 'icon') {
        insertToken('img', `${path}|${insertOutline ? 'outline' : 'bare'}`);
        return;
      }
      const near = activeText()?.closest?.('figure, tr[data-kind="image"]');
      if (near) return fill(near.querySelector('input.path'), path);
      // A picture in a table cell is an inline mark, because a figure cannot live in
      // a cell. It carries a width so it renders as a picture; an icon left at its
      // natural size comes out one line tall, which is right for a flag and useless
      // for a photograph.
      if (activeText()?.closest?.('.ed-tbl')) {
        insertToken('img', `${path}|${CELL_WIDTH}`);
        return;
      }
      // A grid the writer is already standing in gains another picture.
      const grid = activeText()?.closest?.('.blk-grid');
      if (insertAs === 'grid' && grid) {
        const f = figure({ src: path }, true);
        (grid.querySelector('.imgrid') || grid).append(f);
        sync();
        return;
      }
      // block() already carries the path in; hunting down "the last block of this
      // kind" afterwards filled whichever figure happened to sit lowest on the page.
      insert(insertAs, insertAs === 'grid'
        ? { items: [{ src: path, caption: '', ratio: insertRatio }] }
        : { src: path, ratio: insertRatio });
    }

    function insertToken(kind, slug) {
      const mark = 'tok-' + Date.now();
      const html = tokenHtml(kind, slug).replace('<img ', `<img data-new="${mark}" `) + '\u00a0';
      if (!insertAtCaret(html)) {
        flash('Put the cursor where it should go.', true);
        return false;                    // the caller leaves its menu open to retry
      }
      // execCommand leaves a trailing <br> after the inserted run; a table cell
      // would serialize that as a line break, so drop the one we just caused.
      const img = document.querySelector(`[data-new="${mark}"]`);
      if (img) {
        let n = img.nextSibling;
        while (n && n.nodeType === 3 && !n.nodeValue.trim()) n = n.nextSibling;
        if (n && n.nodeName === 'BR') n.remove();
        img.removeAttribute('data-new');
      }
      sync();
      return true;
    }

    const PANES = ['images', 'icons'];
    /** Open the Media panel on its image list, to fill whichever field was just focused. */
    function openMedia() {
      document.querySelectorAll('.drop-menu').forEach((m) => { m.hidden = m.id !== 'insert-menu'; });
      document.querySelectorAll('#insert-menu > .mp-tabs button')
        .forEach((x) => x.classList.toggle('on', x.dataset.pane === 'images'));
      for (const p of PANES) $('#pane-' + p).hidden = p !== 'images';
      loadAssets();
      $('#mp-link')?.focus();
    }
    // Opened from the toolbar, the panel puts pictures in at the caret: no picture from an
    // earlier opening is still waiting to be filled, and every way in is offered again.
    $('#insert').addEventListener('click', () => {
      pickTarget = null;
      document.querySelectorAll('[data-as="float"], [data-as="icon"]').forEach((b) => b.removeAttribute('hidden'));
      paintAsDesc();
    });
    document.querySelectorAll('#insert-menu > .mp-tabs button').forEach((b) => b.onclick = () => {
      document.querySelectorAll('#insert-menu > .mp-tabs button')
        .forEach((x) => x.classList.toggle('on', x === b));
      for (const p of PANES) $('#pane-' + p).hidden = b.dataset.pane !== p;
    });
    document.querySelectorAll('[data-as]').forEach((b) => b.onclick = () => {
      document.querySelectorAll('[data-as]').forEach((x) => x.classList.toggle('on', x === b));
      insertAs = b.dataset.as;
      paintAsDesc();
      // An icon is a mark in the line at the height of its text, whatever the picture's
      // own size: it takes an outline or not, and no shape.
      $('#mp-outline-row').hidden = insertAs !== 'icon';
      $('#mp-ratio').closest('.mp-row').hidden = insertAs === 'icon';
      // Aimed at the sidebar, this is a choice about that row rather than about what
      // the next insert will be.
      const cell = pickTarget?.closest?.('.ib-media');
      if (cell) setSidebarSlots(cell, insertAs === 'grid' ? 2 : 1);
    });
    document.querySelectorAll('[data-outline]').forEach((b) => b.onclick = () => {
      document.querySelectorAll('[data-outline]').forEach((x) => x.classList.toggle('on', x === b));
      insertOutline = b.dataset.outline === '1';
    });
    document.querySelectorAll('[data-ratio]').forEach((b) => b.onclick = () => {
      document.querySelectorAll('[data-ratio]').forEach((x) => x.classList.toggle('on', x === b));
      insertRatio = b.dataset.ratio;
      // A shape the writer has just chosen applies to the picture they are standing in.
      const fig = activeText()?.closest?.('figure') || activeField()?.closest?.('figure');
      if (fig) { setRatio(fig, insertRatio); sync(); }
    });

    /** Put a shape on a figure, or take the one it has off. */
    function setRatio(fig, r) {
      [...fig.classList].filter((c) => /^r-/.test(c)).forEach((c) => fig.classList.remove(c));
      if (r) fig.classList.add(`r-${r}`);
    }

    if ($('#mp-link')) {
      const go = () => {
        const u = $('#mp-link').value.trim();
        if (!u) return;
        const bad = linkTrouble(u);
        if (bad) { linkNote(); flash(bad, true); return; }
        useImage(normaliseLink(u));
        $('#mp-link').value = '';
        linkNote();
      };
      $('#mp-link').oninput = linkNote;
      $('#mp-link').onkeydown = (e) => { if (e.key === 'Enter') { e.preventDefault(); go(); } };
      $('#mp-link-go').onclick = go;
      linkNote();
    }
    $('#mp-iq').oninput = paintAssets;
    // The menu stays open while you browse it, unlike a one-shot command.
    // A click anywhere shuts every menu. These two are panels to work in rather than
    // lists to pick from, so a click inside one must not reach that handler; each
    // closes itself once it has done the thing it was opened for.
    $('#insert-menu').addEventListener('click', (e) => e.stopPropagation());
    $('#ins-menu').addEventListener('click', (e) => e.stopPropagation());
    // Nothing in the panel may take focus, or the caret in the article is lost
    // before the chosen image or icon can be inserted at it.
    $('#insert-menu').addEventListener('mousedown', (e) => {
      if (e.target.closest('input, textarea')) return;
      e.preventDefault();
    });
    $('#insert').addEventListener('mousedown', (e) => e.preventDefault());
    $('#insert').addEventListener('click', () => { if (!$('#insert-menu').hidden) loadAssets(); });
    $('#mp-add')?.addEventListener('click', () => $('#mp-file').click());

    /* ---------- upload queue: name every file first ---------- */
    let queue = [];
    const qList = $('#mp-queue-list');
    const qBox = $('#mp-queue');
    const qBtn = $('#mp-upload');

    function paintQueue() {
      qBox.hidden = !queue.length;
      qList.innerHTML = '';
      queue.forEach((item, i) => {
        const row = el('div', 'mp-qrow');
        const thumb = el('img'); thumb.src = item.url; thumb.alt = '';
        const name = el('input'); name.type = 'text'; name.placeholder = 'Name this image';
        name.value = item.name;
        name.oninput = () => { queue[i].name = name.value; refreshBtn(); };
        const ext = el('span', 'mp-qext', (item.file.name.match(/\.[^.]+$/) || [''])[0].toLowerCase());
        const x = el('button', 'mp-qx', '\u2715'); x.type = 'button';
        x.onclick = () => { URL.revokeObjectURL(item.url); queue.splice(i, 1); paintQueue(); };
        row.append(thumb, name, ext, x);
        qList.append(row);
      });
      refreshBtn();
    }
    const refreshBtn = () => {
      qBtn.disabled = !queue.length || queue.some((q) => !slugFile(q.name).replace(/\.[^.]*$/, ''));
    };

    function enqueue(files) {
      for (const f of files) {
        if (!ALLOWED.test(f.name)) { flash(`${f.name} is not an allowed image type.`, true); continue; }
        queue.push({ file: f, name: '', url: URL.createObjectURL(f) });
      }
      paintQueue();
      qList.querySelector('input')?.focus();
    }

    // The queue only exists where uploading does, which is the dev server.
    if (qBtn) qBtn.onclick = async () => {
      const items = queue.slice();
      queue = []; paintQueue();
      for (const it of items) {
        await takeImage(it.file, it.name);
        URL.revokeObjectURL(it.url);
      }
      flash(`Uploaded ${items.length} image${items.length === 1 ? '' : 's'}.`);
    };

    if ($('#mp-file')) $('#mp-file').onchange = (e) => { enqueue(e.target.files); e.target.value = ''; };
    const pane = $('#pane-images');
    if (DEV) {
    pane.addEventListener('dragover', (e) => { e.preventDefault(); pane.classList.add('over'); });
    pane.addEventListener('dragleave', () => pane.classList.remove('over'));
    pane.addEventListener('drop', (e) => {
      e.preventDefault(); pane.classList.remove('over');
      enqueue([...(e.dataTransfer?.files || [])].filter((f) => f.type.startsWith('image/')));
    });

    // Dropping a file anywhere on the canvas files it and puts it in the article.
    const canvas = $('.ed-canvas');
    canvas.addEventListener('dragover', (e) => { e.preventDefault(); canvas.classList.add('drop'); });
    canvas.addEventListener('dragleave', () => canvas.classList.remove('drop'));
    canvas.addEventListener('drop', async (e) => {
      const files = [...(e.dataTransfer?.files || [])].filter((f) => f.type.startsWith('image/'));
      if (!files.length) return;
      e.preventDefault();
      canvas.classList.remove('drop');
      // Dropped files go to the naming queue like any other upload.
      enqueue(files);
      $('#insert').click();
    });
    canvas.addEventListener('paste', async (e) => {
      const files = [...(e.clipboardData?.files || [])].filter((f) => f.type.startsWith('image/'));
      if (!files.length) return;
      e.preventDefault();
      for (const f of files) {
        const path = await takeImage(f);
        if (path) useImage(path);
      }
    });
    }   // end of the upload paths, which only the dev server has

    /* ---------- zip, store-only, so images travel with the article ---------- */
    const CRC = (() => {
      const t = new Uint32Array(256);
      for (let n = 0; n < 256; n++) {
        let c = n;
        for (let k = 0; k < 8; k++) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1;
        t[n] = c >>> 0;
      }
      return (buf) => {
        let crc = 0xffffffff;
        for (let i = 0; i < buf.length; i++) crc = t[(crc ^ buf[i]) & 0xff] ^ (crc >>> 8);
        return (crc ^ 0xffffffff) >>> 0;
      };
    })();

    function zip(entries) {
      const enc = new TextEncoder();
      const parts = [], central = [];
      let offset = 0;
      for (const { name, data } of entries) {
        const nameBytes = enc.encode(name);
        const crc = CRC(data);
        const lh = new DataView(new ArrayBuffer(30));
        lh.setUint32(0, 0x04034b50, true);
        lh.setUint16(4, 20, true);
        lh.setUint32(14, crc, true);
        lh.setUint32(18, data.length, true);
        lh.setUint32(22, data.length, true);
        lh.setUint16(26, nameBytes.length, true);
        parts.push(new Uint8Array(lh.buffer), nameBytes, data);

        const cd = new DataView(new ArrayBuffer(46));
        cd.setUint32(0, 0x02014b50, true);
        cd.setUint16(4, 20, true);
        cd.setUint16(6, 20, true);
        cd.setUint32(16, crc, true);
        cd.setUint32(20, data.length, true);
        cd.setUint32(24, data.length, true);
        cd.setUint16(28, nameBytes.length, true);
        cd.setUint32(42, offset, true);
        central.push(new Uint8Array(cd.buffer), nameBytes);
        offset += 30 + nameBytes.length + data.length;
      }
      const cdSize = central.reduce((n, c) => n + c.length, 0);
      const end = new DataView(new ArrayBuffer(22));
      end.setUint32(0, 0x06054b50, true);
      end.setUint16(8, entries.length, true);
      end.setUint16(10, entries.length, true);
      end.setUint32(12, cdSize, true);
      end.setUint32(16, offset, true);
      return new Blob([...parts, ...central, new Uint8Array(end.buffer)], { type: 'application/zip' });
    }

    /* ---------- boot ---------- */
    // The one draft a tab kept before drafts were kept per page, brought over as its
    // page's draft so the reload onto this version does not lose it.
    try {
      const was = JSON.parse(sessionStorage.getItem(DRAFT) || 'null');
      sessionStorage.removeItem(DRAFT);
      if (was && !was.saved) {
        const kind = was.kind || 'article';
        drafts.put({ key: was.slug ? `${kind}:${was.slug}` : newKey(), kind, slug: was.slug || '',
          title: (was.meta?.['#f-title'] || '').trim(), at: Date.now(), snap: was, markdown: null, opened: '',
          file: was.slug || '', loadedTitle: '', loadedBody: '', images: [] }).catch(() => {});
      }
    } catch {}
    let said = '';
    try { said = sessionStorage.getItem(SAVED) || ''; sessionStorage.removeItem(SAVED); } catch {}
    const want = new URLSearchParams(location.search).get('a');
    if (want) {
      setInfobox([]);
      body.append(block('para'));
      load(want).then(() => { if (said) flash(said); });
    } else {
      setInfobox(TEMPLATES.overview);
      body.append(block('para'));
      // Where the writer left off: the page they last wrote in and have not sent, unless
      // they have started on the blank one meanwhile.
      drafts.all().then((all) => {
        const last = all.sort((a, b) => b.at - a.at)[0];
        if (last && toMarkdown() === opened) reopen(last);
      }).catch(() => {});
    }
    sync();
    if (!want) {
      draftKey = newKey();
      opened = toMarkdown();
      kept = { key: draftKey, markdown: opened };
    }
    titlesReady.then(() => { sync(); paintAssets(); });
    loadAssets();
    paintPending();

    /* ---------- text surfaces ----------
       Every place the writer types: the title, the sidebar heading and cells, the
       article's blocks, list items, table cells and captions. Find reads them as text,
       a token counted as one character it cannot match into. */
    const SURFACES = '#canvas-title, #ib-title, #ib-native, #ib-romaji, .ed-canvas .ce';
    const HL = typeof CSS !== 'undefined' && CSS.highlights && typeof Highlight === 'function';
    /** A box as one string, with where each piece of it came from. */
    function textOf(box) {
      const parts = [];
      let text = '';
      const walk = (n) => {
        for (const c of n.childNodes) {
          if (c.nodeType === 3) { parts.push({ node: c, at: text.length }); text += c.nodeValue; }
          else if (c.nodeType === 1) {
            if (c.dataset?.tok || c.getAttribute('contenteditable') === 'false') text += '\uFFFC';
            else if (c.tagName === 'BR') text += '\n';
            else if (!c.classList.contains('ce')) {
              // A line of its own (each line of a sidebar cell is a div) is not run into the
              // one before it, or "Makinami" and "Kanade" on two lines would read as one word.
              if (/^(DIV|P|LI)$/.test(c.tagName) && text && !text.endsWith('\n')) text += '\n';
              walk(c);                                         // a box inside a box is its own
            }
          }
        }
      };
      walk(box);
      return { text, parts };
    }
    /** A range over characters a to b of a box read by textOf. */
    function rangeOf({ parts }, a, b) {
      const spot = (i, end) => {
        for (const p of parts) {
          const len = p.node.nodeValue.length;
          if (i < p.at + len || (end && i === p.at + len)) return [p.node, Math.max(0, i - p.at)];
        }
        return null;
      };
      const s = spot(a, false), e = spot(b, true);
      if (!s || !e) return null;
      const r = document.createRange();
      r.setStart(...s);
      r.setEnd(...e);
      return r;
    }
    const surfaces = (scope = 'all') => [...document.querySelectorAll(SURFACES)].filter((b) => {
      if (b.closest('[hidden]')) return false;
      if (scope === 'article') return !!b.closest('#body');
      if (scope === 'sidebar') return !!b.closest('.ib-edit');
      return true;
    });
    /** Text put in place of a range, as typing would put it, keeping the formatting
        the range started in; the box it is in is told, so the page catches up. */
    function putText(r, text) {
      const host = r.startContainer.parentElement?.closest('[contenteditable="true"]');
      r.deleteContents();
      if (text) r.insertNode(document.createTextNode(text));
      r.startContainer.parentElement?.normalize?.();
      return host;
    }

    /* ---------- find and replace ----------
       ⌘F finds, ⌘⇧H replaces. Every match is lit and the current one more so; Enter
       and Shift+Enter step through them, and the count says where you are. Matching can
       keep to case, to whole words, or be a regular expression, and can look through
       the whole page, the article or the sidebar. Replacing can keep each match's
       capitals: "Nichirin", "NICHIRIN" and "nichirin" each come back in their own case. */
    const fb = $('#findbar');
    const fbOpts = { case: false, word: false, regex: false, keep: false };
    let fbScope = 'all', hits = [], at = -1, fbBusy = false;
    const findHL = HL ? new Highlight() : null, nowHL = HL ? new Highlight() : null;
    if (HL) { nowHL.priority = 1; CSS.highlights.set('find', findHL); CSS.highlights.set('find-now', nowHL); }

    /** The pattern as asked for, or a message saying why it is not one. */
    function pattern() {
      const q = $('#fb-find').value;
      if (!q) return null;
      let src = fbOpts.regex ? q : q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      if (fbOpts.word) src = `(?<![\\p{L}\\p{N}_])(?:${src})(?![\\p{L}\\p{N}_])`;
      try { return new RegExp(src, 'gu' + (fbOpts.case ? '' : 'i')); }
      catch { return 'bad'; }
    }
    function findAll(keep = false) {
      const was = hits[at]?.range;
      hits = [];
      const re = pattern();
      $('#fb-find').classList.toggle('bad', re === 'bad');
      $('#fb-find').parentElement.classList.toggle('bad', re === 'bad');
      if (re && re !== 'bad') {
        for (const box of surfaces(fbScope)) {
          const t = textOf(box);
          for (const m of t.text.matchAll(re)) {
            if (!m[0] || m[0].includes('\uFFFC')) continue;
            const range = rangeOf(t, m.index, m.index + m[0].length);
            if (range) hits.push({ box, range, text: m[0] });
          }
        }
      }
      // Where you were, if it is still a match; otherwise the first one after the caret.
      at = keep && was ? hits.findIndex((h) => !h.range.collapsed && h.range.compareBoundaryPoints(Range.START_TO_START, was) >= 0) : -1;
      if (at < 0 && hits.length) {
        const s = getSelection();
        const here = s.rangeCount ? s.getRangeAt(0) : null;
        at = here ? hits.findIndex((h) => h.range.compareBoundaryPoints(Range.START_TO_START, here) >= 0) : 0;
        if (at < 0) at = 0;
      }
      paintFind();
    }
    function paintFind(scroll = false) {
      if (HL) {
        findHL.clear(); nowHL.clear();
        hits.forEach((h, i) => (i === at ? nowHL : findHL).add(h.range));
      }
      const re = pattern();
      $('#fb-count').textContent = re === 'bad' ? 'Not a pattern' : !re ? '' : hits.length ? `${at + 1} of ${hits.length}` : 'No results';
      $('#fb-count').classList.toggle('none', !!re && !hits.length);
      for (const id of ['#fb-prev', '#fb-next', '#fb-one', '#fb-all']) $(id).disabled = !hits.length;
      if (scroll && hits[at]) {
        const r = hits[at].range.getBoundingClientRect();
        const top = $('.ed-tools').getBoundingClientRect().bottom + 70;
        if (r.top < top || r.bottom > innerHeight - 40) scrollBy({ top: r.top - (top + innerHeight) / 2 + 40, behavior: 'smooth' });
        // Without highlights to light it, the match is shown by selecting it.
        if (!HL) putRange(hits[at].range.cloneRange());
      }
    }
    function step(by) {
      if (!hits.length) return;
      at = (at + by + hits.length) % hits.length;
      paintFind(true);
    }
    /** What a match is replaced with: the text as typed, a regular expression's groups
        filled in, and the match's own capitals kept if that is asked for. */
    function replacement(h) {
      let r = $('#fb-repl').value;
      if (fbOpts.regex) {
        const re = pattern();
        r = h.text.replace(new RegExp(re.source, re.flags.replace('g', '')), r);
      }
      if (fbOpts.keep && /\p{L}/u.test(h.text)) {
        if (h.text === h.text.toUpperCase() && h.text !== h.text.toLowerCase()) r = r.toUpperCase();
        else if (h.text === h.text.toLowerCase()) r = r.toLowerCase();
        else if (h.text[0] === h.text[0].toUpperCase()) r = r[0]?.toUpperCase() + r.slice(1);
      }
      return r;
    }
    /** Replace these matches as one step, so one undo takes them all back. */
    function replaceHits(list) {
      if (!list.length) return 0;
      fbBusy = true;
      const touched = new Set();
      // Every range is live, so each replacement leaves the ones after it where they were.
      for (const h of list) touched.add(putText(h.range, replacement(h)));
      quiet = true;
      try { touched.forEach((host) => host?.dispatchEvent(new Event('input', { bubbles: true }))); }
      finally { quiet = false; }
      sync();
      fbBusy = false;
      return list.length;
    }
    function openFind(replace) {
      fb.hidden = false;
      $('#fb-replace-row').hidden = !replace && $('#fb-replace-row').hidden;
      if (replace) $('#fb-replace-row').hidden = false;
      $('#fb-expand').classList.toggle('on', !$('#fb-replace-row').hidden);
      // A word already selected in the article is what you most likely want to find.
      const sel = getSelection().toString().trim();
      if (sel && !sel.includes('\n') && sel.length < 80) $('#fb-find').value = sel;
      const box = replace && $('#fb-find').value ? $('#fb-repl') : $('#fb-find');
      box.focus();
      box.select();
      findAll();
      paintFind(true);
    }
    function closeFind() {
      fb.hidden = true;
      const h = hits[at];
      hits = []; at = -1;
      if (HL) { findHL.clear(); nowHL.clear(); }
      // Back in the article at the match you were on.
      if (h && !h.range.collapsed) {
        const host = h.range.startContainer.parentElement?.closest('[contenteditable="true"]');
        host?.focus({ preventScroll: true });
        putRange(h.range.cloneRange());
      }
    }
    $('#find-btn').onclick = () => (fb.hidden ? openFind(false) : closeFind());
    $('#fb-close').onclick = closeFind;
    $('#fb-expand').onclick = () => {
      const row = $('#fb-replace-row');
      row.hidden = !row.hidden;
      $('#fb-expand').classList.toggle('on', !row.hidden);
      if (!row.hidden) $('#fb-repl').focus();
    };
    $('#fb-prev').onclick = () => step(-1);
    $('#fb-next').onclick = () => step(1);
    $('#fb-one').onclick = () => {
      const h = hits[at];
      if (!h) return;
      replaceHits([h]);
      findAll(true);
      paintFind(true);
    };
    $('#fb-all').onclick = () => {
      const n = replaceHits(hits.slice());
      findAll();
      flash(`Replaced ${n} ${n === 1 ? 'match' : 'matches'}.`);
    };
    fb.querySelectorAll('[data-opt]').forEach((b) => b.onclick = () => {
      fbOpts[b.dataset.opt] = !fbOpts[b.dataset.opt];
      b.classList.toggle('on', fbOpts[b.dataset.opt]);
      b.setAttribute('aria-pressed', fbOpts[b.dataset.opt]);
      findAll(true);
    });
    fb.querySelectorAll('[data-scope]').forEach((b) => b.onclick = () => {
      fbScope = b.dataset.scope;
      fb.querySelectorAll('[data-scope]').forEach((x) => x.classList.toggle('on', x === b));
      findAll();
      paintFind(true);
    });
    let fbTimer = 0;
    $('#fb-find').addEventListener('input', () => { clearTimeout(fbTimer); fbTimer = setTimeout(() => { findAll(); paintFind(true); }, 120); });
    $('#fb-find').addEventListener('keydown', (e) => {
      if (e.key === 'Enter') { e.preventDefault(); step(e.shiftKey ? -1 : 1); }
    });
    $('#fb-repl').addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      e.preventDefault();
      (e.metaKey || e.ctrlKey ? $('#fb-all') : $('#fb-one')).click();
    });
    fb.addEventListener('keydown', (e) => { if (e.key === 'Escape') { e.preventDefault(); closeFind(); } });
    // The page changing under an open bar, by typing or undo, moves the matches with it.
    // Its own timer: sharing the one the Find box uses let a change to the page cancel a
    // search just typed, and show the last one's count meanwhile.
    let fbPageTimer = 0;
    new MutationObserver(() => {
      if (fb.hidden || fbBusy) return;
      clearTimeout(fbPageTimer);
      fbPageTimer = setTimeout(() => findAll(true), 250);
    }).observe($('.ed-canvas'), { subtree: true, childList: true, characterData: true });
    addEventListener('keydown', (e) => {
      if (!(e.metaKey || e.ctrlKey) || e.altKey) return;
      const k = e.key.toLowerCase();
      if (k === 'f' && !e.shiftKey) { e.preventDefault(); openFind(false); }
      else if (k === 'h' && e.shiftKey) { e.preventDefault(); openFind(true); }
      else if (k === 'g' && !fb.hidden) { e.preventDefault(); step(e.shiftKey ? -1 : 1); }
    });

  </script>

  <script>
    // The page above is inline and cannot import; the fix is shared with the auto-merge.
    import { fixEmphasis } from '../lib/emphasis.mjs';
    window.fixEmphasis = fixEmphasis;
  </script>

