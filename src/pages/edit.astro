              e.preventDefault();
              if (li.nextElementSibling) { join(li, li.nextElementSibling); return; }
              // The last item pulls the paragraph after the list up into itself.
              const near = neighbour(b, false);
              if (!near || !TEXT_KINDS.has(near.dataset.kind)) return;
              const other = near.querySelector('.ce');
              if (hasContent(other)) joinInto(box, other);
              near.remove();
              sync();
            }
          });
          // Typing or deleting over a selection that runs across items, however it came.
          ul.addEventListener('beforeinput', (e) => {
            if (!/^(insertText|insertReplacementText|delete)/.test(e.inputType)) return;
            if (!cutAcross()) return;
            e.preventDefault();
            if (e.data && e.inputType.startsWith('insert')) document.execCommand('insertText', false, e.data);
            sync();
          });
          ul.addEventListener('input', () => { shape(); sync(); });
          // A paste of several lines or of a list makes items, at their own levels
          // under the item it went into.
          ul.addEventListener('paste', (e) => {
            const dt = e.clipboardData;
            e.preventDefault();
            if (!cutAcross() && !getSelection().isCollapsed) document.execCommand('delete');
            const entries = pastedItems(dt);
            if (!entries) {
              const html = dt.getData('text/html'), text = dt.getData('text/plain');
              const clean = plainPaste || !html ? '' : keepTokens(html);
              plainPaste = false;
              if (clean.replace(/<[^>]*>/g, '').trim()) { insertHtml(clean); unglue(boxOf(here())); }
              else document.execCommand('insertText', false, text);
              return;
            }
            plainPaste = false;
            const li = here() || ul.lastElementChild, base = levelOf(li);
            spreadLines(boxOf(li), entries.map((x) => x.html), (html, prev, i) => {
              const n = item(html, base + entries[i].level);
              liOf(prev).after(n);
              return boxOf(n);
            });
            tidy();
          });

          const seed = data.htmlItems?.length ? data.htmlItems
            : (data.items?.length ? data.items : ['']).map((t, n) => ({ html: mdToHtml(t), level: data.levels?.[n] || 0 }));
          seed.forEach((x) => ul.append(item(x.html, x.level)));
          tidy();
          // What the commands outside the list work it with.
          b.list = { ul, items, tidy, ordered, numbering, here, touched, outOf, boxOf,
            setOrdered: (o) => { ul.classList.toggle('ordered', o); tidy(); },
            setNumbering: (n) => { if (n === 'outline') ul.dataset.numbering = 'outline'; else delete ul.dataset.numbering; tidy(); } };
          b.append(ul);
        } else {
          const ph = kind === 'section' ? 'Section heading'
            : kind === 'subsection' ? 'Subsection heading'
            : kind === 'subsubsection' ? 'Sub-subsection heading' : 'Write here';
          // Enter never splits a block: it starts a new paragraph under it.
          const box = editable(mdToHtml(data.text || ''), ph, () => {
            const n = block('para');
            b.after(n);
            n.querySelector('.ce').focus();
            sync();
          });
          box.addEventListener('keydown', (e) => {
            if (b.parentElement !== body) return;
            joinKeys(e, b, box);
            autoList(e, b, box);
          });
          // Ahead of the box's own paste, which keeps to one line.
          b.addEventListener('paste', (e) => { if (b.parentElement === body) blockPaste(e, b, box); }, true);
          b.append(box);
          // A navbox row under History is a period of the nation's history series, and
          // carries its dates there. Shown only on those rows; see paintDates.
          if (kind === 'subsection') {
            const dates = el('input', 'blk-dates');
            dates.type = 'text';
            dates.placeholder = 'Dates';
            dates.spellcheck = false;
            dates.value = data.dates || '';
            dates.setAttribute('aria-label', 'Dates of this period');
            dates.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); box.focus(); } });
            dates.addEventListener('input', sync);
            b.append(dates);
