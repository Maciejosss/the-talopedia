      s.modify('move', back ? 'backward' : 'forward', 'line');
      const y1 = caretY();
      const changed = y0 != null && y1 != null ? Math.abs(y1 - y0) > 2 : caretOffset(box) !== from;
      if (box.contains(s.focusNode) && changed) return true;
      putRange(was);
      return false;
    }
    /**
     * The caret into a box: at its end or its start, or given a point across, as near to
     * it as it gets on the box's last line or first. A box in a table means the table's
     * bottom or top row, in the cell under that point.
     */
    function landIn(box, end, x = null) {
      let target = box;
      const table = box.closest('.ed-tbl');
      if (table && x != null) {
        const rows = table.tBodies[0].rows;
        const cells = [...(end ? rows[rows.length - 1] : rows[0]).children];
        const td = cells.find((c) => { const b = c.getBoundingClientRect(); return x >= b.left && x < b.right; }) || cells[0];
        if (td) target = td.querySelector('.ce');
      }
      (table || target.closest('.ed-list') || target).focus({ preventScroll: true });
      target.scrollIntoView({ block: 'nearest', inline: 'nearest' });
      if (x != null) {
        const b = target.getBoundingClientRect();
        const hit = document.caretRangeFromPoint?.(
          Math.min(Math.max(x, b.left + 1), b.right - 1), end ? b.bottom - 3 : b.top + 3);
        if (hit && target.contains(hit.startContainer)) { putRange(hit); return; }
