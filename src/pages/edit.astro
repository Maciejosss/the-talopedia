          .then((r) => (r.ok ? r.json() : null)).then((pr) => {
            if (!pr) return;
            const [t, cls] = pr.merged_at ? ['Live', 'live'] : pr.state === 'open' ? ['Review', 'review'] : ['Closed', 'closed'];
            tag.textContent = t; tag.classList.add(cls);
